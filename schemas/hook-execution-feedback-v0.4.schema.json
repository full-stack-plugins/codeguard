{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codeguard:schema:hook-execution-feedback:0.4.0",
  "title": "Candidate host-event execution; never a delivery gate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "report_type", "plan", "execution", "reason", "local_feedback", "delivery_decision", "host_blocking_verified", "soft_result_reused"],
  "properties": {
    "schema_version": {"const": "0.4.0"},
    "report_type": {"const": "hook_execution_feedback"},
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "target_paths", "scope_resolution_reason", "task_id", "requires_git_snapshot", "soft_result_reuse_candidate", "host_blocking_claimed", "may_claim_delivery"],
      "properties": {
        "action": {"enum": ["no_check", "discover_project", "show_intent_guidance", "fast_file_check", "resolve_changed_scope", "verify_task", "commit_gate", "push_gate", "full_project_check", "show_summary"]},
        "target_paths": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 512}},
        "scope_resolution_reason": {"enum": [null, "changed_paths_missing", "write_outcome_unknown", "fast_scope_budget_exceeded"]},
        "task_id": {"type": ["string", "null"]},
        "requires_git_snapshot": {"type": "boolean"},
        "soft_result_reuse_candidate": {"type": "boolean"},
        "host_blocking_claimed": {"type": "boolean"},
        "may_claim_delivery": {"const": false}
      }
    },
    "execution": {"enum": ["not_run", "read_only_discovery", "read_only_guidance", "local_observation", "task_verification"]},
    "reason": {"enum": [null, "workspace_unavailable", "registry_unavailable", "adapter_unavailable", "request_cancelled", "request_deadline_exceeded", "fast_scope_not_wired", "write_failed", "scope_resolution_required", "delivery_gate_not_wired", "git_index_observation_failed", "guidance_scope_exceeded", "guidance_unavailable", "task_unavailable", "verification_scope_exceeded", "verification_arguments_invalid", "verification_output_exceeded", "verification_process_failed", "verification_report_invalid", "action_not_wired"]},
    "local_feedback": {"type": ["object", "null"]},
    "delivery_decision": {"const": "not_evaluated"},
    "host_blocking_verified": {"const": false},
    "soft_result_reused": {"const": false}
  },
  "allOf": [
    {"if": {"properties": {"execution": {"const": "not_run"}}, "required": ["execution"]}, "then": {"properties": {"local_feedback": {"type": "null"}, "reason": {"type": "string"}}}},
    {"if": {"properties": {"execution": {"const": "read_only_discovery"}}, "required": ["execution"]}, "then": {"properties": {"plan": {"properties": {"action": {"const": "discover_project"}}}, "reason": {"type": "null"}, "local_feedback": {"$ref": "#/$defs/discovery_summary"}}}},
    {"if": {"properties": {"execution": {"const": "read_only_guidance"}}, "required": ["execution"]}, "then": {"properties": {"plan": {"properties": {"action": {"const": "show_summary"}}}, "reason": {"type": "null"}, "local_feedback": {"$ref": "#/$defs/next_guidance"}}}},
    {"if": {"properties": {"execution": {"const": "task_verification"}}, "required": ["execution"]}, "then": {"properties": {"plan": {"properties": {"action": {"const": "verify_task"}}}, "reason": {"type": "null"}, "local_feedback": {"$ref": "#/$defs/task_verification_summary"}}}},
    {"if": {"properties": {"execution": {"const": "local_observation"}}, "required": ["execution"]}, "then": {"oneOf": [
      {"properties": {"plan": {"properties": {"action": {"const": "fast_file_check"}}}, "reason": {"enum": [null, "request_cancelled"]}, "local_feedback": {"type": "object", "required": ["schema_version", "report_type", "scan_scope", "delivery_decision"], "properties": {"schema_version": {"const": "0.13.0"}, "report_type": {"const": "python_lint_feedback"}, "scan_scope": {"const": "selected_files"}, "delivery_decision": {"const": "not_evaluated"}}}}},
      {"properties": {"plan": {"properties": {"action": {"const": "commit_gate"}}}, "reason": {"type": "null"}, "local_feedback": {"$ref": "#/$defs/git_index_summary"}}}
    ]}}
  ],
  "$defs": {
    "task_verification_summary": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "report_type", "task_id", "checker_id", "observation", "event_persisted", "reason", "scan_report_available", "authority", "delivery_decision"],
      "properties": {
        "schema_version": {"const": "0.1.0"}, "report_type": {"const": "hook_task_verification_summary"},
        "task_id": {"type": "string", "pattern": "^CG-(B-)?[0-9a-f]{32}$"},
        "checker_id": {"type": "string", "minLength": 1, "maxLength": 96},
        "observation": {"type": "string", "minLength": 1, "maxLength": 64},
        "event_persisted": {"type": "boolean"},
        "reason": {"type": ["string", "null"], "maxLength": 128},
        "scan_report_available": {"type": "boolean"},
        "authority": {"const": "local_unverified"}, "delivery_decision": {"const": "not_evaluated"}
      }
    },
    "next_guidance": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "report_type", "disposition", "reason", "task_id", "checker_id", "step", "next_actions", "source_check", "authority", "delivery_decision"],
      "properties": {
        "schema_version": {"const": "0.1.0"}, "report_type": {"const": "hook_next_guidance"},
        "disposition": {"type": "string", "maxLength": 64}, "reason": {"type": "string", "maxLength": 128},
        "task_id": {"type": ["string", "null"], "maxLength": 96},
        "checker_id": {"type": ["string", "null"], "maxLength": 96},
        "step": {"type": ["string", "null"], "maxLength": 512},
        "next_actions": {"type": "array", "maxItems": 1, "items": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"type": "string", "maxLength": 64}}},
        "source_check": {"const": "not_run"}, "authority": {"const": "local_unverified"},
        "delivery_decision": {"const": "not_evaluated"}
      }
    },
    "discovery_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "report_type", "languages", "checker_configurations", "checker_count", "checker_list_truncated", "observation_complete", "unknown_condition_count", "source_check", "delivery_decision"],
      "properties": {
        "schema_version": {"const": "0.1.0"},
        "report_type": {"const": "hook_discovery_summary"},
        "languages": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "checker_configurations": {"type": "array", "maxItems": 32, "items": {"type": "object", "additionalProperties": false, "required": ["checker_id", "build_root", "configuration"], "properties": {"checker_id": {"type": "string"}, "build_root": {"type": "string"}, "configuration": {"type": "string"}}}},
        "checker_count": {"type": "integer", "minimum": 0},
        "checker_list_truncated": {"type": "boolean"},
        "observation_complete": {"type": "boolean"},
        "unknown_condition_count": {"type": "integer", "minimum": 0},
        "source_check": {"const": "not_run"},
        "delivery_decision": {"const": "not_evaluated"}
      }
    },
    "git_index_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "report_type", "index_observation", "index_listing_sha256", "staged_entry_count", "object_status", "violation_count", "violations_truncated", "violations", "source_check", "delivery_decision"],
      "properties": {
        "schema_version": {"const": "0.1.0"},
        "report_type": {"const": "hook_git_index_summary"},
        "index_observation": {"const": "complete"},
        "index_listing_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "staged_entry_count": {"type": "integer", "minimum": 0},
        "object_status": {"enum": ["verified", "unresolved"]},
        "violation_count": {"type": "integer", "minimum": 0},
        "violations_truncated": {"type": "boolean"},
        "violations": {"type": "array", "maxItems": 32, "items": {"type": "object", "additionalProperties": false, "required": ["path", "rule_id"], "properties": {"path": {"type": "string", "maxLength": 512}, "rule_id": {"type": "string"}}}},
        "source_check": {"const": "not_run"},
        "delivery_decision": {"const": "not_evaluated"}
      }
    }
  }
}
