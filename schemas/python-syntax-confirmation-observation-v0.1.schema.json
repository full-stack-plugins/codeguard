{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codeguard:schema:python-syntax-confirmation-observation:0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_type",
    "workspace_binding",
    "workspace_id",
    "run_id",
    "checker_id",
    "authority",
    "coverage_proven",
    "delivery_decision",
    "execution",
    "reason_code",
    "blocker_id",
    "fingerprint",
    "build_root",
    "scope",
    "affected_paths",
    "source_sha256",
    "grammar_sha256",
    "observations"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "report_type": {
      "const": "python_syntax_confirmation_observation"
    },
    "workspace_binding": {
      "const": "bound"
    },
    "workspace_id": {
      "type": "string",
      "pattern": "^ws-[0-9a-f]{32}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^python-syntax-[0-9]+-[0-9]+$"
    },
    "checker_id": {
      "const": "python.ruff"
    },
    "authority": {
      "const": "local_unverified"
    },
    "coverage_proven": {
      "const": false
    },
    "delivery_decision": {
      "const": "not_evaluated"
    },
    "execution": {
      "const": "incomplete"
    },
    "reason_code": {
      "const": "python_syntax_confirmation_needed"
    },
    "blocker_id": {
      "type": "string",
      "pattern": "^CG-B-[0-9a-f]{32}$"
    },
    "fingerprint": {
      "$ref": "#/$defs/sha256"
    },
    "build_root": {
      "const": "."
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[^\\\\\\u0000-\\u001f]+\\.pyw?$"
    },
    "affected_paths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "grammar_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "observations": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "source_sha256",
          "classification",
          "kind",
          "syntax_kind",
          "start_line",
          "start_column",
          "end_line",
          "end_column",
          "group_id"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "source_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "classification": {
            "const": "suspected"
          },
          "kind": {
            "enum": [
              "ERROR",
              "MISSING"
            ]
          },
          "syntax_kind": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "start_line": {
            "type": "integer",
            "minimum": 1
          },
          "start_column": {
            "type": "integer",
            "minimum": 1
          },
          "end_line": {
            "type": "integer",
            "minimum": 1
          },
          "end_column": {
            "type": "integer",
            "minimum": 1
          },
          "group_id": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
