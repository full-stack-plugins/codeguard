{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codeguard:schema:kotlin-lint-feedback:0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_type",
    "operation",
    "language",
    "command_status",
    "exit_code",
    "source_path",
    "scope",
    "source_sha256",
    "input_stable",
    "native",
    "syntax_precheck",
    "setup",
    "coverage_proven",
    "authority",
    "delivery_decision",
    "next_actions",
    "tool_selection"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "report_type": {
      "const": "kotlin_lint_feedback"
    },
    "operation": {
      "const": "lint"
    },
    "language": {
      "const": "kotlin"
    },
    "command_status": {
      "enum": [
        "incomplete",
        "cancelled"
      ]
    },
    "exit_code": {
      "enum": [
        3,
        130
      ]
    },
    "source_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "scope": {
      "const": "single_frozen_kt_file"
    },
    "source_sha256": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      ]
    },
    "input_stable": {
      "type": "boolean"
    },
    "native": {
      "$ref": "#/$defs/native"
    },
    "syntax_precheck": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "zig-lint-feedback-v0.1.schema.json#/$defs/candidate"
        }
      ]
    },
    "setup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "native_confirmation_required",
        "automatic_installation",
        "full_project_checks_required"
      ],
      "properties": {
        "native_confirmation_required": {
          "type": "boolean"
        },
        "automatic_installation": {
          "const": false
        },
        "full_project_checks_required": {
          "const": true
        }
      }
    },
    "coverage_proven": {
      "const": false
    },
    "authority": {
      "const": "local_unverified"
    },
    "delivery_decision": {
      "const": "not_evaluated"
    },
    "next_actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "tool_selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "executable"
      ],
      "properties": {
        "source": {
          "enum": [
            "explicit",
            "path",
            "not_found"
          ]
        },
        "executable": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  },
  "$defs": {
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "line",
        "column_byte",
        "column_utf16"
      ],
      "properties": {
        "rule_id": {
          "type": "string",
          "pattern": "^kotlin\\.(syntax|context\\.[A-Z0-9_]+)$"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column_byte": {
          "type": "integer",
          "minimum": 1
        },
        "column_utf16": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "native": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason",
        "version",
        "tool_sha256",
        "tool_identity_scope",
        "diagnostics",
        "context_diagnostics"
      ],
      "properties": {
        "status": {
          "enum": [
            "incomplete",
            "completed",
            "diagnostics_observed"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "enum": [
            null,
            "kotlinc-jvm 2.4.10"
          ]
        },
        "tool_sha256": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          ]
        },
        "tool_identity_scope": {
          "const": "launcher_only"
        },
        "diagnostics": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/diagnostic"
              },
              {
                "properties": {
                  "rule_id": {
                    "const": "kotlin.syntax"
                  }
                }
              }
            ]
          }
        },
        "context_diagnostics": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/diagnostic"
              },
              {
                "properties": {
                  "rule_id": {
                    "pattern": "^kotlin\\.context\\.[A-Z0-9_]+$"
                  }
                }
              }
            ]
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "completed"
              }
            }
          },
          "then": {
            "properties": {
              "version": {
                "const": "kotlinc-jvm 2.4.10"
              },
              "tool_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "diagnostics": {
                "minItems": 0,
                "maxItems": 0
              },
              "context_diagnostics": {
                "maxItems": 0
              },
              "reason": {
                "const": "kotlin_native_single_file_no_diagnostics"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "diagnostics_observed"
              }
            }
          },
          "then": {
            "properties": {
              "version": {
                "const": "kotlinc-jvm 2.4.10"
              },
              "tool_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "diagnostics": {
                "minItems": 1,
                "maxItems": 32
              },
              "context_diagnostics": {
                "maxItems": 0
              },
              "reason": {
                "const": "kotlin_native_syntax_diagnostics"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "context_diagnostics": {
                "minItems": 1
              }
            }
          },
          "then": {
            "properties": {
              "status": {
                "const": "incomplete"
              },
              "reason": {
                "const": "kotlin_project_context_unresolved"
              },
              "version": {
                "const": "kotlinc-jvm 2.4.10"
              },
              "tool_sha256": {
                "$ref": "#/$defs/digest"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "reason": {
                "const": "kotlin_project_context_unresolved"
              }
            }
          },
          "then": {
            "properties": {
              "context_diagnostics": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "exit_code": {
            "const": 3
          }
        }
      },
      "then": {
        "properties": {
          "command_status": {
            "const": "incomplete"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "exit_code": {
            "const": 130
          }
        }
      },
      "then": {
        "properties": {
          "command_status": {
            "const": "cancelled"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "native": {
            "properties": {
              "status": {
                "enum": [
                  "completed",
                  "diagnostics_observed"
                ]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "input_stable": {
            "const": true
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "syntax_precheck": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "syntax_precheck": {
            "type": "object",
            "required": [
              "precheck"
            ],
            "properties": {
              "precheck": {
                "properties": {
                  "truncated_files": {
                    "const": 1
                  }
                },
                "required": [
                  "truncated_files"
                ]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "setup": {
            "properties": {
              "native_confirmation_required": {
                "const": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "syntax_precheck": {
            "type": "object",
            "required": [
              "recoveries"
            ],
            "properties": {
              "recoveries": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "setup": {
            "properties": {
              "native_confirmation_required": {
                "const": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "syntax_precheck": {
            "type": "object",
            "required": [
              "reason"
            ],
            "properties": {
              "reason": {
                "type": "string"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "setup": {
            "properties": {
              "native_confirmation_required": {
                "const": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "native": {
            "properties": {
              "status": {
                "const": "incomplete"
              },
              "reason": {
                "not": {
                  "const": "kotlin_tool_not_found"
                }
              }
            },
            "required": [
              "status",
              "reason"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "setup": {
            "properties": {
              "native_confirmation_required": {
                "const": true
              }
            }
          }
        }
      }
    }
  ]
}
