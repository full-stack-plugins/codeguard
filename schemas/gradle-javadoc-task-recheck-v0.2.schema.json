{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codeguard:schema:gradle-javadoc-task-recheck:0.2.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_type",
    "operation",
    "workspace_binding",
    "checker_id",
    "authority",
    "coverage_proven",
    "delivery_decision",
    "run_id",
    "workspace_id",
    "task_id",
    "task_path",
    "task_rule",
    "origin",
    "scan",
    "input_bindings",
    "task_input_stable",
    "configuration_matches",
    "tool_identity_matches",
    "reason",
    "source_scope_matches",
    "original_tool_identity_complete"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2.0"
    },
    "report_type": {
      "const": "gradle_javadoc_task_recheck"
    },
    "operation": {
      "const": "task_verify"
    },
    "workspace_binding": {
      "const": "bound"
    },
    "checker_id": {
      "const": "java.gradle.javadoc"
    },
    "authority": {
      "const": "local_unverified"
    },
    "coverage_proven": {
      "const": false
    },
    "delivery_decision": {
      "const": "not_evaluated"
    },
    "run_id": {
      "type": "string",
      "pattern": "^javadoc-gradle-task-[A-Za-z0-9-]{1,100}$"
    },
    "workspace_id": {
      "type": "string",
      "pattern": "^ws-[0-9a-f]{32}$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^CG-(B-)?[0-9a-f]{32}$"
    },
    "task_path": {
      "type": "string",
      "minLength": 1
    },
    "task_rule": {
      "type": [
        "string",
        "null"
      ]
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "first_run_id",
        "first_report_sha256"
      ],
      "properties": {
        "first_run_id": {
          "type": "string",
          "pattern": "^javadoc-[A-Za-z0-9-]{1,100}$"
        },
        "first_report_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "scan": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "gradle-javadoc-workbench-observation-v0.2.schema.json"
        }
      ]
    },
    "input_bindings": {
      "type": "array",
      "maxItems": 131,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "location"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "location": {
            "enum": [
              "workspace",
              "tool",
              "bundle"
            ]
          }
        }
      }
    },
    "task_input_stable": {
      "type": "boolean"
    },
    "configuration_matches": {
      "type": "boolean"
    },
    "tool_identity_matches": {
      "type": "boolean"
    },
    "reason": {
      "type": "string",
      "pattern": "^[a-z0-9_]{1,80}$"
    },
    "source_scope_matches": {
      "type": "boolean"
    },
    "original_tool_identity_complete": {
      "type": "boolean"
    }
  }
}
