{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codeguard:schema:codeguard-workspace:0.3.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "document_type", "workspace_id", "project_root", "managed_files", "project_sha256", "module_graph_sha256", "planned_agents_block_sha256", "managed_sha256", "workflow_status", "quality_gate"],
  "properties": {
    "schema_version": {"const": "0.3.0"},
    "document_type": {"const": "codeguard_workspace"},
    "workspace_id": {"type": "string", "pattern": "^ws-[0-9a-f]{32}$"},
    "project_root": {"const": "."},
    "managed_files": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "project_sha256": {"$ref": "#/$defs/sha256"},
    "module_graph_sha256": {"$ref": "#/$defs/sha256"},
    "planned_agents_block_sha256": {"$ref": "#/$defs/sha256"},
    "managed_sha256": {"type": "object", "required": [".gitignore", "README.md", "project.json", "module-graph.json", "architecture.md"], "properties": {".gitignore": {"$ref": "#/$defs/sha256"}, "README.md": {"$ref": "#/$defs/sha256"}, "project.json": {"$ref": "#/$defs/sha256"}, "module-graph.json": {"$ref": "#/$defs/sha256"}, "architecture.md": {"$ref": "#/$defs/sha256"}}, "additionalProperties": false},
    "workflow_status": {"const": "initialization_partial"},
    "quality_gate": {"const": "not_evaluated"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
