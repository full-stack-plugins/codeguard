{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codeguard:schema:syntax-confirmation-observation:0.3.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_type",
    "workspace_binding",
    "authority",
    "coverage_proven",
    "delivery_decision",
    "execution",
    "build_root",
    "workspace_id",
    "run_id",
    "checker_id",
    "reason_code",
    "blocker_id",
    "fingerprint",
    "scope",
    "language",
    "affected_paths",
    "observations"
  ],
  "properties": {
    "schema_version": {
      "const": "0.3.0"
    },
    "report_type": {
      "const": "syntax_confirmation_observation"
    },
    "workspace_binding": {
      "const": "bound"
    },
    "authority": {
      "const": "local_unverified"
    },
    "coverage_proven": {
      "const": false
    },
    "delivery_decision": {
      "const": "not_evaluated"
    },
    "execution": {
      "const": "incomplete"
    },
    "build_root": {
      "const": "."
    },
    "workspace_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "pattern": "^syntax-confirm-[0-9]+-[0-9]+$"
    },
    "checker_id": {
      "enum": [
        "python.ruff",
        "node.eslint.preparation",
        "syntax.native_confirmation"
      ]
    },
    "reason_code": {
      "enum": [
        "python_syntax_confirmation_needed",
        "eslint_prerequisites_require_review",
        "native_syntax_confirmation_needed"
      ]
    },
    "blocker_id": {
      "type": "string",
      "pattern": "^CG-B-[0-9a-f]{32}$"
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "string",
      "minLength": 1
    },
    "affected_paths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "language",
          "scope",
          "byte_offset",
          "status",
          "reason",
          "grammar_qualified",
          "source_sha256",
          "grammar_sha256",
          "recovery_count",
          "recoveries",
          "known_limitations"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "language": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "enum": [
              "whole_file",
              "cfquery_body"
            ]
          },
          "byte_offset": {
            "type": "integer",
            "minimum": 0
          },
          "status": {
            "const": "candidate_observed"
          },
          "reason": {
            "enum": [
              null,
              "syntax_recovery_incomplete"
            ]
          },
          "grammar_qualified": {
            "const": false
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "grammar_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "recovery_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4096
          },
          "known_limitations": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            }
          },
          "recoveries": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "syntax_kind",
                "start_byte",
                "end_byte",
                "start_row",
                "start_column_byte",
                "end_row",
                "end_column_byte"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "ERROR",
                    "MISSING"
                  ]
                },
                "syntax_kind": {
                  "type": "string",
                  "minLength": 1
                },
                "start_byte": {
                  "type": "integer",
                  "minimum": 0
                },
                "end_byte": {
                  "type": "integer",
                  "minimum": 0
                },
                "start_row": {
                  "type": "integer",
                  "minimum": 0
                },
                "start_column_byte": {
                  "type": "integer",
                  "minimum": 0
                },
                "end_row": {
                  "type": "integer",
                  "minimum": 0
                },
                "end_column_byte": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "minItems": 0
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "recovery_count": {
                  "const": 0
                }
              },
              "required": [
                "recovery_count"
              ]
            },
            "then": {
              "properties": {
                "reason": {
                  "const": "syntax_recovery_incomplete"
                },
                "recoveries": {
                  "maxItems": 0
                }
              }
            },
            "else": {
              "properties": {
                "recoveries": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      }
    }
  }
}
