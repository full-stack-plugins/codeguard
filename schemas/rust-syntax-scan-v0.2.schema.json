{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codeguard:schema:rust-syntax-scan:0.2.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_type",
    "scope",
    "tool_selection",
    "source_file_count",
    "unobserved_count",
    "local_parse_complete",
    "files",
    "task_status",
    "authority",
    "coverage_proven",
    "delivery_decision",
    "native_lint_obligation"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2.0"
    },
    "report_type": {
      "const": "rust_syntax_scan"
    },
    "scope": {
      "const": "single_frozen_rust_files"
    },
    "tool_selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "executable"
      ],
      "properties": {
        "source": {
          "enum": [
            "explicit",
            "path",
            "not_found"
          ]
        },
        "executable": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "source_file_count": {
      "type": "integer",
      "minimum": 0
    },
    "unobserved_count": {
      "type": "integer",
      "minimum": 0
    },
    "local_parse_complete": {
      "type": "boolean"
    },
    "files": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "source_sha256",
          "current",
          "tool_path",
          "native",
          "task_id",
          "task_sync_reason",
          "recheck_argv"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\\\r\\n]+\\.rs$"
          },
          "source_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          },
          "current": {
            "type": "boolean"
          },
          "tool_path": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^/"
          },
          "native": {
            "$ref": "urn:codeguard:schema:rust-native-syntax-evidence:0.3.0"
          },
          "task_id": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^CG-B-[0-9a-f]{32}$"
          },
          "task_sync_reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "recheck_argv": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "current": {
                  "const": true
                }
              }
            },
            "then": {
              "properties": {
                "source_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "current": {
                  "const": false
                }
              }
            },
            "then": {
              "properties": {
                "native": {
                  "properties": {
                    "diagnostics": {
                      "maxItems": 0
                    }
                  }
                },
                "recheck_argv": {
                  "type": "null"
                }
              }
            }
          }
        ]
      }
    },
    "task_status": {
      "enum": [
        "synced_partial",
        "incomplete"
      ]
    },
    "authority": {
      "const": "local_unverified"
    },
    "coverage_proven": {
      "const": false
    },
    "delivery_decision": {
      "const": "not_evaluated"
    },
    "native_lint_obligation": {
      "const": "cargo_clippy_pending"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "local_parse_complete": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "unobserved_count": {
            "const": 0
          },
          "files": {
            "items": {
              "properties": {
                "current": {
                  "const": true
                },
                "native": {
                  "properties": {
                    "status": {
                      "enum": [
                        "completed",
                        "diagnostics_observed"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
