{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "CodeGuard transport diagnostic v1alpha1",
  "required": [
    "apiVersion",
    "kind",
    "phase",
    "code",
    "exitCode"
  ],
  "properties": {
    "apiVersion": {
      "const": "codeguard.transport/v1alpha1"
    },
    "kind": {
      "const": "GuardTransportDiagnostic"
    },
    "phase": {
      "enum": [
        "unbound",
        "bound"
      ]
    },
    "code": {
      "type": "string",
      "minLength": 1
    },
    "exitCode": {
      "const": 4
    }
  }
}
