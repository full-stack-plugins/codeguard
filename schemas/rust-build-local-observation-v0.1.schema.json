{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codeguard:schema:rust-build-local-observation:0.1.0",
  "title": "Unverified selected Cargo type check observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_type",
    "operation",
    "language",
    "command_status",
    "exit_code",
    "delivery_decision",
    "authority",
    "checker_id",
    "scope",
    "rule_selection",
    "local_scan_complete",
    "coverage_proven",
    "reason",
    "tool_sha256",
    "manifest_sha256",
    "lock_sha256",
    "findings",
    "backlog_status",
    "execution_budget",
    "next_actions",
    "recheck_argv",
    "workspace_binding",
    "workspace_id",
    "run_id",
    "backlog_sync",
    "build_level",
    "test_execution",
    "build_success"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "report_type": {
      "const": "rust_build_local_observation"
    },
    "operation": {
      "const": "build"
    },
    "language": {
      "const": "rust"
    },
    "command_status": {
      "enum": [
        "incomplete",
        "cancelled"
      ]
    },
    "exit_code": {
      "enum": [
        3,
        130
      ]
    },
    "delivery_decision": {
      "const": "not_evaluated"
    },
    "authority": {
      "const": "local_unverified"
    },
    "checker_id": {
      "const": "rust.cargo_check"
    },
    "scope": {
      "const": "selected_root_all_targets_default_features"
    },
    "rule_selection": {
      "const": "explicit_probe_not_approved_project_policy"
    },
    "local_scan_complete": {
      "type": "boolean"
    },
    "coverage_proven": {
      "const": false
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "tool_sha256": {
      "$ref": "#/$defs/hash"
    },
    "manifest_sha256": {
      "$ref": "#/$defs/hash"
    },
    "lock_sha256": {
      "$ref": "#/$defs/hash"
    },
    "backlog_status": {
      "const": "not_integrated"
    },
    "execution_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timeout_ms",
        "source",
        "enforcement"
      ],
      "properties": {
        "timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400000
        },
        "source": {
          "enum": [
            "cli",
            "registered_environment",
            "project_default",
            "builtin_default"
          ]
        },
        "enforcement": {
          "const": "native_execution_only"
        }
      }
    },
    "next_actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "recheck_argv": {
      "const": [
        "cargo",
        "check",
        "--locked",
        "--offline",
        "--all-targets",
        "--message-format=json"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_id",
          "finding_fingerprint",
          "source_sha256",
          "rule_id",
          "level",
          "path",
          "line",
          "column",
          "classification",
          "byte_start",
          "byte_end",
          "native_range_sha256",
          "identity_status",
          "repair_brief",
          "target_path",
          "package_id_sha256",
          "target_kinds"
        ],
        "properties": {
          "finding_id": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^CG-[0-9a-f]{32}$"
          },
          "finding_fingerprint": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "rule_id": {
            "type": "string",
            "pattern": "^E[0-9]{4}$"
          },
          "level": {
            "const": "error"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "column": {
            "type": "integer",
            "minimum": 1
          },
          "classification": {
            "const": "observed_unverified"
          },
          "byte_start": {
            "type": "integer",
            "minimum": 0
          },
          "byte_end": {
            "type": "integer",
            "minimum": 0
          },
          "native_range_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "identity_status": {
            "enum": [
              "unique_candidate",
              "ambiguous"
            ]
          },
          "repair_brief": {
            "$ref": "#/$defs/repair_brief"
          },
          "target_path": {
            "type": "string",
            "minLength": 1
          },
          "package_id_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "target_kinds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "identity_status": {
                  "const": "ambiguous"
                }
              }
            },
            "then": {
              "properties": {
                "finding_id": {
                  "type": "null"
                },
                "repair_brief": {
                  "properties": {
                    "status": {
                      "const": "investigation_required"
                    }
                  }
                }
              }
            },
            "else": {
              "properties": {
                "finding_id": {
                  "type": "string"
                }
              }
            }
          }
        ]
      }
    },
    "workspace_binding": {
      "enum": [
        "bound",
        "uninitialized",
        "invalid",
        "legacy_unbound"
      ]
    },
    "workspace_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "run_id": {
      "type": "string",
      "pattern": "^cargo-build-[0-9]+-[0-9]+$"
    },
    "backlog_sync": {
      "type": "null"
    },
    "build_level": {
      "const": "type_check"
    },
    "test_execution": {
      "const": false
    },
    "build_success": {
      "type": [
        "boolean",
        "null"
      ]
    }
  },
  "$defs": {
    "hash": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "repair_brief": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "evidence",
        "rule_basis",
        "allowed_paths",
        "steps",
        "recheck_argv",
        "working_directory",
        "tool_requirement",
        "attempt_history",
        "history_status",
        "closure_conditions"
      ],
      "properties": {
        "status": {
          "enum": [
            "repair_guidance",
            "investigation_required"
          ]
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "finding_id",
            "finding_fingerprint",
            "path",
            "source_sha256",
            "byte_start",
            "byte_end",
            "rule_id",
            "observation_reason",
            "native_range_sha256",
            "line",
            "column"
          ],
          "properties": {
            "finding_id": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^CG-[0-9a-f]{32}$"
            },
            "finding_fingerprint": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "source_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "byte_start": {
              "type": "integer",
              "minimum": 0
            },
            "byte_end": {
              "type": "integer",
              "minimum": 0
            },
            "rule_id": {
              "type": "string",
              "pattern": "^E[0-9]{4}$"
            },
            "observation_reason": {
              "type": "string",
              "minLength": 1
            },
            "native_range_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "line": {
              "type": "integer",
              "minimum": 1
            },
            "column": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "rule_basis": {
          "type": "string",
          "minLength": 1
        },
        "allowed_paths": {
          "type": "array",
          "maxItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "recheck_argv": {
          "const": [
            "cargo",
            "check",
            "--locked",
            "--offline",
            "--all-targets",
            "--message-format=json"
          ]
        },
        "working_directory": {
          "const": "selected_project_root"
        },
        "tool_requirement": {
          "type": "string",
          "minLength": 1
        },
        "attempt_history": {
          "const": []
        },
        "history_status": {
          "const": "not_integrated"
        },
        "closure_conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "investigation_required"
              }
            }
          },
          "then": {
            "properties": {
              "allowed_paths": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "allowed_paths": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "command_status": {
            "const": "cancelled"
          }
        }
      },
      "then": {
        "properties": {
          "exit_code": {
            "const": 130
          },
          "reason": {
            "const": "request_cancelled"
          },
          "local_scan_complete": {
            "const": false
          }
        }
      },
      "else": {
        "properties": {
          "exit_code": {
            "const": 3
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "local_scan_complete": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "reason": {
            "const": "native_observed_unverified"
          },
          "tool_sha256": {
            "type": "string"
          },
          "manifest_sha256": {
            "type": "string"
          },
          "lock_sha256": {
            "type": "string"
          },
          "findings": {
            "items": {
              "properties": {
                "identity_status": {
                  "const": "unique_candidate"
                }
              }
            }
          },
          "build_success": {
            "type": "boolean"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "local_scan_complete": {
            "const": false
          }
        }
      },
      "then": {
        "properties": {
          "findings": {
            "items": {
              "properties": {
                "repair_brief": {
                  "properties": {
                    "status": {
                      "const": "investigation_required"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "workspace_binding": {
            "const": "bound"
          }
        }
      },
      "then": {
        "properties": {
          "workspace_id": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "else": {
        "properties": {
          "workspace_id": {
            "type": "null"
          },
          "backlog_status": {
            "const": "not_integrated"
          },
          "backlog_sync": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "local_scan_complete": {
            "const": true
          },
          "build_success": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "findings": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "local_scan_complete": {
            "const": true
          },
          "build_success": {
            "const": false
          }
        }
      },
      "then": {
        "properties": {
          "findings": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
