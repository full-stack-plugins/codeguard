{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codeguard:schema:java-javadoc-local-feedback:0.2.0",
  "title": "Untrusted local JDK 21 Javadoc missing-comment feedback",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_type",
    "operation",
    "language",
    "category",
    "command_status",
    "exit_code",
    "local_status",
    "reason",
    "path",
    "source_sha256",
    "javadoc_tool_sha256",
    "java_runtime_sha256",
    "jdk_release_sha256",
    "checker_identity",
    "coverage_proven",
    "findings",
    "authority",
    "delivery_decision",
    "next_actions"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2.0"
    },
    "report_type": {
      "const": "java_javadoc_local_feedback"
    },
    "operation": {
      "const": "lint"
    },
    "language": {
      "const": "java"
    },
    "category": {
      "const": "comments"
    },
    "command_status": {
      "const": "incomplete"
    },
    "exit_code": {
      "const": 3
    },
    "local_status": {
      "enum": [
        "incomplete",
        "clean_scope_unproven",
        "findings_observed_untrusted"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "source_sha256": {
      "$ref": "#/$defs/optional_sha256"
    },
    "javadoc_tool_sha256": {
      "$ref": "#/$defs/optional_sha256"
    },
    "java_runtime_sha256": {
      "$ref": "#/$defs/optional_sha256"
    },
    "jdk_release_sha256": {
      "$ref": "#/$defs/optional_sha256"
    },
    "checker_identity": {
      "const": "unverified"
    },
    "coverage_proven": {
      "const": false
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "line",
          "column",
          "rule_id",
          "rule_summary"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "column": {
            "type": "integer",
            "minimum": 1
          },
          "rule_id": {
            "enum": [
              "JavadocMissingComment",
              "JavadocDefaultConstructorMissingComment",
              "JavadocMissingParam",
              "JavadocMissingReturn",
              "JavadocMissingThrows",
              "JavadocEmptyComment",
              "JavadocMissingMainDescription",
              "JavadocEmptyParamDescription",
              "JavadocEmptyReturnDescription",
              "JavadocEmptyThrowsDescription"
            ]
          },
          "rule_summary": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "authority": {
      "const": "local_unverified"
    },
    "delivery_decision": {
      "const": "not_evaluated"
    },
    "next_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "optional_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
