{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codeguard:schema:task-verification-preview:0.40.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_type",
    "operation",
    "command_status",
    "exit_code",
    "task_id",
    "kind",
    "observation",
    "event_persisted",
    "reason",
    "native_scan",
    "authority",
    "delivery_decision",
    "execution_budget",
    "next_actions"
  ],
  "properties": {
    "schema_version": {
      "const": "0.40.0"
    },
    "execution_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timeout_ms",
        "source",
        "enforcement"
      ],
      "properties": {
        "timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400000
        },
        "source": {
          "enum": [
            "cli",
            "registered_environment",
            "project_default",
            "builtin_default"
          ]
        },
        "enforcement": {
          "const": "native_execution_only"
        }
      }
    },
    "report_type": {
      "const": "task_verification_preview"
    },
    "operation": {
      "const": "task_verify"
    },
    "command_status": {
      "const": "incomplete"
    },
    "exit_code": {
      "const": 3
    },
    "task_id": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^CG-(B-)?[0-9a-f]{32}$"
        }
      ]
    },
    "kind": {
      "enum": [
        "finding",
        "blocker",
        null
      ]
    },
    "observation": {
      "enum": [
        "incomplete",
        "still_present",
        "still_blocked",
        "suppression_requires_review",
        "rule_coverage_requires_review",
        "candidate_absent_unverified_policy",
        "environment_restored_unverified_policy"
      ]
    },
    "event_persisted": {
      "type": "boolean"
    },
    "reason": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "native_scan": {
      "$ref": "java-p3c-project-observation-v0.4.schema.json"
    },
    "authority": {
      "const": "local_unverified"
    },
    "delivery_decision": {
      "const": "not_evaluated"
    },
    "next_actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "go_nullable_sha256": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      ]
    },
    "go_module_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "status",
        "diagnostic_count"
      ],
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "incomplete",
            "findings_observed_unverified",
            "clean_observed_unverified"
          ]
        },
        "diagnostic_count": {
          "type": "integer",
          "minimum": 0
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "go_finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id",
        "finding_fingerprint",
        "source_sha256",
        "module_root",
        "rule_id",
        "path",
        "line",
        "column",
        "native_message_sha256",
        "message_status"
      ],
      "properties": {
        "finding_id": {
          "type": "string",
          "pattern": "^CG-[0-9a-f]{32}$"
        },
        "finding_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "module_root": {
          "type": "string",
          "minLength": 1
        },
        "rule_id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "native_message_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "message_status": {
          "const": "native_text_private_untrusted"
        }
      }
    },
    "npmWorkbenchObservation": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "npm工作台观察0.1/0.2与输入状态准备观察0.3；不授予覆盖",
      "oneOf": [
        {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "title": "npm局部CVE工作台观察，不能自证漏洞或关闭",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "report_type",
            "workspace_binding",
            "workspace_id",
            "run_id",
            "authority",
            "coverage_proven",
            "delivery_decision",
            "checker_id",
            "build_root",
            "manifest_sha256",
            "lock_sha256",
            "diagnostic_reason",
            "component_count",
            "advisories"
          ],
          "properties": {
            "schema_version": {
              "const": "0.1.0"
            },
            "report_type": {
              "const": "npm_cve_workbench_observation"
            },
            "workspace_binding": {
              "const": "bound"
            },
            "workspace_id": {
              "type": "string",
              "minLength": 1
            },
            "run_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,120}$"
            },
            "authority": {
              "const": "local_unverified"
            },
            "coverage_proven": {
              "const": false
            },
            "delivery_decision": {
              "const": "not_evaluated"
            },
            "checker_id": {
              "const": "node.npm.audit"
            },
            "build_root": {
              "type": "string",
              "minLength": 1
            },
            "manifest_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "lock_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "diagnostic_reason": {
              "type": "string",
              "pattern": "^[a-z0-9_]{1,80}$"
            },
            "component_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "advisories": {
              "type": "array",
              "maxItems": 10000,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "component_ref",
                  "severity",
                  "advisory_sources",
                  "nodes"
                ],
                "properties": {
                  "component_ref": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "severity": {
                    "enum": [
                      "info",
                      "low",
                      "moderate",
                      "high",
                      "critical"
                    ]
                  },
                  "advisory_sources": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "nodes": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "node_ref",
                        "resolved_version"
                      ],
                      "properties": {
                        "node_ref": {
                          "type": "string",
                          "pattern": "^[a-f0-9]{64}$"
                        },
                        "resolved_version": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 256
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "diagnostic_reason": {
                    "enum": [
                      "npm_execution_context_missing",
                      "npm_manifest_invalid",
                      "npm_scripts_invalid"
                    ]
                  }
                },
                "required": [
                  "diagnostic_reason"
                ]
              },
              "then": {
                "properties": {
                  "component_count": {
                    "const": 0
                  },
                  "advisories": {
                    "maxItems": 0
                  }
                }
              }
            },
            {
              "not": {
                "properties": {
                  "diagnostic_reason": {
                    "const": "npm_lock_missing"
                  }
                },
                "required": [
                  "diagnostic_reason"
                ]
              }
            }
          ]
        },
        {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "title": "npm缺锁准备观察；未启动工具且没有漏洞结果",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "report_type",
            "workspace_binding",
            "workspace_id",
            "run_id",
            "authority",
            "coverage_proven",
            "delivery_decision",
            "checker_id",
            "build_root",
            "manifest_sha256",
            "lock_sha256",
            "diagnostic_reason",
            "component_count",
            "advisories",
            "lock_state"
          ],
          "properties": {
            "schema_version": {
              "const": "0.2.0"
            },
            "report_type": {
              "const": "npm_cve_workbench_observation"
            },
            "workspace_binding": {
              "const": "bound"
            },
            "workspace_id": {
              "type": "string",
              "minLength": 1
            },
            "run_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,120}$"
            },
            "authority": {
              "const": "local_unverified"
            },
            "coverage_proven": {
              "const": false
            },
            "delivery_decision": {
              "const": "not_evaluated"
            },
            "checker_id": {
              "const": "node.npm.audit"
            },
            "build_root": {
              "type": "string",
              "minLength": 1
            },
            "manifest_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "lock_sha256": {
              "type": "null"
            },
            "diagnostic_reason": {
              "const": "npm_lock_missing"
            },
            "component_count": {
              "const": 0
            },
            "advisories": {
              "type": "array",
              "maxItems": 0
            },
            "lock_state": {
              "const": "missing"
            }
          }
        },
        {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "title": "npm输入不可用的准备观察0.3；无原生漏洞结果",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "report_type",
            "workspace_binding",
            "workspace_id",
            "run_id",
            "authority",
            "coverage_proven",
            "delivery_decision",
            "checker_id",
            "build_root",
            "manifest_sha256",
            "lock_sha256",
            "diagnostic_reason",
            "component_count",
            "advisories",
            "manifest_state",
            "lock_state"
          ],
          "properties": {
            "schema_version": {
              "const": "0.3.0"
            },
            "report_type": {
              "const": "npm_cve_workbench_observation"
            },
            "workspace_binding": {
              "const": "bound"
            },
            "workspace_id": {
              "type": "string",
              "minLength": 1
            },
            "run_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,120}$"
            },
            "authority": {
              "const": "local_unverified"
            },
            "coverage_proven": {
              "const": false
            },
            "delivery_decision": {
              "const": "not_evaluated"
            },
            "checker_id": {
              "const": "node.npm.audit"
            },
            "build_root": {
              "type": "string",
              "minLength": 1
            },
            "manifest_sha256": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              ]
            },
            "lock_sha256": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              ]
            },
            "diagnostic_reason": {
              "enum": [
                "npm_manifest_missing",
                "npm_manifest_not_regular",
                "npm_manifest_path_alias",
                "npm_manifest_unavailable",
                "npm_lock_missing",
                "npm_lock_not_regular",
                "npm_lock_path_alias",
                "npm_lock_unavailable"
              ]
            },
            "component_count": {
              "const": 0
            },
            "advisories": {
              "type": "array",
              "maxItems": 0
            },
            "manifest_state": {
              "enum": [
                "present",
                "missing",
                "not_regular",
                "path_alias",
                "unavailable"
              ]
            },
            "lock_state": {
              "enum": [
                "present",
                "missing",
                "not_regular",
                "path_alias",
                "unavailable"
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "manifest_state": {
                    "const": "present"
                  }
                }
              },
              "then": {
                "properties": {
                  "manifest_sha256": {
                    "type": "string"
                  }
                }
              },
              "else": {
                "properties": {
                  "manifest_sha256": {
                    "type": "null"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "lock_state": {
                    "const": "present"
                  }
                }
              },
              "then": {
                "properties": {
                  "lock_sha256": {
                    "type": "string"
                  }
                }
              },
              "else": {
                "properties": {
                  "lock_sha256": {
                    "type": "null"
                  }
                }
              }
            },
            {
              "not": {
                "properties": {
                  "manifest_state": {
                    "const": "present"
                  },
                  "lock_state": {
                    "const": "present"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "manifest_state": {
                    "const": "missing"
                  }
                }
              },
              "then": {
                "properties": {
                  "diagnostic_reason": {
                    "const": "npm_manifest_missing"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "manifest_state": {
                    "const": "present"
                  },
                  "lock_state": {
                    "const": "missing"
                  }
                }
              },
              "then": {
                "properties": {
                  "diagnostic_reason": {
                    "const": "npm_lock_missing"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "manifest_state": {
                    "const": "not_regular"
                  }
                }
              },
              "then": {
                "properties": {
                  "diagnostic_reason": {
                    "const": "npm_manifest_not_regular"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "manifest_state": {
                    "const": "present"
                  },
                  "lock_state": {
                    "const": "not_regular"
                  }
                }
              },
              "then": {
                "properties": {
                  "diagnostic_reason": {
                    "const": "npm_lock_not_regular"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "manifest_state": {
                    "const": "path_alias"
                  }
                }
              },
              "then": {
                "properties": {
                  "diagnostic_reason": {
                    "const": "npm_manifest_path_alias"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "manifest_state": {
                    "const": "present"
                  },
                  "lock_state": {
                    "const": "path_alias"
                  }
                }
              },
              "then": {
                "properties": {
                  "diagnostic_reason": {
                    "const": "npm_lock_path_alias"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "manifest_state": {
                    "const": "unavailable"
                  }
                }
              },
              "then": {
                "properties": {
                  "diagnostic_reason": {
                    "const": "npm_manifest_unavailable"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "manifest_state": {
                    "const": "present"
                  },
                  "lock_state": {
                    "const": "unavailable"
                  }
                }
              },
              "then": {
                "properties": {
                  "diagnostic_reason": {
                    "const": "npm_lock_unavailable"
                  }
                }
              }
            }
          ]
        }
      ]
    }
  }
}
