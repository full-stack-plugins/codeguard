{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codeguard:schema:task-resolution-evidence:0.11.0",
  "title": "ShellCheck原规则修复与复发的脱敏证据",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.11.0"
    },
    "report_type": {
      "const": "task_resolution_evidence"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workspace_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
        },
        "task_id": {
          "type": "string",
          "pattern": "^CG-[0-9a-f]{32}$"
        },
        "checker_id": {
          "const": "shell.shellcheck"
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^\\\\:\\x00-\\x1f\\x7f]+$"
        }
      },
      "required": [
        "workspace_id",
        "task_id",
        "checker_id",
        "scope"
      ]
    },
    "original_report_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "original_source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "current_source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "grammar_sha256": {
      "type": "null"
    },
    "tool_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "adapter_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "policy_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "policy_revision": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
    },
    "original_native": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "configuration_mode",
        "diagnostics",
        "environment_codes",
        "reason",
        "report_valid",
        "status",
        "tool_sha256",
        "version"
      ],
      "properties": {
        "configuration_mode": {
          "enum": [
            "not_applied",
            "frozen_project_rc",
            "builtin_without_global_rc"
          ]
        },
        "diagnostics": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "rule_id",
              "severity",
              "line",
              "column",
              "end_line",
              "end_column"
            ],
            "properties": {
              "rule_id": {
                "type": "string",
                "pattern": "^SC[0-9]{4}$"
              },
              "severity": {
                "enum": [
                  "error",
                  "warning",
                  "info",
                  "style"
                ]
              },
              "line": {
                "type": "integer",
                "minimum": 1
              },
              "column": {
                "type": "integer",
                "minimum": 1
              },
              "end_line": {
                "type": "integer",
                "minimum": 1
              },
              "end_column": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "environment_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^SC[0-9]{4}$"
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "report_valid": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "incomplete",
            "completed",
            "diagnostics_observed"
          ]
        },
        "tool_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "version": {
          "enum": [
            null,
            "0.11.0"
          ]
        }
      }
    },
    "current_native": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "configuration_mode",
        "diagnostics",
        "environment_codes",
        "reason",
        "report_valid",
        "status",
        "tool_sha256",
        "version"
      ],
      "properties": {
        "configuration_mode": {
          "enum": [
            "not_applied",
            "frozen_project_rc",
            "builtin_without_global_rc"
          ]
        },
        "diagnostics": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "rule_id",
              "severity",
              "line",
              "column",
              "end_line",
              "end_column"
            ],
            "properties": {
              "rule_id": {
                "type": "string",
                "pattern": "^SC[0-9]{4}$"
              },
              "severity": {
                "enum": [
                  "error",
                  "warning",
                  "info",
                  "style"
                ]
              },
              "line": {
                "type": "integer",
                "minimum": 1
              },
              "column": {
                "type": "integer",
                "minimum": 1
              },
              "end_line": {
                "type": "integer",
                "minimum": 1
              },
              "end_column": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "environment_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^SC[0-9]{4}$"
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "report_valid": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "incomplete",
            "completed",
            "diagnostics_observed"
          ]
        },
        "tool_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "version": {
          "enum": [
            null,
            "0.11.0"
          ]
        }
      }
    },
    "outcome": {
      "enum": [
        "code_fixed",
        "still_present",
        "inputs_stale",
        "native_incomplete",
        "false_positive_review_required",
        "resolution_evidence_incomplete",
        "resolution_history_binding_changed",
        "suppression_requires_review"
      ]
    },
    "native_rule_id": {
      "type": "string",
      "pattern": "^SC[1-9][0-9]{3}$"
    },
    "dialect": {
      "enum": [
        "sh",
        "bash",
        "dash",
        "ksh",
        "busybox"
      ]
    },
    "project_configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "global_configuration",
        "reason",
        "sha256",
        "source_path",
        "status"
      ],
      "properties": {
        "global_configuration": {
          "const": "not_loaded"
        },
        "reason": {
          "type": "null"
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "configured",
            "missing"
          ]
        }
      }
    }
  },
  "required": [
    "schema_version",
    "report_type",
    "identity",
    "original_report_sha256",
    "original_source_sha256",
    "current_source_sha256",
    "grammar_sha256",
    "tool_sha256",
    "adapter_sha256",
    "policy_sha256",
    "policy_revision",
    "original_native",
    "current_native",
    "outcome",
    "native_rule_id",
    "dialect",
    "project_configuration"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "code_fixed"
          }
        }
      },
      "then": {
        "properties": {
          "original_native": {
            "properties": {
              "status": {
                "const": "diagnostics_observed"
              }
            }
          },
          "current_native": {
            "properties": {
              "status": {
                "enum": [
                  "completed",
                  "diagnostics_observed"
                ]
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
