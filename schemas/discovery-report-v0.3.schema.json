{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codeguard:schema:discovery-report:0.3.0",
  "title": "Codeguard static project discovery report",
  "type": "object",
  "required": ["schema_version", "report_type", "root", "observation_complete", "observed_entries", "scope_summary", "languages", "build_roots", "declared_versions", "manifest_sha256", "lockfiles", "checker_configurations", "source_set_candidates", "blocked_paths", "unknown_conditions"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "0.3.0"},
    "report_type": {"const": "discovery"},
    "root": {"type": "string", "minLength": 1},
    "observation_complete": {"type": "boolean"},
    "observed_entries": {"type": "integer", "minimum": 0},
    "scope_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinary_scan_policy", "dot_prefix_roots_excluded", "configuration_exception_files_observed", "git_safety_status"],
      "properties": {
        "ordinary_scan_policy": {"const": "dot_prefix_default_v1"},
        "dot_prefix_roots_excluded": {"type": "integer", "minimum": 0},
        "configuration_exception_files_observed": {"type": "integer", "minimum": 0},
        "git_safety_status": {"const": "not_evaluated"}
      }
    },
    "languages": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["id", "source_files", "manifests"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*$"},
          "source_files": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "manifests": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "build_roots": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["path", "manifests"],
        "additionalProperties": false,
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "manifests": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "declared_versions": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
    "manifest_sha256": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
    "lockfiles": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "checker_configurations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["build_root", "checker_id", "category", "configuration", "configuration_ref", "reason", "next_action"],
        "additionalProperties": false,
        "properties": {
          "build_root": {"type": "string", "minLength": 1},
          "checker_id": {"type": "string", "minLength": 1},
          "category": {"enum": ["lint", "comments", "dependencies", "cve", "security", "build"]},
          "configuration": {"enum": ["configured", "missing", "invalid", "unknown"]},
          "configuration_ref": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1},
          "next_action": {"type": "string", "minLength": 1}
        }
      }
    },
    "source_set_candidates": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["path", "language", "role", "basis"],
        "additionalProperties": false,
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "language": {"const": "java"},
          "role": {"enum": ["main", "test"]},
          "basis": {"const": "directory_convention"}
        }
      }
    },
    "blocked_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "unknown_conditions": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "allOf": [
    {
      "if": {"properties": {"observation_complete": {"const": true}}},
      "then": {"properties": {"blocked_paths": {"maxItems": 0}}}
    }
  ]
}
