{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codeguard:schema:checkstyle-workbench-observation-v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_type",
    "workspace_binding",
    "workspace_id",
    "run_id",
    "authority",
    "coverage_proven",
    "delivery_decision",
    "checker_id",
    "source_path",
    "inputs",
    "findings"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2.0"
    },
    "report_type": {
      "const": "java_checkstyle_workbench_observation"
    },
    "workspace_binding": {
      "const": "bound"
    },
    "workspace_id": {
      "type": "string",
      "pattern": "^ws-[0-9a-f]{32}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^checkstyle-[A-Za-z0-9-]{1,100}$"
    },
    "authority": {
      "const": "local_unverified"
    },
    "coverage_proven": {
      "const": false
    },
    "delivery_decision": {
      "const": "not_evaluated"
    },
    "checker_id": {
      "const": "java.checkstyle"
    },
    "source_path": {
      "type": "string",
      "minLength": 1
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "config",
        "java",
        "jar"
      ],
      "properties": {
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "config": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "java": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "jar": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_id",
          "finding_fingerprint",
          "source_sha256",
          "path",
          "rule_id",
          "line",
          "native"
        ],
        "properties": {
          "finding_id": {
            "type": "string",
            "pattern": "^CG-[0-9a-f]{32}$"
          },
          "finding_fingerprint": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "rule_id": {
            "type": "string",
            "minLength": 1
          },
          "line": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4294967295
          },
          "native": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "line",
              "column",
              "rule_id",
              "severity",
              "checker_class",
              "rule_summary",
              "rule_reference",
              "repair_steps"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "line": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              },
              "column": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 4294967295
                  }
                ]
              },
              "rule_id": {
                "type": "string",
                "minLength": 1
              },
              "severity": {
                "enum": [
                  "error",
                  "warning",
                  "info"
                ]
              },
              "checker_class": {
                "enum": [
                  "com.puppycrawl.tools.checkstyle.checks.javadoc.MissingJavadocTypeCheck",
                  "com.puppycrawl.tools.checkstyle.checks.javadoc.MissingJavadocMethodCheck",
                  "com.puppycrawl.tools.checkstyle.checks.javadoc.JavadocTypeCheck",
                  "com.puppycrawl.tools.checkstyle.checks.javadoc.JavadocMethodCheck",
                  "com.puppycrawl.tools.checkstyle.checks.javadoc.JavadocVariableCheck",
                  "com.puppycrawl.tools.checkstyle.checks.javadoc.JavadocStyleCheck",
                  "com.puppycrawl.tools.checkstyle.checks.javadoc.NonEmptyAtclauseDescriptionCheck",
                  "com.puppycrawl.tools.checkstyle.checks.javadoc.SummaryJavadocCheck"
                ]
              },
              "rule_summary": {
                "type": "string",
                "minLength": 1
              },
              "rule_reference": {
                "type": "string",
                "pattern": "^https://checkstyle\\.org/checks/javadoc/[a-z]+\\.html$"
              },
              "repair_steps": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
