{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeguard.dev/schemas/task-resolution-evidence-v0.7.schema.json",
  "title": "Go整文件原反例和当前源码的双制品原生复检证据",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.7.0"
    },
    "report_type": {
      "const": "task_resolution_evidence"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workspace_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
        },
        "task_id": {
          "type": "string",
          "pattern": "^CG-B-[0-9a-f]{32}$"
        },
        "checker_id": {
          "const": "syntax.native_confirmation"
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^\\\\:\\x00-\\x1f\\x7f]+$"
        }
      },
      "required": [
        "workspace_id",
        "task_id",
        "checker_id",
        "scope"
      ]
    },
    "original_report_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "original_source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "current_source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "grammar_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "tool_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "adapter_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "policy_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "policy_revision": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
    },
    "original_native": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason",
        "version",
        "tool_sha256",
        "diagnostics",
        "gofmt_sha256",
        "companion_binding_sha256",
        "input_type"
      ],
      "properties": {
        "status": {
          "enum": [
            "incomplete",
            "completed",
            "diagnostics_observed"
          ]
        },
        "reason": {
          "enum": [
            "go_syntax_input_invalid",
            "go_syntax_tool_unavailable",
            "go_syntax_tool_changed",
            "go_syntax_version_unverified",
            "go_syntax_execution_incomplete",
            "go_syntax_report_invalid",
            "go_native_syntax_no_diagnostics",
            "go_native_syntax_diagnostics",
            "go_syntax_logical_positions_unresolved"
          ]
        },
        "version": {
          "enum": [
            null,
            "go1.23.4"
          ]
        },
        "tool_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "diagnostics": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "line",
              "rule_id",
              "column",
              "column_unit"
            ],
            "properties": {
              "line": {
                "type": "integer",
                "minimum": 1
              },
              "rule_id": {
                "const": "go.syntax"
              },
              "column": {
                "type": "integer",
                "minimum": 1
              },
              "column_unit": {
                "const": "utf8_byte"
              }
            }
          }
        },
        "input_type": {
          "const": "whole_file"
        },
        "gofmt_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "companion_binding_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "completed"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "const": "go_native_syntax_no_diagnostics"
              },
              "version": {
                "const": "go1.23.4"
              },
              "tool_sha256": {
                "type": "string"
              },
              "diagnostics": {
                "maxItems": 0
              },
              "gofmt_sha256": {
                "type": "string"
              },
              "companion_binding_sha256": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "diagnostics_observed"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "const": "go_native_syntax_diagnostics"
              },
              "version": {
                "const": "go1.23.4"
              },
              "tool_sha256": {
                "type": "string"
              },
              "diagnostics": {
                "minItems": 1
              },
              "gofmt_sha256": {
                "type": "string"
              },
              "companion_binding_sha256": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "incomplete"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "enum": [
                  "go_syntax_input_invalid",
                  "go_syntax_tool_unavailable",
                  "go_syntax_tool_changed",
                  "go_syntax_version_unverified",
                  "go_syntax_execution_incomplete",
                  "go_syntax_report_invalid",
                  "go_syntax_logical_positions_unresolved"
                ]
              },
              "diagnostics": {
                "const": []
              }
            }
          }
        }
      ]
    },
    "current_native": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason",
        "version",
        "tool_sha256",
        "diagnostics",
        "gofmt_sha256",
        "companion_binding_sha256",
        "input_type"
      ],
      "properties": {
        "status": {
          "enum": [
            "incomplete",
            "completed",
            "diagnostics_observed"
          ]
        },
        "reason": {
          "enum": [
            "go_syntax_input_invalid",
            "go_syntax_tool_unavailable",
            "go_syntax_tool_changed",
            "go_syntax_version_unverified",
            "go_syntax_execution_incomplete",
            "go_syntax_report_invalid",
            "go_native_syntax_no_diagnostics",
            "go_native_syntax_diagnostics",
            "go_syntax_logical_positions_unresolved"
          ]
        },
        "version": {
          "enum": [
            null,
            "go1.23.4"
          ]
        },
        "tool_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "diagnostics": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "line",
              "rule_id",
              "column",
              "column_unit"
            ],
            "properties": {
              "line": {
                "type": "integer",
                "minimum": 1
              },
              "rule_id": {
                "const": "go.syntax"
              },
              "column": {
                "type": "integer",
                "minimum": 1
              },
              "column_unit": {
                "const": "utf8_byte"
              }
            }
          }
        },
        "input_type": {
          "const": "whole_file"
        },
        "gofmt_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "companion_binding_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "completed"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "const": "go_native_syntax_no_diagnostics"
              },
              "version": {
                "const": "go1.23.4"
              },
              "tool_sha256": {
                "type": "string"
              },
              "diagnostics": {
                "maxItems": 0
              },
              "gofmt_sha256": {
                "type": "string"
              },
              "companion_binding_sha256": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "diagnostics_observed"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "const": "go_native_syntax_diagnostics"
              },
              "version": {
                "const": "go1.23.4"
              },
              "tool_sha256": {
                "type": "string"
              },
              "diagnostics": {
                "minItems": 1
              },
              "gofmt_sha256": {
                "type": "string"
              },
              "companion_binding_sha256": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "incomplete"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "enum": [
                  "go_syntax_input_invalid",
                  "go_syntax_tool_unavailable",
                  "go_syntax_tool_changed",
                  "go_syntax_version_unverified",
                  "go_syntax_execution_incomplete",
                  "go_syntax_report_invalid",
                  "go_syntax_logical_positions_unresolved"
                ]
              },
              "diagnostics": {
                "const": []
              }
            }
          }
        }
      ]
    },
    "outcome": {
      "enum": [
        "code_fixed",
        "still_present",
        "inputs_stale",
        "native_incomplete",
        "false_positive_review_required",
        "resolution_evidence_incomplete",
        "resolution_history_binding_changed"
      ]
    },
    "gofmt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "companion_binding_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "schema_version",
    "report_type",
    "identity",
    "original_report_sha256",
    "original_source_sha256",
    "current_source_sha256",
    "grammar_sha256",
    "tool_sha256",
    "adapter_sha256",
    "policy_sha256",
    "policy_revision",
    "original_native",
    "current_native",
    "outcome",
    "gofmt_sha256",
    "companion_binding_sha256"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "code_fixed"
          }
        }
      },
      "then": {
        "properties": {
          "original_native": {
            "properties": {
              "status": {
                "const": "diagnostics_observed"
              }
            }
          },
          "current_native": {
            "properties": {
              "status": {
                "const": "completed"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {}
}
