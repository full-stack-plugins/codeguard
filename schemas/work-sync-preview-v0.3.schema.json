{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codeguard:schema:work-sync-preview:0.3.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_type",
    "operation",
    "command_status",
    "delivery_decision",
    "restored_task_projections",
    "workspace_id",
    "imported_reports",
    "already_consumed_reports",
    "new_findings",
    "new_blockers",
    "historical_findings",
    "failed_reports",
    "next_actions"
  ],
  "properties": {
    "schema_version": {
      "const": "0.3.0"
    },
    "report_type": {
      "const": "work_sync_preview"
    },
    "operation": {
      "const": "work_sync"
    },
    "workspace_id": {
      "type": "string",
      "pattern": "^ws-[0-9a-f]{32}$"
    },
    "command_status": {
      "enum": [
        "partial",
        "incomplete"
      ]
    },
    "imported_reports": {
      "type": "integer",
      "minimum": 0
    },
    "already_consumed_reports": {
      "type": "integer",
      "minimum": 0
    },
    "new_findings": {
      "type": "integer",
      "minimum": 0
    },
    "new_blockers": {
      "type": "integer",
      "minimum": 0
    },
    "historical_findings": {
      "type": "integer",
      "minimum": 0
    },
    "failed_reports": {
      "type": "integer",
      "minimum": 0
    },
    "delivery_decision": {
      "const": "not_evaluated"
    },
    "next_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "restored_task_projections": {
      "type": "integer",
      "minimum": 1
    }
  }
}
