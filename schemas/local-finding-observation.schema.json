{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codeguard:schema:local-finding-observation:0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "finding_id", "workspace_id", "run_id", "report_sha256", "source_sha256", "line", "authority"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "record_type": {"const": "local_finding_observation"},
    "finding_id": {"type": "string", "pattern": "^CG-[0-9a-f]{32}$"},
    "workspace_id": {"type": "string", "pattern": "^ws-[0-9a-f]{32}$"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,120}$"},
    "report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "line": {"type": "integer", "minimum": 1},
    "authority": {"const": "local_unverified"}
  }
}
