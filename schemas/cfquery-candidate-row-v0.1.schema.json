{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "path",
    "language",
    "scope",
    "byte_offset",
    "status",
    "reason",
    "grammar_qualified",
    "source_sha256",
    "grammar_sha256",
    "recovery_count",
    "recoveries",
    "known_limitations",
    "fragment_source_sha256"
  ],
  "properties": {
    "path": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "const": "cfquery"
    },
    "scope": {
      "const": "cfquery_body"
    },
    "byte_offset": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "enum": [
        "candidate_observed",
        "candidate_unavailable"
      ]
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "grammar_qualified": {
      "const": false
    },
    "source_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "grammar_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "recovery_count": {
      "type": "integer",
      "minimum": 0
    },
    "known_limitations": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    },
    "recoveries": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "syntax_kind",
          "start_byte",
          "end_byte",
          "start_row",
          "start_column_byte",
          "end_row",
          "end_column_byte"
        ],
        "properties": {
          "kind": {
            "enum": [
              "ERROR",
              "MISSING"
            ]
          },
          "syntax_kind": {
            "type": "string",
            "minLength": 1
          },
          "start_byte": {
            "type": "integer",
            "minimum": 0
          },
          "end_byte": {
            "type": "integer",
            "minimum": 0
          },
          "start_row": {
            "type": "integer",
            "minimum": 0
          },
          "start_column_byte": {
            "type": "integer",
            "minimum": 0
          },
          "end_row": {
            "type": "integer",
            "minimum": 0
          },
          "end_column_byte": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "structural_observation_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 128
    },
    "structural_observations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "$ref": "cfquery-structure-v0.1.schema.json"
      }
    },
    "fragment_source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "structural_observations"
        ]
      },
      "then": {
        "required": [
          "structural_observation_count"
        ]
      }
    },
    {
      "if": {
        "required": [
          "structural_observation_count"
        ]
      },
      "then": {
        "required": [
          "structural_observations"
        ]
      }
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
