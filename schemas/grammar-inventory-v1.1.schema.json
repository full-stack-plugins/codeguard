            "tsx",
            "typescript",
            "vbnet",
            "zig"
          ]
        },
        "provider": {
          "enum": [
            "codegraph_vendored",
            "tree_sitter_wasms_dependency"
          ]
        },
        "source_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_bytes": {
          "type": "integer",
          "minimum": 8
        },
        "candidate_wasm_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "candidate_input_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "integration_status": {
          "enum": [
            "candidate_unvalidated",
            "not_integrated"
          ]
        },
        "runtime_observation": {
          "enum": [
            "rust_loader_smoke_passed",
            "rust_loader_incompatible",
            null
          ]
        },
        "known_limitations": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
          }
        },
        "released": {
          "const": false
        },
        "gap": {
          "enum": [
            "rust_loader_incompatible",
            "current_loader_size_limit",
            "language_qualification_and_release_pending",
            "asset_provenance_license_and_loader_validation_pending"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "integration_status": {
                "const": "candidate_unvalidated"
              }
            }
          },
          "then": {
            "properties": {
              "candidate_wasm_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "runtime_observation": {
                "type": "string"
              },
              "known_limitations": {
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "candidate_wasm_sha256": {
                "type": "null"
              },
              "candidate_input_sha256": {
                "type": "null"
              },
              "runtime_observation": {
                "type": "null"
              },
              "known_limitations": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    }
  },
