  "$defs": {
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "language",
        "provider",
        "source_path",
        "source_sha256",
        "source_bytes",
        "candidate_wasm_sha256",
        "candidate_input_sha256",
        "integration_status",
        "runtime_observation",
        "known_limitations",
        "released",
        "gap"
      ],
      "properties": {
        "language": {
          "enum": [
            "arkts",
            "c",
            "cfml",
            "cfquery",
            "cfscript",
            "cobol",
            "cpp",
            "csharp",
            "dart",
            "erlang",
