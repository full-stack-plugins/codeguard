{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codeguard:schema:zig-lint-feedback:0.3.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_type",
    "operation",
    "language",
    "path",
    "status",
    "coverage_proven",
    "delivery_decision",
    "authority",
    "source_sha256",
    "native",
    "syntax_precheck",
    "next_action",
    "tool_selection",
    "source_current",
    "workspace_binding",
    "task_id",
    "task_status",
    "task_sync_reason"
  ],
  "properties": {
    "schema_version": {
      "const": "0.3.0"
    },
    "report_type": {
      "const": "zig_lint_feedback"
    },
    "operation": {
      "const": "lint"
    },
    "language": {
      "const": "zig"
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "incomplete"
    },
    "coverage_proven": {
      "const": false
    },
    "delivery_decision": {
      "const": "not_evaluated"
    },
    "authority": {
      "const": "local_unverified"
    },
    "source_sha256": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/digest"
        }
      ]
    },
    "native": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason",
        "version",
        "tool_sha256",
        "diagnostics"
      ],
      "properties": {
        "status": {
          "enum": [
            "not_run",
            "incomplete",
            "completed",
            "diagnostics_observed"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "enum": [
            null,
            "0.16.0"
          ]
        },
        "tool_sha256": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/digest"
            }
          ]
        },
        "diagnostic_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32
        },
        "diagnostics": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/diagnostic"
          }
        }
      }
    },
    "syntax_precheck": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/candidate"
        }
      ]
    },
    "next_action": {
      "type": "string",
      "minLength": 1
    },
    "source_current": {
      "type": "boolean"
    },
    "tool_selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "executable"
      ],
      "properties": {
        "source": {
          "enum": [
            "explicit",
            "path",
            "not_found"
          ]
        },
        "executable": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^/"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "source": {
                "const": "not_found"
              }
            }
          },
          "then": {
            "properties": {
              "executable": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "executable": {
                "type": "string",
                "pattern": "^/"
              }
            }
          }
        }
      ]
    },
    "workspace_binding": {
      "enum": [
        "bound",
        "invalid"
      ]
    },
    "task_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^CG-B-[0-9a-f]{32}$"
    },
    "task_status": {
      "enum": [
        "synced_partial",
        "incomplete"
      ]
    },
    "task_sync_reason": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "line",
        "column",
        "rule_id"
      ],
      "properties": {
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "rule_id": {
          "const": "zig.ast_check.error"
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "oneOf": [
        {
          "required": [
            "grammar_qualified",
            "grammar_sha256",
            "precheck",
            "recoveries"
          ],
          "not": {
            "required": [
              "reason"
            ]
          }
        },
        {
          "required": [
            "reason"
          ],
          "not": {
            "required": [
              "precheck"
            ]
          }
        }
      ],
      "properties": {
        "status": {
          "const": "incomplete"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "grammar_qualified": {
          "const": false
        },
        "grammar_sha256": {
          "$ref": "#/$defs/digest"
        },
        "precheck": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "scope_complete",
            "cancelled",
            "selected_files",
            "checked_files",
            "incomplete_files",
            "unsupported_files",
            "unqualified_files",
            "truncated_files",
            "suspected_recoveries"
          ],
          "properties": {
            "status": {
              "const": "incomplete"
            },
            "scope_complete": {
              "type": "boolean"
            },
            "cancelled": {
              "const": false
            },
            "selected_files": {
              "const": 1
            },
            "checked_files": {
              "const": 1
            },
            "incomplete_files": {
              "const": 0
            },
            "unsupported_files": {
              "const": 0
            },
            "unqualified_files": {
              "const": 1
            },
            "truncated_files": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1
            },
            "suspected_recoveries": {
              "type": "integer",
              "minimum": 0,
              "maximum": 128
            }
          }
        },
        "recoveries": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/recovery"
          }
        }
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "group_id",
        "syntax_kind",
        "start_byte",
        "end_byte",
        "start_row",
        "start_column_byte",
        "end_row",
        "end_column_byte"
      ],
      "properties": {
        "kind": {
          "enum": [
            "ERROR",
            "MISSING"
          ]
        },
        "group_id": {
          "type": "integer",
          "minimum": 1
        },
        "syntax_kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "start_byte": {
          "type": "integer",
          "minimum": 0
        },
        "end_byte": {
          "type": "integer",
          "minimum": 0
        },
        "start_row": {
          "type": "integer",
          "minimum": 0
        },
        "start_column_byte": {
          "type": "integer",
          "minimum": 0
        },
        "end_row": {
          "type": "integer",
          "minimum": 0
        },
        "end_column_byte": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "source_current": {
            "const": false
          }
        }
      },
      "then": {
        "properties": {
          "native": {
            "properties": {
              "status": {
                "enum": [
                  "not_run",
                  "incomplete"
                ]
              },
              "diagnostics": {
                "maxItems": 0
              }
            }
          },
          "syntax_precheck": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "native": {
            "properties": {
              "status": {
                "const": "completed"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "source_current": {
            "const": true
          },
          "source_sha256": {
            "$ref": "#/$defs/digest"
          },
          "tool_selection": {
            "properties": {
              "source": {
                "enum": [
                  "explicit",
                  "path"
                ]
              },
              "executable": {
                "type": "string",
                "pattern": "^/"
              }
            }
          },
          "native": {
            "required": [
              "diagnostic_count"
            ],
            "properties": {
              "version": {
                "const": "0.16.0"
              },
              "tool_sha256": {
                "$ref": "#/$defs/digest"
              },
              "diagnostics": {
                "maxItems": 0
              },
              "diagnostic_count": {
                "const": 0
              }
            }
          },
          "syntax_precheck": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "native": {
            "properties": {
              "status": {
                "const": "diagnostics_observed"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "source_current": {
            "const": true
          },
          "source_sha256": {
            "$ref": "#/$defs/digest"
          },
          "tool_selection": {
            "properties": {
              "source": {
                "enum": [
                  "explicit",
                  "path"
                ]
              },
              "executable": {
                "type": "string",
                "pattern": "^/"
              }
            }
          },
          "native": {
            "required": [
              "diagnostic_count"
            ],
            "properties": {
              "version": {
                "const": "0.16.0"
              },
              "tool_sha256": {
                "$ref": "#/$defs/digest"
              },
              "diagnostics": {
                "minItems": 1
              },
              "diagnostic_count": {
                "minimum": 1
              }
            }
          },
          "syntax_precheck": {
            "type": "null"
          }
        }
      }
    }
  ]
}
