{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_type",
    "operation",
    "command_status",
    "exit_code",
    "task_id",
    "kind",
    "observation",
    "event_persisted",
    "reason",
    "native_scan",
    "authority",
    "delivery_decision",
    "execution_budget",
    "next_actions"
  ],
  "properties": {
    "schema_version": {
      "const": "0.36.0"
    },
    "execution_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timeout_ms",
        "source",
        "enforcement"
      ],
      "properties": {
        "timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400000
        },
        "source": {
          "enum": [
            "cli",
            "registered_environment",
            "project_default",
            "builtin_default"
          ]
        },
        "enforcement": {
          "const": "native_execution_only"
        }
      }
    },
    "report_type": {
      "const": "task_verification_preview"
    },
    "operation": {
      "const": "task_verify"
    },
    "command_status": {
      "enum": [
        "incomplete",
        "cancelled"
      ]
    },
    "exit_code": {
      "enum": [
        3,
        130
      ]
    },
    "task_id": {
      "type": "string",
      "pattern": "^CG-(B-)?[0-9a-f]{32}$"
    },
    "kind": {
      "enum": [
        "finding",
        "blocker"
      ]
    },
    "observation": {
      "enum": [
        "still_present",
        "candidate_absent_unverified_policy",
        "incomplete",
        "still_blocked",
        "environment_restored_unverified_policy"
      ]
    },
    "event_persisted": {
      "type": "boolean"
    },
    "reason": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "native_scan": {
      "$ref": "urn:codeguard:clang-documentation-task-recheck:0.1"
    },
    "authority": {
      "const": "local_unverified"
    },
    "delivery_decision": {
      "const": "not_evaluated"
    },
    "next_actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$id": "urn:codeguard:task-verification-preview:0.36",
  "allOf": [
    {
      "if": {
        "properties": {
          "command_status": {
            "const": "cancelled"
          }
        }
      },
      "then": {
        "properties": {
          "exit_code": {
            "const": 130
          },
          "event_persisted": {
            "const": false
          },
          "reason": {
            "const": "request_cancelled"
          }
        }
      },
      "else": {
        "properties": {
          "exit_code": {
            "const": 3
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "native_scan": {
            "anyOf": [
              {
                "properties": {
                  "input_stable": {
                    "const": false
                  }
                }
              },
              {
                "properties": {
                  "local_scan_complete": {
                    "const": false
                  }
                }
              }
            ]
          }
        }
      },
      "then": {
        "properties": {
          "observation": {
            "enum": [
              "incomplete",
              "still_blocked"
            ]
          }
        }
      }
    }
  ]
}
