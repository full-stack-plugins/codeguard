{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codeguard:schema:grammar-asset-manifest:1.0.0",
  "title": "Pinned candidate Tree-sitter WASM assets; no CodeGuard syntax support claim",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_repository", "source_commit", "codegraph_license", "codegraph_license_sha256", "build_tool", "dependency_package_integrity", "dependency_package_license", "dependency_package_license_sha256", "assets"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "source_repository": {"const": "https://github.com/partme-ai/codegraph"},
    "source_commit": {"$ref": "#/$defs/commit"},
    "codegraph_license": {"const": "LICENSE.codegraph"},
    "codegraph_license_sha256": {"$ref": "#/$defs/sha256"},
    "build_tool": {"const": "tree-sitter-cli 0.25.10 build --wasm; Zig: tree-sitter-cli 0.27.0 generate --abi 15 + Zig 0.16.0 wasm32-wasi; Dart: pinned parser.c/scanner.c + Zig 0.16.0 wasm32-wasi; ArkTS/Terraform: pinned npm prebuilt WASM"},
    "dependency_package_integrity": {"type": "string", "pattern": "^tree-sitter-wasms@0\\.1\\.13 sha512-[A-Za-z0-9+/]+=*$"},
    "dependency_package_license": {"const": "LICENSE.tree-sitter-wasms"},
    "dependency_package_license_sha256": {"$ref": "#/$defs/sha256"},
    "assets": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/asset"}}
  },
  "$defs": {
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "dialect", "grammar_repository", "grammar_commit", "grammar_version", "path", "sha256", "bytes", "license", "license_sha256", "abi_version", "codegraph_runtime", "codeguard_runtime_validation", "language_versions", "known_limitations", "release_status"],
      "properties": {
        "language": {"enum": ["arkts", "c", "cfml", "cfquery", "cfscript", "cobol", "cpp", "csharp", "dart", "erlang", "go", "java", "javascript", "kotlin", "lua", "luau", "nix", "objc", "pascal", "php", "python", "r", "ruby", "rust", "scala", "solidity", "swift", "terraform", "tsx", "typescript", "vbnet", "zig"]},
        "dialect": {"type": "string", "minLength": 1},
        "loader_symbol": {"const": "c_sharp"},
        "grammar_repository": {"type": "string", "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "grammar_commit": {"$ref": "#/$defs/commit"},
        "grammar_version": {"type": "string", "minLength": 1, "maxLength": 128},
        "package_integrity": {"type": "string", "pattern": "^(@?[A-Za-z0-9_.-]+/)?[A-Za-z0-9_.-]+@[0-9]+\\.[0-9]+\\.[0-9]+ sha512-[A-Za-z0-9+/]+=*$"},
        "path": {"type": "string", "pattern": "^[a-z0-9_]+/parser\\.wasm$"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 8, "maximum": 33554432},
        "source_wasm": {"type": "string", "pattern": "^[a-z0-9_]+/source\\.wasm$"},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "license": {"type": "string", "pattern": "^[a-z0-9_]+/LICENSE$"},
        "license_sha256": {"$ref": "#/$defs/sha256"},
        "abi_version": {"type": "integer", "minimum": 13, "maximum": 15},
        "codegraph_runtime": {"const": "web-tree-sitter 0.25.3"},
        "codeguard_runtime_validation": {"const": "rust_loader_smoke_passed"},
        "language_versions": {"type": "array", "maxItems": 0},
        "known_limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "release_status": {"const": "candidate_unvalidated"}
      }
    }
  }
}
