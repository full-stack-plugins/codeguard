{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codeguard:schema:rustfmt-syntax-observation:0.2.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "reason",
    "version",
    "tool_sha256",
    "edition",
    "observation_kind",
    "diagnostics"
  ],
  "properties": {
    "status": {
      "enum": [
        "incomplete",
        "completed",
        "diagnostics_observed"
      ]
    },
    "reason": {
      "type": "string",
      "pattern": "^[a-z_]{1,128}$"
    },
    "version": {
      "enum": [
        null,
        "rustfmt 1.9.0-stable"
      ]
    },
    "tool_sha256": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      ]
    },
    "edition": {
      "enum": [
        "2015",
        "2018",
        "2021",
        "2024"
      ]
    },
    "observation_kind": {
      "const": "formatter_parser"
    },
    "diagnostics": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "line",
          "rule_id"
        ],
        "properties": {
          "line": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4294967295
          },
          "rule_id": {
            "const": "rust.syntax"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "incomplete"
          }
        }
      },
      "then": {
        "properties": {
          "diagnostics": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "version": {
            "const": "rustfmt 1.9.0-stable"
          },
          "tool_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "completed"
          }
        }
      },
      "then": {
        "properties": {
          "reason": {
            "const": "rustfmt_native_parse_no_diagnostics"
          },
          "diagnostics": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "diagnostics_observed"
          }
        }
      },
      "then": {
        "properties": {
          "reason": {
            "const": "rustfmt_native_parse_diagnostics"
          },
          "diagnostics": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "title": "Rust formatter parser observation with resolved Cargo edition"
}
