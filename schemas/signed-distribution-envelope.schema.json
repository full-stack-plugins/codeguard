{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codeguard:schema:signed-distribution-envelope:1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "key_id",
    "release_json",
    "signature_hex"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "key_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "release_json": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "signature_hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{128}$"
    }
  }
}
