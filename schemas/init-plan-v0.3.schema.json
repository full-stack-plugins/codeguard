{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codeguard:schema:init-plan:0.3.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "report_type", "workspace_id", "operation", "mode", "init_status", "readiness", "delivery_decision", "observation_complete", "profile_stale", "planned_files", "changed_files", "changed_directories", "conflict_file", "unresolved", "next_actions"],
  "properties": {
    "schema_version": {"const": "0.3.0"},
    "report_type": {"const": "init_plan"},
    "workspace_id": {"type": "string", "pattern": "^ws-[0-9a-f]{32}$"},
    "operation": {"const": "init"},
    "mode": {"enum": ["dry_run", "apply"]},
    "init_status": {"enum": ["planned", "partial", "conflict"]},
    "readiness": {"const": "unknown"},
    "delivery_decision": {"const": "not_evaluated"},
    "observation_complete": {"type": "boolean"},
    "profile_stale": {"type": ["boolean", "null"]},
    "planned_files": {"$ref": "#/$defs/paths"},
    "changed_files": {"$ref": "#/$defs/paths"},
    "changed_directories": {"$ref": "#/$defs/paths"},
    "conflict_file": {"type": ["string", "null"]},
    "unresolved": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "next_actions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^(?:AGENTS\\.md|codeguard(?:/[^/]+)*)$"}}
  }
}
