{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codeguard:schema:java-p3c-file-feedback:0.1.0",
  "title": "Bound single-file P3C feedback 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_type",
    "operation",
    "language",
    "checker_id",
    "command_status",
    "exit_code",
    "scope",
    "path",
    "project_observation",
    "workbench",
    "next",
    "coverage_proven",
    "delivery_decision"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "report_type": {
      "const": "java_p3c_file_feedback"
    },
    "operation": {
      "const": "lint"
    },
    "language": {
      "const": "java"
    },
    "checker_id": {
      "const": "java.maven.p3c"
    },
    "command_status": {
      "const": "incomplete"
    },
    "exit_code": {
      "const": 3
    },
    "scope": {
      "const": "single_file"
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "project_observation": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "report_type",
            "operation",
            "command_status",
            "exit_code",
            "workspace_binding",
            "workspace_id",
            "run_id",
            "tool_approval",
            "rulepack_approval",
            "checker_id",
            "language",
            "category",
            "source_file_count",
            "observed_file_count",
            "finding_count",
            "findings",
            "local_observation_complete",
            "coverage_proven",
            "authority",
            "delivery_decision",
            "files",
            "backlog_status",
            "backlog_sync",
            "next"
          ],
          "properties": {
            "schema_version": {
              "const": "0.2.0"
            },
            "report_type": {
              "const": "java_p3c_project_observation"
            },
            "operation": {
              "const": "lint"
            },
            "command_status": {
              "const": "incomplete"
            },
            "exit_code": {
              "const": 3
            },
            "workspace_binding": {
              "const": "bound"
            },
            "workspace_id": {
              "type": "string",
              "minLength": 1
            },
            "run_id": {
              "type": "string"
            },
            "tool_approval": {
              "const": "unverified"
            },
            "rulepack_approval": {
              "const": "unverified"
            },
            "checker_id": {
              "const": "java.maven.p3c"
            },
            "language": {
              "const": "java"
            },
            "category": {
              "const": "lint"
            },
            "source_file_count": {
              "const": 1
            },
            "observed_file_count": {
              "type": "integer",
              "minimum": 0
            },
            "finding_count": {
              "type": "integer",
              "minimum": 0
            },
            "findings": {
              "type": "array"
            },
            "local_observation_complete": {
              "type": "boolean"
            },
            "coverage_proven": {
              "const": false
            },
            "authority": {
              "const": "local_unverified"
            },
            "delivery_decision": {
              "const": "not_evaluated"
            },
            "backlog_status": {
              "enum": [
                "synced_partial",
                "not_initialized",
                "backlog_update_failed"
              ]
            },
            "backlog_sync": {
              "type": [
                "object",
                "null"
              ]
            },
            "next": {
              "type": [
                "object",
                "null"
              ]
            },
            "files": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "build_root",
                  "configuration",
                  "configuration_ref",
                  "reason",
                  "observation"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "build_root": {
                    "type": "string",
                    "minLength": 1
                  },
                  "configuration": {
                    "enum": [
                      "configured",
                      "missing",
                      "unknown",
                      "invalid"
                    ]
                  },
                  "configuration_ref": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "configuration_sha256": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "reason": {
                    "enum": [
                      "native_probe_returned",
                      "finding_projection_incomplete",
                      "p3c_configuration_not_confirmed",
                      "p3c_configuration_changed_before_scan",
                      "p3c_configuration_changed_during_scan",
                      "p3c_ruleset_selection_unresolved",
                      "request_cancelled",
                      "request_deadline_exceeded"
                    ]
                  },
                  "observation": {
                    "oneOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "schema_version",
                          "report_type",
                          "operation",
                          "language",
                          "request_id",
                          "command_status",
                          "exit_code",
                          "local_status",
                          "reason",
                          "path",
                          "source_sha256",
                          "maven_tool_sha256",
                          "java_runtime_sha256",
                          "dependency_closure_sha256",
                          "checker_identity",
                          "rulepack_approval",
                          "declared_rulesets",
                          "native_plan_sha256",
                          "coverage_proven",
                          "findings",
                          "delivery_decision",
                          "warnings",
                          "next_actions"
                        ],
                        "properties": {
                          "schema_version": {
                            "const": "0.2.0"
                          },
                          "report_type": {
                            "const": "java_p3c_local_feedback"
                          },
                          "operation": {
                            "const": "lint"
                          },
                          "language": {
                            "const": "java"
                          },
                          "request_id": {
                            "type": "string",
                            "minLength": 1
                          },
                          "command_status": {
                            "const": "incomplete"
                          },
                          "exit_code": {
                            "const": 3
                          },
                          "local_status": {
                            "enum": [
                              "incomplete",
                              "clean_scope_unproven",
                              "findings_observed_untrusted"
                            ]
                          },
                          "reason": {
                            "type": "string",
                            "minLength": 1
                          },
                          "path": {
                            "type": "string"
                          },
                          "source_sha256": {
                            "type": [
                              "string",
                              "null"
                            ],
                            "pattern": "^[0-9a-f]{64}$"
                          },
                          "maven_tool_sha256": {
                            "type": [
                              "string",
                              "null"
                            ],
                            "pattern": "^[0-9a-f]{64}$"
                          },
                          "java_runtime_sha256": {
                            "type": [
                              "string",
                              "null"
                            ],
                            "pattern": "^[0-9a-f]{64}$"
                          },
                          "dependency_closure_sha256": {
                            "type": [
                              "string",
                              "null"
                            ],
                            "pattern": "^[0-9a-f]{64}$"
                          },
                          "checker_identity": {
                            "const": "unverified"
                          },
                          "rulepack_approval": {
                            "const": "unverified"
                          },
                          "declared_rulesets": {
                            "type": "array",
                            "minItems": 1,
                            "maxItems": 10,
                            "uniqueItems": true,
                            "items": {
                              "type": "string",
                              "pattern": "^rulesets/java/ali-[a-z]+\\.xml$"
                            }
                          },
                          "native_plan_sha256": {
                            "type": "string",
                            "pattern": "^[0-9a-f]{64}$"
                          },
                          "coverage_proven": {
                            "const": false
                          },
                          "findings": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "additionalProperties": false,
                              "required": [
                                "path",
                                "line",
                                "column",
                                "rule_id",
                                "ruleset",
                                "native_priority",
                                "rule_summary"
                              ],
                              "properties": {
                                "path": {
                                  "type": "string"
                                },
                                "line": {
                                  "type": "integer",
                                  "minimum": 1
                                },
                                "column": {
                                  "type": "integer",
                                  "minimum": 1
                                },
                                "rule_id": {
                                  "type": "string",
                                  "minLength": 1
                                },
                                "ruleset": {
                                  "type": "string",
                                  "minLength": 1
                                },
                                "native_priority": {
                                  "type": "integer",
                                  "minimum": 1,
                                  "maximum": 5
                                },
                                "rule_summary": {
                                  "type": "string",
                                  "minLength": 1
                                }
                              }
                            }
                          },
                          "delivery_decision": {
                            "const": "not_evaluated"
                          },
                          "warnings": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "next_actions": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        }
                      }
                    ]
                  }
                }
              },
              "minItems": 1,
              "maxItems": 1
            }
          }
        }
      ]
    },
    "workbench": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason"
      ],
      "properties": {
        "status": {
          "enum": [
            "synced_partial",
            "backlog_update_failed",
            "not_initialized"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z][a-z0-9_]*$"
        }
      }
    },
    "next": {
      "type": [
        "object",
        "null"
      ]
    },
    "coverage_proven": {
      "const": false
    },
    "delivery_decision": {
      "const": "not_evaluated"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "workbench": {
            "properties": {
              "status": {
                "enum": [
                  "backlog_update_failed",
                  "not_initialized"
                ]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "next": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "workbench": {
            "properties": {
              "status": {
                "const": "synced_partial"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "project_observation": {
            "type": "object"
          },
          "next": {
            "type": "object"
          },
          "workbench": {
            "properties": {
              "reason": {
                "type": "null"
              }
            }
          }
        }
      }
    }
  ]
}
