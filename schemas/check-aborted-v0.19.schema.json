{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codeguard:schema:check-aborted:0.19.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_type",
    "operation",
    "selection",
    "command_status",
    "exit_code",
    "delivery_decision",
    "authority",
    "reason",
    "failed_task_ids",
    "execution_tasks",
    "discovery",
    "native_results",
    "export"
  ],
  "properties": {
    "schema_version": {
      "const": "0.19.0"
    },
    "report_type": {
      "const": "check_aborted"
    },
    "operation": {
      "const": "check"
    },
    "selection": {
      "enum": [
        "all",
        "java"
      ]
    },
    "command_status": {
      "enum": [
        "internal_error",
        "cancelled"
      ]
    },
    "exit_code": {
      "enum": [
        4,
        130
      ]
    },
    "delivery_decision": {
      "enum": [
        "incomplete",
        "not_evaluated"
      ]
    },
    "authority": {
      "const": "local_unverified"
    },
    "reason": {
      "enum": [
        "native_task_internal_failure",
        "request_cancelled"
      ]
    },
    "failed_task_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "execution_tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "native_observed_unverified",
              "native_incomplete",
              "cancelled",
              "deadline_exceeded",
              "dependency_failed",
              "cancelled_before_start",
              "deadline_before_start",
              "internal_failure"
            ]
          }
        }
      }
    },
    "discovery": {
      "type": "object"
    },
    "native_results": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "python_lint",
        "python_cve",
        "rust_lint",
        "go_lint",
        "java_p3c",
        "java_javadoc",
        "java_dependencies",
        "java_cve",
        "npm_cve",
        "rust_comments",
        "rust_build",
        "rust_cve",
        "node_lint",
        "erlang_lint",
        "kotlin_lint",
        "swift_lint",
        "zig_lint",
        "ruby_lint",
        "shell_lint"
      ],
      "properties": {
        "python_cve": {
          "$ref": "check-feedback-v0.46.schema.json#/properties/native_results/properties/python_cve"
        },
        "go_lint": {
          "$ref": "check-feedback-v0.46.schema.json#/properties/native_results/properties/go_lint"
        },
        "rust_lint": {
          "$ref": "check-feedback-v0.46.schema.json#/properties/native_results/properties/rust_lint"
        },
        "java_p3c": {
          "$ref": "check-feedback-v0.46.schema.json#/properties/native_results/properties/java_p3c"
        },
        "java_dependencies": {
          "$ref": "check-feedback-v0.46.schema.json#/properties/native_results/properties/java_dependencies"
        },
        "java_cve": {
          "$ref": "check-feedback-v0.46.schema.json#/properties/native_results/properties/java_cve"
        },
        "java_javadoc": {
          "anyOf": [
            {
              "$ref": "check-feedback-v0.46.schema.json#/properties/native_results/properties/java_javadoc"
            },
            {
              "$ref": "java-javadoc-project-probe-v0.4.schema.json"
            }
          ]
        },
        "python_lint": {
          "$ref": "check-feedback-v0.46.schema.json#/properties/native_results/properties/python_lint"
        },
        "npm_cve": {
          "$ref": "check-feedback-v0.46.schema.json#/properties/native_results/properties/npm_cve"
        },
        "rust_comments": {
          "$ref": "check-feedback-v0.46.schema.json#/properties/native_results/properties/rust_comments"
        },
        "rust_build": {
          "$ref": "check-feedback-v0.46.schema.json#/properties/native_results/properties/rust_build"
        },
        "rust_cve": {
          "$ref": "check-feedback-v0.46.schema.json#/properties/native_results/properties/rust_cve"
        },
        "node_lint": {
          "$ref": "check-feedback-v0.46.schema.json#/properties/native_results/properties/node_lint"
        },
        "erlang_lint": {
          "$ref": "check-feedback-v0.46.schema.json#/properties/native_results/properties/erlang_lint"
        },
        "kotlin_lint": {
          "$ref": "check-feedback-v0.46.schema.json#/properties/native_results/properties/kotlin_lint"
        },
        "swift_lint": {
          "$ref": "check-feedback-v0.46.schema.json#/properties/native_results/properties/swift_lint"
        },
        "zig_lint": {
          "anyOf": [
            {
              "$ref": "zig-ast-scan-v0.2.schema.json"
            },
            {
              "type": "null"
            }
          ]
        },
        "ruby_lint": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "ruby-syntax-scan-v0.1.schema.json"
            },
            {
              "$ref": "ruby-syntax-scan-v0.2.schema.json"
            }
          ]
        },
        "shell_lint": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "shell-native-scan-v0.1.schema.json"
            }
          ]
        },
        "java_gradle_javadoc": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "gradle-javadoc-probe-v0.2.schema.json"
            }
          ]
        }
      }
    },
    "export": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason_code"
      ],
      "properties": {
        "status": {
          "enum": [
            "not_requested",
            "saved",
            "failed"
          ]
        },
        "reason_code": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "failed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "reason_code": {
                "enum": [
                  "output_parent_unavailable",
                  "output_not_regular_file",
                  "output_existing_file_is_not_codeguard_report",
                  "output_identity_unavailable",
                  "output_temp_create_failed",
                  "output_temp_write_failed",
                  "output_replace_failed",
                  "output_existing_read_failed",
                  "output_existing_too_large"
                ]
              }
            }
          },
          "else": {
            "properties": {
              "reason_code": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "selection": {
            "const": "all"
          }
        },
        "required": [
          "selection"
        ]
      },
      "then": {
        "properties": {
          "delivery_decision": {
            "const": "incomplete"
          }
        }
      },
      "else": {
        "properties": {
          "delivery_decision": {
            "const": "not_evaluated"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command_status": {
            "const": "cancelled"
          }
        },
        "required": [
          "command_status"
        ]
      },
      "then": {
        "properties": {
          "exit_code": {
            "const": 130
          },
          "reason": {
            "const": "request_cancelled"
          }
        }
      },
      "else": {
        "properties": {
          "exit_code": {
            "const": 4
          },
          "reason": {
            "const": "native_task_internal_failure"
          }
        }
      }
    }
  ],
  "$defs": {
    "rust_comments": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Unverified selected Cargo rustdoc library observation",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "report_type",
        "operation",
        "language",
        "command_status",
        "exit_code",
        "delivery_decision",
        "authority",
        "checker_id",
        "scope",
        "rule_selection",
        "local_scan_complete",
        "coverage_proven",
        "reason",
        "tool_sha256",
        "manifest_sha256",
        "lock_sha256",
        "findings",
        "backlog_status",
        "execution_budget",
        "next_actions",
        "recheck_argv",
        "workspace_binding",
        "workspace_id",
        "run_id",
        "backlog_sync"
      ],
      "properties": {
        "schema_version": {
          "const": "0.4.0"
        },
        "report_type": {
          "const": "rustdoc_local_observation"
        },
        "operation": {
          "const": "comments"
        },
        "language": {
          "const": "rust"
        },
        "command_status": {
          "enum": [
            "incomplete",
            "cancelled"
          ]
        },
        "exit_code": {
          "enum": [
            3,
            130
          ]
        },
        "delivery_decision": {
          "const": "not_evaluated"
        },
        "authority": {
          "const": "local_unverified"
        },
        "checker_id": {
          "const": "rust.cargo_rustdoc"
        },
        "scope": {
          "const": "selected_root_library_default_features"
        },
        "rule_selection": {
          "const": "explicit_probe_not_approved_project_policy"
        },
        "local_scan_complete": {
          "type": "boolean"
        },
        "coverage_proven": {
          "const": false
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "tool_sha256": {
          "$ref": "#/$defs/rust_comments/$defs/hash"
        },
        "manifest_sha256": {
          "$ref": "#/$defs/rust_comments/$defs/hash"
        },
        "lock_sha256": {
          "$ref": "#/$defs/rust_comments/$defs/hash"
        },
        "backlog_status": {
          "enum": [
            "not_integrated",
            "queued",
            "synced",
            "sync_incomplete",
            "failed"
          ]
        },
        "execution_budget": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "timeout_ms",
            "source",
            "enforcement"
          ],
          "properties": {
            "timeout_ms": {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400000
            },
            "source": {
              "enum": [
                "cli",
                "registered_environment",
                "project_default",
                "builtin_default"
              ]
            },
            "enforcement": {
              "const": "native_execution_only"
            }
          }
        },
        "next_actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "recheck_argv": {
          "const": [
            "cargo",
            "rustdoc",
            "--lib",
            "--locked",
            "--offline",
            "--message-format=json",
            "--",
            "--warn",
            "missing_docs",
            "--warn",
            "rustdoc::broken_intra_doc_links"
          ]
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "finding_id",
              "finding_fingerprint",
              "source_sha256",
              "rule_id",
              "level",
              "path",
              "line",
              "column",
              "classification",
              "byte_start",
              "byte_end",
              "native_range_sha256",
              "identity_status",
              "repair_brief",
              "target_path"
            ],
            "properties": {
              "finding_id": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^CG-[0-9a-f]{32}$"
              },
              "finding_fingerprint": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "source_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "rule_id": {
                "enum": [
                  "missing_docs",
                  "rustdoc::broken_intra_doc_links"
                ]
              },
              "level": {
                "enum": [
                  "warning",
                  "error"
                ]
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "line": {
                "type": "integer",
                "minimum": 1
              },
              "column": {
                "type": "integer",
                "minimum": 1
              },
              "classification": {
                "const": "observed_unverified"
              },
              "byte_start": {
                "type": "integer",
                "minimum": 0
              },
              "byte_end": {
                "type": "integer",
                "minimum": 0
              },
              "native_range_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "identity_status": {
                "enum": [
                  "unique_candidate",
                  "ambiguous"
                ]
              },
              "repair_brief": {
                "$ref": "#/$defs/rust_comments/$defs/repair_brief"
              },
              "target_path": {
                "type": "string",
                "minLength": 1
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "identity_status": {
                      "const": "ambiguous"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "finding_id": {
                      "type": "null"
                    },
                    "repair_brief": {
                      "properties": {
                        "status": {
                          "const": "investigation_required"
                        }
                      }
                    }
                  }
                },
                "else": {
                  "properties": {
                    "finding_id": {
                      "type": "string"
                    }
                  }
                }
              }
            ]
          }
        },
        "workspace_binding": {
          "enum": [
            "bound",
            "uninitialized",
            "invalid",
            "legacy_unbound"
          ]
        },
        "workspace_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "run_id": {
          "type": "string",
          "pattern": "^rustdoc-[0-9]+-[0-9]+$"
        },
        "backlog_sync": {
          "type": [
            "object",
            "null"
          ]
        }
      },
      "$defs": {
        "hash": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "repair_brief": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "evidence",
            "rule_basis",
            "allowed_paths",
            "steps",
            "recheck_argv",
            "working_directory",
            "tool_requirement",
            "attempt_history",
            "history_status",
            "closure_conditions"
          ],
          "properties": {
            "status": {
              "enum": [
                "repair_guidance",
                "investigation_required"
              ]
            },
            "evidence": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "finding_id",
                "finding_fingerprint",
                "path",
                "source_sha256",
                "byte_start",
                "byte_end",
                "rule_id",
                "observation_reason"
              ],
              "properties": {
                "finding_id": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^CG-[0-9a-f]{32}$"
                },
                "finding_fingerprint": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "source_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "byte_start": {
                  "type": "integer",
                  "minimum": 0
                },
                "byte_end": {
                  "type": "integer",
                  "minimum": 0
                },
                "rule_id": {
                  "enum": [
                    "missing_docs",
                    "rustdoc::broken_intra_doc_links"
                  ]
                },
                "observation_reason": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "rule_basis": {
              "type": "string",
              "minLength": 1
            },
            "allowed_paths": {
              "type": "array",
              "maxItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "steps": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "recheck_argv": {
              "const": [
                "cargo",
                "rustdoc",
                "--lib",
                "--locked",
                "--offline",
                "--message-format=json",
                "--",
                "--warn",
                "missing_docs",
                "--warn",
                "rustdoc::broken_intra_doc_links"
              ]
            },
            "working_directory": {
              "const": "selected_project_root"
            },
            "tool_requirement": {
              "type": "string",
              "minLength": 1
            },
            "attempt_history": {
              "const": []
            },
            "history_status": {
              "const": "not_integrated"
            },
            "closure_conditions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "investigation_required"
                  }
                }
              },
              "then": {
                "properties": {
                  "allowed_paths": {
                    "maxItems": 0
                  }
                }
              },
              "else": {
                "properties": {
                  "allowed_paths": {
                    "minItems": 1
                  }
                }
              }
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "command_status": {
                "const": "cancelled"
              }
            }
          },
          "then": {
            "properties": {
              "exit_code": {
                "const": 130
              },
              "reason": {
                "const": "request_cancelled"
              },
              "local_scan_complete": {
                "const": false
              }
            }
          },
          "else": {
            "properties": {
              "exit_code": {
                "const": 3
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "local_scan_complete": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "const": "native_observed_unverified"
              },
              "tool_sha256": {
                "type": "string"
              },
              "manifest_sha256": {
                "type": "string"
              },
              "lock_sha256": {
                "type": "string"
              },
              "findings": {
                "items": {
                  "properties": {
                    "identity_status": {
                      "const": "unique_candidate"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "local_scan_complete": {
                "const": false
              }
            }
          },
          "then": {
            "properties": {
              "findings": {
                "items": {
                  "properties": {
                    "repair_brief": {
                      "properties": {
                        "status": {
                          "const": "investigation_required"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "workspace_binding": {
                "const": "bound"
              }
            }
          },
          "then": {
            "properties": {
              "workspace_id": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "else": {
            "properties": {
              "workspace_id": {
                "type": "null"
              },
              "backlog_status": {
                "const": "not_integrated"
              },
              "backlog_sync": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "erlangFormsScan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "report_type",
        "tool_selection",
        "scope",
        "authority",
        "coverage_proven",
        "delivery_decision",
        "local_forms_complete",
        "reason",
        "source_file_count",
        "unobserved_count",
        "files",
        "task_status",
        "task_id",
        "scope_stable"
      ],
      "properties": {
        "schema_version": {
          "const": "0.1.0"
        },
        "report_type": {
          "const": "erlang_forms_scan"
        },
        "tool_selection": {
          "$ref": "#/$defs/erlangFormsScan/$defs/tool_selection"
        },
        "scope": {
          "const": "single_file_forms_without_preprocessing"
        },
        "authority": {
          "const": "local_unverified"
        },
        "coverage_proven": {
          "const": false
        },
        "delivery_decision": {
          "const": "not_evaluated"
        },
        "local_forms_complete": {
          "type": "boolean"
        },
        "reason": {
          "enum": [
            "erlang_native_scan_incomplete",
            "erlang_forms_observed_unverified_project_coverage"
          ]
        },
        "source_file_count": {
          "type": "integer",
          "minimum": 0
        },
        "unobserved_count": {
          "type": "integer",
          "minimum": 0
        },
        "files": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "source_sha256",
              "current",
              "native",
              "findings",
              "recheck_argv",
              "next_action"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "source_sha256": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/$defs/erlangFormsScan/$defs/digest"
                  }
                ]
              },
              "current": {
                "type": "boolean"
              },
              "native": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "status",
                  "reason",
                  "version",
                  "tool_sha256",
                  "diagnostics",
                  "diagnostics_truncated",
                  "preprocessing_unresolved"
                ],
                "properties": {
                  "status": {
                    "enum": [
                      "not_run",
                      "incomplete",
                      "completed",
                      "diagnostics_observed"
                    ]
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  },
                  "version": {
                    "enum": [
                      null,
                      "OTP 28"
                    ]
                  },
                  "tool_sha256": {
                    "anyOf": [
                      {
                        "type": "null"
                      },
                      {
                        "$ref": "#/$defs/erlangFormsScan/$defs/digest"
                      }
                    ]
                  },
                  "diagnostics": {
                    "type": "array",
                    "maxItems": 32,
                    "items": {
                      "$ref": "#/$defs/erlangFormsScan/$defs/diagnostic"
                    }
                  },
                  "diagnostics_truncated": {
                    "type": "boolean"
                  },
                  "preprocessing_unresolved": {
                    "type": "boolean"
                  }
                },
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "status": {
                          "enum": [
                            "completed",
                            "diagnostics_observed"
                          ]
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "version": {
                          "const": "OTP 28"
                        },
                        "tool_sha256": {
                          "$ref": "#/$defs/erlangFormsScan/$defs/digest"
                        },
                        "diagnostics_truncated": {
                          "const": false
                        },
                        "preprocessing_unresolved": {
                          "const": false
                        }
                      }
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "status": {
                          "const": "completed"
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "diagnostics": {
                          "maxItems": 0
                        }
                      }
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "status": {
                          "const": "diagnostics_observed"
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "diagnostics": {
                          "minItems": 1
                        }
                      }
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "status": {
                          "const": "completed"
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "reason": {
                          "const": "erlang_native_forms_no_diagnostics"
                        }
                      }
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "status": {
                          "const": "diagnostics_observed"
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "reason": {
                          "const": "erlang_native_syntax_diagnostics"
                        }
                      }
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "status": {
                          "const": "not_run"
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "version": {
                          "type": "null"
                        },
                        "tool_sha256": {
                          "type": "null"
                        },
                        "diagnostics": {
                          "maxItems": 0
                        },
                        "diagnostics_truncated": {
                          "const": false
                        },
                        "preprocessing_unresolved": {
                          "const": false
                        }
                      }
                    }
                  }
                ]
              },
              "findings": {
                "type": "array",
                "maxItems": 32,
                "items": {
                  "$ref": "#/$defs/erlangFormsScan/$defs/diagnostic"
                }
              },
              "recheck_argv": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "array",
                    "minItems": 7,
                    "maxItems": 7,
                    "prefixItems": [
                      {
                        "const": "codeguard"
                      },
                      {
                        "const": "lint"
                      },
                      {
                        "const": "erlang"
                      },
                      {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "^/"
                      },
                      {
                        "const": "--erl-tool"
                      },
                      {
                        "type": "string",
                        "pattern": "^/"
                      },
                      {
                        "const": "--format=json"
                      }
                    ],
                    "items": false
                  }
                ]
              },
              "next_action": {
                "type": "string",
                "minLength": 1
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "current": {
                      "const": false
                    }
                  }
                },
                "then": {
                  "properties": {
                    "native": {
                      "properties": {
                        "status": {
                          "enum": [
                            "incomplete",
                            "not_run"
                          ]
                        },
                        "diagnostics": {
                          "maxItems": 0
                        }
                      }
                    },
                    "findings": {
                      "maxItems": 0
                    },
                    "recheck_argv": {
                      "type": "null"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "native": {
                      "properties": {
                        "status": {
                          "enum": [
                            "completed",
                            "diagnostics_observed"
                          ]
                        }
                      }
                    }
                  }
                },
                "then": {
                  "properties": {
                    "current": {
                      "const": true
                    },
                    "source_sha256": {
                      "$ref": "#/$defs/erlangFormsScan/$defs/digest"
                    },
                    "recheck_argv": {
                      "type": "array"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "native": {
                      "properties": {
                        "status": {
                          "const": "completed"
                        }
                      }
                    }
                  }
                },
                "then": {
                  "properties": {
                    "findings": {
                      "maxItems": 0
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "native": {
                      "properties": {
                        "status": {
                          "const": "diagnostics_observed"
                        }
                      }
                    }
                  }
                },
                "then": {
                  "properties": {
                    "findings": {
                      "minItems": 1
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "native": {
                      "properties": {
                        "preprocessing_unresolved": {
                          "const": true
                        }
                      }
                    }
                  }
                },
                "then": {
                  "properties": {
                    "findings": {
                      "maxItems": 0
                    },
                    "recheck_argv": {
                      "type": "null"
                    }
                  }
                }
              }
            ]
          }
        },
        "task_status": {
          "const": "native_findings_not_integrated"
        },
        "task_id": {
          "type": "null"
        },
        "scope_stable": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "local_forms_complete": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "const": "erlang_forms_observed_unverified_project_coverage"
              },
              "unobserved_count": {
                "const": 0
              },
              "files": {
                "minItems": 1,
                "items": {
                  "properties": {
                    "current": {
                      "const": true
                    },
                    "native": {
                      "properties": {
                        "status": {
                          "enum": [
                            "completed",
                            "diagnostics_observed"
                          ]
                        }
                      }
                    }
                  }
                }
              },
              "scope_stable": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "local_forms_complete": {
                "const": false
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "const": "erlang_native_scan_incomplete"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "tool_selection": {
                "properties": {
                  "source": {
                    "const": "not_found"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "local_forms_complete": {
                "const": false
              },
              "files": {
                "items": {
                  "properties": {
                    "native": {
                      "properties": {
                        "status": {
                          "enum": [
                            "not_run",
                            "incomplete"
                          ]
                        },
                        "version": {
                          "type": "null"
                        },
                        "tool_sha256": {
                          "type": "null"
                        },
                        "diagnostics": {
                          "maxItems": 0
                        }
                      }
                    },
                    "findings": {
                      "maxItems": 0
                    },
                    "recheck_argv": {
                      "type": "null"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "files": {
                "contains": {
                  "properties": {
                    "native": {
                      "properties": {
                        "status": {
                          "enum": [
                            "completed",
                            "diagnostics_observed"
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "tool_selection": {
                "properties": {
                  "source": {
                    "enum": [
                      "explicit",
                      "path"
                    ]
                  },
                  "executable": {
                    "type": "string",
                    "pattern": "^/"
                  }
                }
              }
            }
          }
        }
      ],
      "$defs": {
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "diagnostic": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "line",
            "column",
            "rule_id"
          ],
          "properties": {
            "line": {
              "type": "integer",
              "minimum": 1
            },
            "column": {
              "type": "integer",
              "minimum": 1
            },
            "rule_id": {
              "const": "erlang.syntax.error"
            }
          }
        },
        "tool_selection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "executable"
          ],
          "properties": {
            "source": {
              "enum": [
                "explicit",
                "path",
                "not_found"
              ]
            },
            "executable": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "pattern": "^/"
                }
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "source": {
                    "const": "path"
                  }
                }
              },
              "then": {
                "properties": {
                  "executable": {
                    "type": "string",
                    "pattern": "^/"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "source": {
                    "const": "not_found"
                  }
                }
              },
              "then": {
                "properties": {
                  "executable": {
                    "type": "null"
                  }
                }
              }
            }
          ]
        }
      }
    }
  }
}
