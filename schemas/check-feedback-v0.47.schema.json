{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_type",
    "operation",
    "selection",
    "command_status",
    "exit_code",
    "delivery_decision",
    "authority",
    "reason",
    "discovery",
    "native_results",
    "execution_tasks",
    "obligation_status",
    "required_obligations",
    "category_candidates",
    "syntax_candidates",
    "unresolved_conditions",
    "execution_budget",
    "next",
    "export",
    "syntax_tasks"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "selection": {
            "const": "all"
          }
        },
        "required": [
          "selection"
        ]
      },
      "then": {
        "properties": {
          "delivery_decision": {
            "const": "incomplete"
          }
        }
      },
      "else": {
        "properties": {
          "delivery_decision": {
            "const": "not_evaluated"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command_status": {
            "const": "cancelled"
          }
        }
      },
      "then": {
        "properties": {
          "exit_code": {
            "const": 130
          },
          "reason": {
            "const": "request_cancelled"
          }
        }
      },
      "else": {
        "properties": {
          "exit_code": {
            "const": 3
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "selection": {
                  "const": "all"
                }
              }
            },
            "then": {
              "properties": {
                "reason": {
                  "const": "full_project_obligations_and_trusted_policy_unavailable"
                }
              }
            },
            "else": {
              "properties": {
                "reason": {
                  "enum": [
                    "java_selection_obligations_and_trusted_policy_unavailable",
                    "language_selection_obligations_and_trusted_policy_unavailable"
                  ]
                }
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "selection": {
            "const": "zig"
          }
        }
      },
      "then": {
        "properties": {
          "native_results": {
            "properties": {
              "python_cve": {
                "type": "array",
                "maxItems": 0
              },
              "go_lint": {
                "type": "null"
              },
              "rust_lint": {
                "type": "null"
              },
              "java_p3c": {
                "type": "null"
              },
              "java_dependencies": {
                "type": "null"
              },
              "java_cve": {
                "type": "null"
              },
              "java_javadoc": {
                "type": "null"
              },
              "python_lint": {
                "type": "null"
              },
              "npm_cve": {
                "type": "array",
                "maxItems": 0
              },
              "rust_comments": {
                "type": "null"
              },
              "rust_build": {
                "type": "null"
              },
              "rust_cve": {
                "type": "null"
              },
              "node_lint": {
                "type": "null"
              },
              "erlang_lint": {
                "type": "null"
              },
              "kotlin_lint": {
                "type": "null"
              },
              "swift_lint": {
                "type": "null"
              }
            }
          },
          "category_candidates": {
            "items": {
              "properties": {
                "language": {
                  "const": "zig"
                }
              }
            }
          }
        }
      }
    }
  ],
  "$id": "urn:codeguard:schema:check-feedback:0.47.0",
  "properties": {
