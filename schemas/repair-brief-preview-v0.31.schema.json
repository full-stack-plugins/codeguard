{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codeguard:schema:repair-brief-preview:0.31.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_type",
    "operation",
    "command_status",
    "exit_code",
    "disposition",
    "reason",
    "repair_brief",
    "next_actions",
    "authority",
    "delivery_decision"
  ],
  "properties": {
    "schema_version": {
      "const": "0.31.0"
    },
    "report_type": {
      "const": "repair_brief_preview"
    },
    "operation": {
      "const": "next"
    },
    "command_status": {
      "enum": [
        "complete",
        "incomplete"
      ]
    },
    "exit_code": {
      "enum": [
        0,
        3
      ]
    },
    "disposition": {
      "enum": [
        "actionable",
        "waiting",
        "needs_decision",
        "verification_required",
        "no_applicable_work"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "repair_brief": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "task_id",
        "kind",
        "checker_id",
        "scope",
        "source_sha256",
        "structural_rule_id",
        "rule_source",
        "evidence_ref",
        "current_run_id",
        "observation_status",
        "structural_positions",
        "rule_basis",
        "constraints",
        "allowed_paths",
        "affected_paths",
        "disposition",
        "reason_code",
        "step",
        "recheck_argv",
        "history",
        "closure_condition",
        "authority",
        "delivery_decision"
      ],
      "properties": {
        "schema_version": {
          "const": "0.31.0"
        },
        "task_id": {
          "type": "string",
          "pattern": "^CG-[a-f0-9]{32}$"
        },
        "kind": {
          "const": "finding"
        },
        "checker_id": {
          "enum": [
            "c.clang.documentation_structure",
            "cpp.clang.documentation_structure"
          ]
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "structural_rule_id": {
          "const": "codeguard.documentation.function_structure_required"
        },
        "rule_source": {
          "const": "codeguard_structural_policy"
        },
        "evidence_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "first_run_id",
            "first_report_sha256"
          ],
          "properties": {
            "first_run_id": {
              "type": "string",
              "pattern": "^clangdocstruct-[0-9]+-[0-9]+-[0-9]+$"
            },
            "first_report_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "current_run_id": {
          "type": "string",
          "pattern": "^clangdocstruct-[0-9]+-[0-9]+-[0-9]+$"
        },
        "observation_status": {
          "enum": [
            "original_context_changed",
            "input_changed",
            "native_structure_incomplete",
            "candidate_absent_unverified_policy",
            "structural_deficits_observed"
          ]
        },
        "structural_positions": {
          "type": "array",
          "maxItems": 2000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "offset_byte",
              "line",
              "column_byte",
              "comment_presence",
              "purpose_description",
              "parameters",
              "return_description",
              "missing_components",
              "structure_status"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "offset_byte": {
                "type": "integer",
                "minimum": 0
              },
              "line": {
                "type": "integer",
                "minimum": 1
              },
              "column_byte": {
                "type": "integer",
                "minimum": 1
              },
              "comment_presence": {
                "enum": [
                  "present",
                  "absent",
                  "unknown_redeclaration"
                ]
              },
              "purpose_description": {
                "enum": [
                  "unknown",
                  "missing",
                  "nonempty"
                ]
              },
              "parameters": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "index",
                    "name",
                    "description"
                  ],
                  "properties": {
                    "index": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "name": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "description": {
                      "enum": [
                        "nonempty",
                        "missing",
                        "unknown_unnamed"
                      ]
                    }
                  }
                }
              },
              "return_description": {
                "enum": [
                  "unknown",
                  "missing",
                  "nonempty",
                  "not_applicable"
                ]
              },
              "missing_components": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^(documentation_comment|purpose|return|parameter:.+)$"
                }
              },
              "structure_status": {
                "enum": [
                  "observed_supported_subset",
                  "unknown_redeclaration",
                  "unresolved_comment_structure"
                ]
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "comment_presence": {
                      "const": "absent"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "missing_components": {
                      "const": [
                        "documentation_comment"
                      ]
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "structure_status": {
                      "enum": [
                        "unknown_redeclaration",
                        "unresolved_comment_structure"
                      ]
                    }
                  }
                },
                "then": {
                  "properties": {
                    "missing_components": {
                      "const": []
                    },
                    "purpose_description": {
                      "const": "unknown"
                    },
                    "return_description": {
                      "const": "unknown"
                    },
                    "parameters": {
                      "const": []
                    }
                  }
                }
              }
            ]
          }
        },
        "rule_basis": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "constraints": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "allowed_paths": {
          "type": "array",
          "maxItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "affected_paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "disposition": {
          "enum": [
            "actionable",
            "needs_decision"
          ]
        },
        "reason_code": {
          "enum": [
            "original_context_changed",
            "input_changed",
            "native_structure_incomplete",
            "candidate_absent_unverified_policy",
            "structural_deficits_observed"
          ]
        },
        "step": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "recheck_argv": {
          "type": "array",
          "minItems": 11,
          "maxItems": 11,
          "prefixItems": [
            {
              "const": "codeguard"
            },
            {
              "const": "comments"
            },
            {
              "enum": [
                "c",
                "cpp"
              ]
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            {
              "const": "--clang-tool"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            {
              "const": "--standard"
            },
            {
              "enum": [
                "c11",
                "c++17"
              ]
            },
            {
              "const": "--workspace"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            {
              "const": "--format=json"
            }
          ],
          "items": false
        },
        "history": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "task_verify",
            "attempt_journal"
          ],
          "properties": {
            "status": {
              "const": "native_structural_observations_only"
            },
            "task_verify": {
              "const": "not_integrated"
            },
            "attempt_journal": {
              "const": "not_integrated"
            }
          }
        },
        "closure_condition": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "authority": {
          "const": "local_unverified"
        },
        "delivery_decision": {
          "const": "not_evaluated"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "observation_status": {
                "const": "structural_deficits_observed"
              }
            }
          },
          "then": {
            "properties": {
              "disposition": {
                "const": "actionable"
              },
              "allowed_paths": {
                "minItems": 1
              },
              "structural_positions": {
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "disposition": {
                "const": "needs_decision"
              },
              "allowed_paths": {
                "const": []
              },
              "structural_positions": {
                "const": []
              }
            }
          }
        }
      ]
    },
    "next_actions": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "failed_reports": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "run_id",
          "reason",
          "report_ref"
        ],
        "properties": {
          "run_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,120}$"
          },
          "reason": {
            "type": "string",
            "pattern": "^[a-z0-9_]{1,80}$"
          },
          "report_ref": {
            "type": "string",
            "pattern": "^\\.codeguard/reports/[A-Za-z0-9_-]{1,120}\\.json$"
          }
        }
      }
    },
    "authority": {
      "const": "local_unverified"
    },
    "delivery_decision": {
      "const": "not_evaluated"
    }
  }
}
