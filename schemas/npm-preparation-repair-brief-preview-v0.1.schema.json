          "const": "0.1.0"
        },
        "task_id": {
          "type": "string",
          "pattern": "^CG-B-[0-9a-f]{32}$"
        },
        "kind": {
          "const": "blocker"
        },
        "checker_id": {
          "const": "python.pip_audit"
        },
        "evidence_ref": {
