            {
              "const": "--pip-audit-version"
            },
            {
              "const": "<本轮已核验版本>"
            },
            {
              "const": "--format"
            },
            {
              "const": "json"
            }
          ],
          "items": false,
          "minItems": 11
        },
        "history": {
          "$ref": "#/$defs/brief/properties/history"
        },
        "action_id": {
          "const": "restore-checker-environment"
        },
        "authority": {
          "const": "local_unverified"
        },
        "closure_condition": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "build_root": {
          "type": "string",
          "minLength": 1
        },
        "affected_paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reason_code": {
          "const": "python_cve_coverage_unverified"
        },
        "constraints": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "step": {
          "type": "string",
          "minLength": 1
        },
        "disposition": {
          "enum": [
            "actionable",
            "needs_decision",
            "verification_required",
            "waiting"
          ]
        },
        "verification_observation": {
          "enum": [
            "still_blocked",
