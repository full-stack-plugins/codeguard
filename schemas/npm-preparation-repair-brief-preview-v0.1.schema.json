{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codeguard:schema:npm-preparation-repair-brief-preview:0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_type",
    "operation",
    "command_status",
    "exit_code",
    "disposition",
    "reason",
    "repair_brief",
    "next_actions",
    "authority",
    "delivery_decision"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "0.1.0",
        "0.2.0",
        "0.3.0"
      ]
    },
    "report_type": {
      "const": "repair_brief_preview"
    },
    "operation": {
      "const": "next"
    },
    "command_status": {
      "enum": [
        "complete",
        "incomplete"
      ]
    },
    "exit_code": {
      "enum": [
        0,
        3
      ]
    },
    "disposition": {
      "enum": [
        "actionable",
        "waiting",
        "needs_decision",
        "verification_required",
        "no_applicable_work"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "repair_brief": {
      "$ref": "#/$defs/npm_preparation_brief"
    },
    "next_actions": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "failed_reports": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "run_id",
          "reason",
          "report_ref"
        ],
        "properties": {
          "run_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,120}$"
          },
          "reason": {
            "type": "string",
            "pattern": "^[a-z0-9_]{1,80}$"
          },
          "report_ref": {
            "type": "string",
            "pattern": "^\\.codeguard/reports/[A-Za-z0-9_-]{1,120}\\.json$"
          }
        }
      }
    },
    "authority": {
      "const": "local_unverified"
    },
    "delivery_decision": {
      "const": "not_evaluated"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "first_run_id",
        "first_report_sha256"
      ],
      "properties": {
        "first_run_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,120}$"
        },
        "first_report_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "rust_cve_brief": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "task_id",
        "kind",
        "checker_id",
        "evidence_ref",
        "recheck_argv",
        "history",
        "action_id",
        "authority",
        "closure_condition",
        "scope",
        "build_root",
        "affected_paths",
        "reason_code",
        "constraints",
        "step",
        "disposition"
      ],
      "properties": {
        "schema_version": {
          "const": "0.1.0"
        },
        "task_id": {
          "type": "string",
          "pattern": "^CG-B-[0-9a-f]{32}$"
        },
        "kind": {
          "const": "blocker"
        },
        "checker_id": {
          "const": "rust.cargo_audit"
        },
        "evidence_ref": {
          "$ref": "#/$defs/evidence"
        },
        "recheck_argv": {
          "type": "array",
          "prefixItems": [
            {
              "const": "codeguard"
            },
            {
              "const": "task"
            },
            {
              "const": "verify"
            },
            {
              "type": "string",
              "pattern": "^CG-B-[0-9a-f]{32}$"
            },
            {
              "const": "."
            },
            {
              "const": "--cargo-audit-tool"
            },
            {
              "const": "<本轮已核验绝对路径>"
            },
            {
              "const": "--rustsec-db"
            },
            {
              "const": "<已核验离线数据库绝对目录>"
            },
            {
              "const": "--format"
            },
            {
              "const": "json"
            }
          ],
          "items": false,
          "minItems": 11
        },
        "history": {
          "$ref": "#/$defs/brief/properties/history"
        },
        "action_id": {
          "const": "restore-checker-environment"
        },
        "authority": {
          "const": "local_unverified"
        },
        "closure_condition": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "const": "."
        },
        "build_root": {
          "const": "."
        },
        "affected_paths": {
          "const": [
            "Cargo.toml",
            "Cargo.lock"
          ]
        },
        "reason_code": {
          "const": "rust_cve_coverage_unverified"
        },
        "constraints": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "step": {
          "type": "string",
          "minLength": 1
        },
        "disposition": {
          "enum": [
            "actionable",
            "needs_decision",
            "verification_required",
            "waiting"
          ]
        },
        "verification_observation": {
          "enum": [
            "still_blocked",
            "incomplete"
          ]
        },
        "verification_run_id": {
          "type": "string",
          "pattern": "^rust-cve-[0-9]+-[0-9]+-[0-9]+$"
        },
        "verification_report_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
