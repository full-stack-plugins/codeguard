          ]
        },
        "verification_run_id": {
          "type": "string",
          "pattern": "^python-cve-[0-9]+-[0-9]+-[0-9]+$"
        },
        "verification_report_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
