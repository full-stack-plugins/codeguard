{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codeguard:schema:java-checkstyle-local-feedback:0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","report_type","language","operation","category","command_status","exit_code","local_status","reason","path","findings","authority","checker_identity","coverage_proven","delivery_decision","next_actions"],
  "properties": {
    "schema_version": {"const":"0.1.0"},
    "report_type": {"const":"java_checkstyle_local_feedback"},
    "language": {"const":"java"},
    "operation": {"const":"lint"},
    "category": {"const":"comments"},
    "command_status": {"enum":["incomplete","cancelled"]},
    "exit_code": {"enum":[3,130]},
    "local_status": {"enum":["incomplete","observed"]},
    "reason": {"type":"string","minLength":1},
    "path": {"type":"string","minLength":1},
    "authority": {"const":"local_unverified"},
    "checker_identity": {"const":"unverified"},
    "coverage_proven": {"const":false},
    "delivery_decision": {"const":"not_evaluated"},
    "next_actions": {"type":"array","items":{"type":"string"}},
    "findings": {
      "type":"array",
      "items": {
        "type":"object","additionalProperties":false,
        "required":["path","line","column","rule_id","severity"],
        "properties": {
          "path":{"type":"string","minLength":1},
          "line":{"type":"integer","minimum":0,"maximum":4294967295},
          "column":{"anyOf":[{"type":"null"},{"type":"integer","minimum":1,"maximum":4294967295}]},
          "rule_id":{"type":"string","minLength":1},
          "severity":{"enum":["error","warning","info"]}
        }
      }
    }
  },
  "allOf": [
    {"if":{"properties":{"command_status":{"const":"cancelled"}}},"then":{"properties":{"exit_code":{"const":130},"reason":{"const":"request_cancelled"},"local_status":{"const":"incomplete"},"findings":{"maxItems":0}}},"else":{"properties":{"exit_code":{"const":3}}}},
    {"if":{"properties":{"local_status":{"const":"incomplete"}}},"then":{"properties":{"findings":{"maxItems":0}}}}
  ]
}
