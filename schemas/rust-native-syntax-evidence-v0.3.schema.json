{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codeguard:schema:rust-native-syntax-evidence:0.3.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "reason",
    "version",
    "tool_sha256",
    "edition",
    "observation_kind",
    "diagnostics",
    "edition_context"
  ],
  "properties": {
    "status": {
      "enum": [
        "incomplete",
        "completed",
        "diagnostics_observed"
      ]
    },
    "reason": {
      "type": "string",
      "pattern": "^[a-z_]{1,128}$"
    },
    "version": {
      "enum": [
        null,
        "rustfmt 1.9.0-stable"
      ]
    },
    "tool_sha256": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      ]
    },
    "edition": {
      "enum": [
        null,
        "2015",
        "2018",
        "2021",
        "2024"
      ]
    },
    "observation_kind": {
      "const": "formatter_parser"
    },
    "diagnostics": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "line",
          "rule_id"
        ],
        "properties": {
          "line": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4294967295
          },
          "rule_id": {
            "const": "rust.syntax"
          }
        }
      }
    },
    "edition_context": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "edition",
            "manifest_ref",
            "manifest_sha256",
            "workspace_manifest_ref",
            "workspace_manifest_sha256"
          ],
          "properties": {
            "edition": {
              "enum": [
                "2015",
                "2018",
                "2021",
                "2024"
              ]
            },
            "manifest_ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\r\\n]+$"
            },
            "manifest_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "workspace_manifest_ref": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096,
                  "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\r\\n]+$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "workspace_manifest_sha256": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "incomplete"
          }
        }
      },
      "then": {
        "properties": {
          "diagnostics": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "version": {
            "const": "rustfmt 1.9.0-stable"
          },
          "tool_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "completed"
          }
        }
      },
      "then": {
        "properties": {
          "reason": {
            "const": "rustfmt_native_parse_no_diagnostics"
          },
          "diagnostics": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "diagnostics_observed"
          }
        }
      },
      "then": {
        "properties": {
          "reason": {
            "const": "rustfmt_native_parse_diagnostics"
          },
          "diagnostics": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "incomplete"
          }
        }
      },
      "then": {
        "properties": {
          "diagnostics": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "edition_context": {
            "type": "object"
          },
          "edition": {
            "enum": [
              "2015",
              "2018",
              "2021",
              "2024"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "edition": {
            "const": "2015"
          },
          "edition_context": {
            "type": "object"
          }
        }
      },
      "then": {
        "properties": {
          "edition_context": {
            "properties": {
              "edition": {
                "const": "2015"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "edition": {
            "const": "2018"
          },
          "edition_context": {
            "type": "object"
          }
        }
      },
      "then": {
        "properties": {
          "edition_context": {
            "properties": {
              "edition": {
                "const": "2018"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "edition": {
            "const": "2021"
          },
          "edition_context": {
            "type": "object"
          }
        }
      },
      "then": {
        "properties": {
          "edition_context": {
            "properties": {
              "edition": {
                "const": "2021"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "edition": {
            "const": "2024"
          },
          "edition_context": {
            "type": "object"
          }
        }
      },
      "then": {
        "properties": {
          "edition_context": {
            "properties": {
              "edition": {
                "const": "2024"
              }
            }
          }
        }
      }
    }
  ],
  "title": "Rust formatter parser observation with resolved Cargo edition"
}
