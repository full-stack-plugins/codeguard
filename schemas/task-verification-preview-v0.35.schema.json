{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_type",
    "operation",
    "command_status",
    "exit_code",
    "task_id",
    "kind",
    "observation",
    "event_persisted",
    "reason",
    "native_scan",
    "authority",
    "delivery_decision",
    "execution_budget",
    "next_actions"
  ],
  "properties": {
    "schema_version": {
      "const": "0.35.0"
    },
    "execution_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timeout_ms",
        "source",
        "enforcement"
      ],
      "properties": {
        "timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400000
        },
        "source": {
          "enum": [
            "cli",
            "registered_environment",
            "project_default",
            "builtin_default"
          ]
        },
        "enforcement": {
          "const": "native_execution_only"
        }
      }
    },
    "report_type": {
      "const": "task_verification_preview"
    },
    "operation": {
      "const": "task_verify"
    },
    "command_status": {
      "const": "incomplete"
    },
    "exit_code": {
      "const": 3
    },
    "task_id": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^CG-(B-)?[0-9a-f]{32}$"
        }
      ]
    },
    "kind": {
      "enum": [
        null,
        "blocker"
      ]
    },
    "observation": {
      "enum": [
        "still_blocked",
        "incomplete",
        "rule_coverage_requires_review"
      ]
    },
    "event_persisted": {
      "type": "boolean"
    },
    "reason": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "native_scan": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "schema_version": {
              "const": "0.1.0"
            },
            "report_type": {
              "const": "gradle_cve_task_recheck"
            },
            "operation": {
              "const": "task_verify"
            },
            "run_id": {
              "type": "string",
              "pattern": "^cve-gradle-task-[0-9]+-[0-9]+$",
              "maxLength": 120
            },
            "workspace_binding": {
              "const": "bound"
            },
            "workspace_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "checker_id": {
              "const": "java.gradle.dependency_check"
            },
            "authority": {
              "const": "local_unverified"
            },
            "coverage_proven": {
              "const": false
            },
            "delivery_decision": {
              "const": "not_evaluated"
            },
            "task_id": {
              "type": "string",
              "pattern": "^CG-B-[0-9a-f]{32}$"
            },
            "origin": {
              "type": "object",
              "properties": {
                "first_run_id": {
                  "type": "string",
                  "pattern": "^cve-gradle-[A-Za-z0-9-]{1,100}$"
                },
                "first_report_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "first_run_id",
                "first_report_sha256"
              ],
              "additionalProperties": false
            },
            "scan": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "properties": {
                    "schema_version": {
                      "const": "0.1.0"
                    },
                    "report_type": {
                      "const": "gradle_cve_workbench_observation"
                    },
                    "workspace_binding": {
                      "const": "bound"
                    },
                    "workspace_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    },
                    "run_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256,
                      "pattern": "^cve-gradle-[a-zA-Z0-9-]+$"
                    },
                    "checker_id": {
                      "const": "java.gradle.dependency_check"
                    },
                    "authority": {
                      "const": "local_unverified"
                    },
                    "coverage_proven": {
                      "const": false
                    },
                    "delivery_decision": {
                      "const": "not_evaluated"
                    },
                    "native_identity": {
                      "type": "object",
                      "properties": {
                        "source_snapshot_sha256": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "pattern": "^[a-f0-9]{64}$"
                        },
                        "gradle_bundle_sha256": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "pattern": "^[a-f0-9]{64}$"
                        },
                        "java_entry_sha256": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "pattern": "^[a-f0-9]{64}$"
                        },
                        "jdk_release_sha256": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "pattern": "^[a-f0-9]{64}$"
                        },
                        "dependency_cache_sha256": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "pattern": "^[a-f0-9]{64}$"
                        },
                        "model_report_sha256": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "pattern": "^[a-f0-9]{64}$"
                        },
                        "ownership_report_sha256": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "pattern": "^[a-f0-9]{64}$"
                        },
                        "init_scripts_sha256": {
                          "type": "string",
                          "pattern": "^[a-f0-9]{64}$"
                        }
                      },
                      "required": [
                        "source_snapshot_sha256",
                        "gradle_bundle_sha256",
                        "java_entry_sha256",
                        "jdk_release_sha256",
                        "dependency_cache_sha256",
                        "model_report_sha256",
                        "ownership_report_sha256",
                        "init_scripts_sha256"
                      ],
                      "additionalProperties": false
                    },
                    "inputs": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "path": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 256
                          },
                          "sha256": {
                            "type": "string",
                            "pattern": "^[a-f0-9]{64}$"
                          }
                        },
                        "required": [
                          "path",
                          "sha256"
                        ],
                        "additionalProperties": false
                      },
                      "maxItems": 128,
                      "minItems": 1
                    },
                    "task_paths": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256,
                        "pattern": "^:[A-Za-z0-9_-]+(:[A-Za-z0-9_-]+)*$"
                      },
                      "maxItems": 128,
                      "minItems": 1
                    },
                    "module_cache_selected": {
                      "type": "boolean"
                    },
                    "native_status": {
                      "enum": [
                        "incomplete",
                        "reports_observed_unverified"
                      ]
                    },
                    "diagnostic_reason": {
                      "enum": [
                        "database_and_dependency_coverage_unverified",
                        "gradle_dependency_cache_budget_exceeded",
                        "gradle_dependency_cache_capture_interrupted",
                        "gradle_dependency_cache_changed_during_task",
                        "gradle_dependency_cache_materialization_incomplete",
                        "gradle_dependency_cache_scope_invalid",
                        "gradle_dependency_cache_snapshot_unavailable",
                        "gradle_dependency_cache_unavailable",
                        "gradle_native_model_incomplete",
                        "gradle_native_model_invalid",
                        "gradle_owasp_composite_build_unresolved",
                        "gradle_owasp_configuration_api_unresolved",
                        "gradle_owasp_json_not_configured",
                        "gradle_owasp_native_report_attribution_unresolved",
                        "gradle_owasp_native_report_invalid",
                        "gradle_owasp_report_missing",
                        "gradle_owasp_report_ownership_duplicate",
                        "gradle_owasp_report_ownership_invalid",
                        "gradle_owasp_report_ownership_unavailable",
                        "gradle_owasp_report_preexisting",
                        "gradle_owasp_report_scope_invalid",
                        "gradle_owasp_report_unavailable",
                        "gradle_owasp_reserved_task_collision",
                        "gradle_owasp_scan_skipped",
                        "gradle_owasp_task_selection_invalid",
                        "gradle_owasp_task_unavailable",
                        "jdk21_version_unresolved",
                        "native_execution_incomplete",
                        "native_failure_with_reports_unverified",
                        "native_identity_changed_during_task",
                        "native_identity_unavailable",
                        "native_prerequisite_unavailable",
                        "native_process_incomplete",
                        "prerequisites_missing",
                        "private_workspace_unavailable",
                        "request_cancelled",
                        "request_deadline_exceeded",
                        "root_build_inputs_missing",
                        "selected_inputs_changed_during_task",
                        "selected_inputs_unavailable",
                        "gradle_owasp_report_budget_exceeded"
                      ]
                    },
                    "native_report_sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "report_summaries": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "task_path": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 256
                          },
                          "report_sha256": {
                            "type": "string",
                            "pattern": "^[a-f0-9]{64}$"
                          },
                          "dependency_count": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 100000
                          },
                          "advisory_count": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 1000
                          }
                        },
                        "required": [
                          "task_path",
                          "report_sha256",
                          "dependency_count",
                          "advisory_count"
                        ],
                        "additionalProperties": false
                      },
                      "maxItems": 128,
                      "minItems": 0
                    }
                  },
                  "required": [
                    "schema_version",
                    "report_type",
                    "workspace_binding",
                    "workspace_id",
                    "run_id",
                    "checker_id",
                    "authority",
                    "coverage_proven",
                    "delivery_decision",
                    "native_identity",
                    "inputs",
                    "task_paths",
                    "module_cache_selected",
                    "native_status",
                    "diagnostic_reason",
                    "native_report_sha256",
                    "report_summaries"
                  ],
                  "additionalProperties": false,
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "allOf": [
                    {
                      "if": {
                        "properties": {
                          "native_status": {
                            "const": "incomplete"
                          }
                        }
                      },
                      "then": {
                        "properties": {
                          "report_summaries": {
                            "maxItems": 0
                          }
                        }
                      },
                      "else": {
                        "properties": {
                          "report_summaries": {
                            "minItems": 1
                          },
                          "diagnostic_reason": {
                            "enum": [
                              "database_and_dependency_coverage_unverified",
                              "native_failure_with_reports_unverified"
                            ]
                          }
                        }
                      }
                    }
                  ]
                }
              ]
            },
            "input_bindings": {
              "type": "array",
              "maxItems": 132,
              "items": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "location": {
                    "enum": [
                      "workspace",
                      "bundle",
                      "tool",
                      "cache"
                    ]
                  }
                },
                "required": [
                  "path",
                  "sha256",
                  "location"
                ],
                "additionalProperties": false
              }
            },
            "reason": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,127}$"
            },
            "task_input_stable": {
              "type": "boolean"
            },
            "original_inputs_match": {
              "type": "boolean"
            },
            "tool_identity_matches": {
              "type": "boolean"
            },
            "original_tool_identity_complete": {
              "type": "boolean"
            },
            "cache_identity_matches": {
              "type": "boolean"
            }
          },
          "required": [
            "schema_version",
            "report_type",
            "operation",
            "run_id",
            "workspace_binding",
            "workspace_id",
            "checker_id",
            "authority",
            "coverage_proven",
            "delivery_decision",
            "task_id",
            "origin",
            "scan",
            "input_bindings",
            "reason",
            "task_input_stable",
            "original_inputs_match",
            "tool_identity_matches",
            "original_tool_identity_complete",
            "cache_identity_matches"
          ],
          "additionalProperties": false,
          "$schema": "https://json-schema.org/draft/2020-12/schema"
        }
      ]
    },
    "authority": {
      "const": "local_unverified"
    },
    "delivery_decision": {
      "const": "not_evaluated"
    },
    "next_actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
