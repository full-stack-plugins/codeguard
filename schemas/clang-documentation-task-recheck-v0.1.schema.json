{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_type",
    "workspace_binding",
    "workspace_id",
    "run_id",
    "path",
    "language",
    "standard",
    "profile",
    "selected_tool",
    "source_sha256",
    "local_scan_complete",
    "native",
    "authority",
    "coverage_proven",
    "delivery_decision",
    "task_id",
    "task_kind",
    "task_rule",
    "original_ref",
    "input_stable"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "report_type": {
      "const": "clang_documentation_task_recheck"
    },
    "workspace_binding": {
      "const": "bound"
    },
    "workspace_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "pattern": "^clangdoc-[0-9]+-[0-9]+-[0-9]+$"
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "enum": [
        "c",
        "cpp"
      ]
    },
    "standard": {
      "enum": [
        "c11",
        "c++17"
      ]
    },
    "profile": {
      "const": "clang-documentation-v1"
    },
    "selected_tool": {
      "type": "string",
      "minLength": 1
    },
    "source_sha256": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      ]
    },
    "local_scan_complete": {
      "type": "boolean"
    },
    "native": {
      "$ref": "urn:codeguard:syntax-lint-feedback:0.2#/properties/native"
    },
    "authority": {
      "const": "local_unverified"
    },
    "coverage_proven": {
      "const": false
    },
    "delivery_decision": {
      "const": "not_evaluated"
    },
    "task_id": {
      "type": "string",
      "pattern": "^CG-(B-)?[0-9a-f]{32}$"
    },
    "task_kind": {
      "enum": [
        "finding",
        "blocker"
      ]
    },
    "task_rule": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^clang\\.[A-Za-z0-9_]{1,128}$"
        }
      ]
    },
    "input_stable": {
      "type": "boolean"
    },
    "original_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "sha256"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "pattern": "^clangdoc-[0-9]+-[0-9]+-[0-9]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "language": {
            "const": "c"
          }
        }
      },
      "then": {
        "properties": {
          "standard": {
            "const": "c11"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "language": {
            "const": "cpp"
          }
        }
      },
      "then": {
        "properties": {
          "standard": {
            "const": "c++17"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "native": {
            "properties": {
              "status": {
                "enum": [
                  "completed",
                  "diagnostics_observed"
                ]
              },
              "diagnostics": {
                "not": {
                  "contains": {
                    "properties": {
                      "level": {
                        "const": "error"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "local_scan_complete": {
            "const": true
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      },
      "else": {
        "properties": {
          "local_scan_complete": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "task_kind": {
            "const": "blocker"
          }
        }
      },
      "then": {
        "properties": {
          "task_id": {
            "pattern": "^CG-B-[0-9a-f]{32}$"
          },
          "task_rule": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "task_id": {
            "pattern": "^CG-[0-9a-f]{32}$"
          },
          "task_rule": {
            "type": "string"
          }
        }
      }
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codeguard:clang-documentation-task-recheck:0.1"
}
