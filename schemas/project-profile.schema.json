{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codeguard:schema:project-profile:0.3.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_type",
    "project_root",
    "observation_complete",
    "languages",
    "build_roots",
    "manifest_sha256",
    "package_declared_versions",
    "lockfiles",
    "lock_sha256",
    "checker_config_sha256",
    "checker_configurations",
    "source_set_candidates",
    "blocked_paths",
    "unknown_conditions",
    "architecture_status",
    "delivery_decision",
    "language_targets"
  ],
  "properties": {
    "schema_version": {
      "const": "0.3.0"
    },
    "document_type": {
      "const": "codeguard_project_profile"
    },
    "project_root": {
      "const": "."
    },
    "observation_complete": {
      "type": "boolean"
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "source_file_count",
          "source_set_sha256",
          "manifests",
          "declared_version",
          "installed_version",
          "version_status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "source_file_count": {
            "type": "integer",
            "minimum": 0
          },
          "source_set_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "manifests": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "declared_version": {
            "type": [
              "string",
              "null"
            ]
          },
          "installed_version": {
            "const": null
          },
          "version_status": {
            "enum": [
              "declared_only",
              "unknown"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "build_roots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "manifests",
          "resolution"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "manifests": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "resolution": {
            "const": "static_observation_only"
          }
        },
        "additionalProperties": false
      }
    },
    "manifest_sha256": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "package_declared_versions": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "lockfiles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "lock_sha256": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/sha256"
      }
    },
    "checker_config_sha256": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/sha256"
      }
    },
    "checker_configurations": {
      "type": "array"
    },
    "source_set_candidates": {
      "type": "array"
    },
    "blocked_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unknown_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "architecture_status": {
      "const": "unknown"
    },
    "delivery_decision": {
      "const": "not_evaluated"
    },
    "language_targets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "value",
          "status",
          "manifest_ref",
          "manifest_sha256",
          "build_root",
          "language_id",
          "target_kind"
        ],
        "properties": {
          "value": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[0-9]+(\\.[0-9]+){0,2}$"
          },
          "status": {
            "const": "declared_only"
          },
          "manifest_ref": {
            "type": "string",
            "minLength": 1
          },
          "manifest_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "build_root": {
            "type": "string",
            "minLength": 1
          },
          "language_id": {
            "enum": [
              "java",
              "rust"
            ]
          },
          "target_kind": {
            "enum": [
              "maven.compiler.release",
              "maven.compiler.source",
              "maven.compiler.target",
              "rust-version",
              "edition"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "language_id": {
                  "const": "java"
                }
              }
            },
            "then": {
              "properties": {
                "target_kind": {
                  "enum": [
                    "maven.compiler.release",
                    "maven.compiler.source",
                    "maven.compiler.target"
                  ]
                }
              }
            },
            "else": {
              "properties": {
                "target_kind": {
                  "enum": [
                    "rust-version",
                    "edition"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "target_kind": {
                  "const": "edition"
                }
              }
            },
            "then": {
              "properties": {
                "value": {
                  "enum": [
                    "2015",
                    "2018",
                    "2021",
                    "2024"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "target_kind": {
                  "const": "maven.compiler.release"
                }
              }
            },
            "then": {
              "properties": {
                "value": {
                  "pattern": "^[0-9]+$",
                  "not": {
                    "const": "0"
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "target_kind": {
                  "const": "rust-version"
                }
              }
            },
            "then": {
              "properties": {
                "value": {
                  "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$"
                }
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
