{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codeguard:schema:go-static-candidate:1.0.0",
  "title": "Go native static-check candidates, not validated capabilities",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "language", "dialect", "platforms", "platform_validation", "categories"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "language": {"const": "go"},
    "dialect": {"const": "go_modules"},
    "platforms": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {"enum": ["macos_arm64", "macos_x86_64", "linux_x86_64", "linux_aarch64", "windows_x86_64"]}
    },
    "platform_validation": {"const": "unverified"},
    "categories": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {"$ref": "#/$defs/slot"}
    }
  },
  "$defs": {
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "applicability", "status", "candidate_tool", "candidate_version", "version_status", "candidate_argv", "requires_database_freshness", "sources", "coverage_gaps"],
      "properties": {
        "category": {"enum": ["lint", "comments", "dependencies", "cve", "security", "build"]},
        "applicability": {"const": "applicable"},
        "status": {"const": "gap"},
        "candidate_tool": {"type": "string", "minLength": 1},
        "candidate_version": {"type": "string", "minLength": 1, "not": {"const": "latest"}},
        "version_status": {"enum": ["resolved_at_run", "release_candidate_unvalidated"]},
        "candidate_argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "requires_database_freshness": {"type": "boolean"},
        "sources": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^https://[^ ]+$"}},
        "coverage_gaps": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
