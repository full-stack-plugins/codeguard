{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codeguard:schema:task-show-preview:0.3.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_type",
    "operation",
    "request_id",
    "command_status",
    "exit_code",
    "task",
    "next_actions",
    "authority",
    "delivery_decision",
    "task_id",
    "state",
    "evidence_freshness",
    "event_chain_status"
  ],
  "properties": {
    "schema_version": {
      "const": "0.3.0"
    },
    "report_type": {
      "const": "task_show_preview"
    },
    "operation": {
      "const": "task_show"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "command_status": {
      "const": "complete"
    },
    "exit_code": {
      "const": 0
    },
    "reason": {
      "type": "string"
    },
    "task_id": {
      "type": "string",
      "pattern": "^CG-(B-)?[0-9a-f]{32}$"
    },
    "task": {
      "$ref": "repair-brief-preview-v0.17.schema.json#/$defs/brief"
    },
    "state": {
      "const": "open"
    },
    "evidence_freshness": {
      "const": "unverified"
    },
    "event_chain_status": {
      "const": "unverified"
    },
    "next_actions": {
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "const": "codeguard"
          },
          {
            "const": "task"
          },
          {
            "const": "verify"
          },
          {
            "type": "string",
            "pattern": "^CG-(?:B-)?[a-f0-9]{32}$"
          },
          {
            "type": "string",
            "pattern": "^/"
          },
          {
            "const": "--shellcheck-tool"
          },
          {
            "type": "string",
            "minLength": 1
          },
          {
            "const": "--format=json"
          }
        ],
        "items": false,
        "minItems": 8
      },
      "minItems": 1,
      "maxItems": 1
    },
    "authority": {
      "const": "local_unverified"
    },
    "delivery_decision": {
      "const": "not_evaluated"
    }
  }
}
