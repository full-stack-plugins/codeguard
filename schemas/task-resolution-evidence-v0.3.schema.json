{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeguard.dev/schemas/task-resolution-evidence-v0.3.schema.json",
  "title": "Apple Swift 6.4 原反例与当前源码的脱敏 parse 对照证据",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.3.0"
    },
    "report_type": {
      "const": "task_resolution_evidence"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workspace_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
        },
        "task_id": {
          "type": "string",
          "pattern": "^CG-B-[0-9a-f]{32}$"
        },
        "checker_id": {
          "const": "syntax.native_confirmation"
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^\\\\:\\x00-\\x1f\\x7f]+$"
        }
      },
      "required": [
        "workspace_id",
        "task_id",
        "checker_id",
        "scope"
      ]
    },
    "original_report_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "original_source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "current_source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "grammar_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "tool_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "adapter_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "policy_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "policy_revision": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
    },
    "original_native": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason",
        "version",
        "tool_sha256",
        "diagnostics"
      ],
      "properties": {
        "status": {
          "enum": [
            "not_run",
            "incomplete",
            "completed",
            "diagnostics_observed"
          ]
        },
        "reason": {
          "type": "string",
          "pattern": "^[a-z_]{1,128}$"
        },
        "version": {
          "enum": [
            null,
            "Apple Swift 6.4"
          ]
        },
        "tool_sha256": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/digest"
            }
          ]
        },
        "diagnostics": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/diagnostic"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "completed",
                  "diagnostics_observed"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "version": {
                "const": "Apple Swift 6.4"
              },
              "tool_sha256": {
                "$ref": "#/$defs/digest"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "completed"
              }
            }
          },
          "then": {
            "properties": {
              "diagnostics": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "diagnostics_observed"
              }
            }
          },
          "then": {
            "properties": {
              "diagnostics": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "not_run"
              }
            }
          },
          "then": {
            "properties": {
              "version": {
                "type": "null"
              },
              "tool_sha256": {
                "type": "null"
              },
              "diagnostics": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "completed"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "const": "swift_native_parse_no_diagnostics"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "diagnostics_observed"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "const": "swift_native_parse_diagnostics"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "incomplete"
              }
            }
          },
          "then": {
            "properties": {
              "diagnostics": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "current_native": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason",
        "version",
        "tool_sha256",
        "diagnostics"
      ],
      "properties": {
        "status": {
          "enum": [
            "not_run",
            "incomplete",
            "completed",
            "diagnostics_observed"
          ]
        },
        "reason": {
          "type": "string",
          "pattern": "^[a-z_]{1,128}$"
        },
        "version": {
          "enum": [
            null,
            "Apple Swift 6.4"
          ]
        },
        "tool_sha256": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/digest"
            }
          ]
        },
        "diagnostics": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/diagnostic"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "completed",
                  "diagnostics_observed"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "version": {
                "const": "Apple Swift 6.4"
              },
              "tool_sha256": {
                "$ref": "#/$defs/digest"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "completed"
              }
            }
          },
          "then": {
            "properties": {
              "diagnostics": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "diagnostics_observed"
              }
            }
          },
          "then": {
            "properties": {
              "diagnostics": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "not_run"
              }
            }
          },
          "then": {
            "properties": {
              "version": {
                "type": "null"
              },
              "tool_sha256": {
                "type": "null"
              },
              "diagnostics": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "completed"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "const": "swift_native_parse_no_diagnostics"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "diagnostics_observed"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "const": "swift_native_parse_diagnostics"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "incomplete"
              }
            }
          },
          "then": {
            "properties": {
              "diagnostics": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "outcome": {
      "enum": [
        "code_fixed",
        "still_present",
        "inputs_stale",
        "native_incomplete",
        "false_positive_review_required",
        "resolution_evidence_incomplete",
        "resolution_history_binding_changed"
      ]
    }
  },
  "required": [
    "schema_version",
    "report_type",
    "identity",
    "original_report_sha256",
    "original_source_sha256",
    "current_source_sha256",
    "grammar_sha256",
    "tool_sha256",
    "adapter_sha256",
    "policy_sha256",
    "policy_revision",
    "original_native",
    "current_native",
    "outcome"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "code_fixed"
          }
        }
      },
      "then": {
        "properties": {
          "original_native": {
            "properties": {
              "status": {
                "const": "diagnostics_observed"
              }
            }
          },
          "current_native": {
            "properties": {
              "status": {
                "const": "completed"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "line",
        "column",
        "rule_id"
      ],
      "properties": {
        "line": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "column": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048577
        },
        "rule_id": {
          "const": "swift.parse.error"
        }
      }
    }
  }
}
