{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codeguard:schema:consumed-report-marker:0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "workspace_id", "run_id", "report_sha256"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "workspace_id": {"type": "string", "pattern": "^ws-[0-9a-f]{32}$"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,120}$"},
    "report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
