{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_type",
    "workspace_binding",
    "workspace_id",
    "run_id",
    "checker_id",
    "authority",
    "coverage_proven",
    "delivery_decision",
    "inputs",
    "native",
    "findings",
    "blockers"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "report_type": {
      "const": "gradle_javadoc_workbench_observation"
    },
    "workspace_binding": {
      "const": "bound"
    },
    "workspace_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "pattern": "^javadoc-gradle-[A-Za-z0-9_-]+$"
    },
    "checker_id": {
      "const": "java.gradle.javadoc"
    },
    "authority": {
      "const": "local_unverified"
    },
    "coverage_proven": {
      "const": false
    },
    "delivery_decision": {
      "const": "not_evaluated"
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "native": {
      "$ref": "gradle-javadoc-probe-v0.1.schema.json"
    },
    "findings": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_id",
          "finding_fingerprint",
          "path",
          "source_sha256",
          "rule_id",
          "line",
          "checker_id",
          "column"
        ],
        "properties": {
          "finding_id": {
            "type": "string",
            "pattern": "^CG-[0-9a-f]{32}$"
          },
          "finding_fingerprint": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "rule_id": {
            "enum": [
              "JavadocMissingComment",
              "JavadocDefaultConstructorMissingComment",
              "JavadocMissingParam",
              "JavadocMissingReturn",
              "JavadocMissingThrows",
              "JavadocEmptyParamDescription",
              "JavadocEmptyReturnDescription"
            ]
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "checker_id": {
            "const": "java.gradle.javadoc"
          },
          "column": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "blockers": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "fingerprint",
          "build_root",
          "scope",
          "affected_paths",
          "reason",
          "checker_id",
          "diagnostic_reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^CG-B-[0-9a-f]{32}$"
          },
          "fingerprint": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "build_root": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "affected_paths": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "reason": {
            "enum": [
              "gradle_javadoc_native_incomplete",
              "gradle_documentation_rules_and_coverage_unverified"
            ]
          },
          "checker_id": {
            "const": "java.gradle.javadoc"
          },
          "diagnostic_reason": {
            "enum": [
              "gradle_javadoc_task_scope_invalid",
              "gradle_javadoc_task_unavailable",
              "gradle_native_model_incomplete",
              "gradle_native_model_invalid",
              "jdk21_version_unresolved",
              "native_execution_incomplete",
              "native_identity_changed_during_task",
              "native_identity_unavailable",
              "native_javadoc_output_unresolved",
              "native_javadoc_source_unresolved",
              "native_prerequisite_unavailable",
              "native_process_incomplete",
              "native_stdout_diagnostics_unresolved",
              "private_workspace_unavailable",
              "request_cancelled",
              "request_deadline_exceeded",
              "root_build_inputs_missing",
              "selected_inputs_changed_during_task",
              "selected_inputs_unavailable",
              "selected_java_sources_missing",
              "prerequisites_missing",
              "selected_sources_and_complete_documentation_rules_unverified"
            ]
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codeguard:schema:gradle-javadoc-workbench-observation:0.1.0"
}
