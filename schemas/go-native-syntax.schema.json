{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codeguard:schema:go-native-syntax:0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "reason",
    "version",
    "tool_sha256",
    "diagnostics",
    "gofmt_sha256",
    "companion_binding_sha256",
    "input_type"
  ],
  "properties": {
    "status": {
      "enum": [
        "incomplete",
        "completed",
        "diagnostics_observed"
      ]
    },
    "reason": {
      "enum": [
        "go_syntax_input_invalid",
        "go_syntax_tool_unavailable",
        "go_syntax_tool_changed",
        "go_syntax_version_unverified",
        "go_syntax_execution_incomplete",
        "go_syntax_report_invalid",
        "go_native_syntax_no_diagnostics",
        "go_native_syntax_diagnostics",
        "go_syntax_logical_positions_unresolved"
      ]
    },
    "version": {
      "enum": [
        null,
        "go1.23.4"
      ]
    },
    "tool_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "diagnostics": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "line",
          "rule_id",
          "column",
          "column_unit"
        ],
        "properties": {
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "rule_id": {
            "const": "go.syntax"
          },
          "column": {
            "type": "integer",
            "minimum": 1
          },
          "column_unit": {
            "const": "utf8_byte"
          }
        }
      }
    },
    "input_type": {
      "const": "whole_file"
    },
    "gofmt_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "companion_binding_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "completed"
          }
        }
      },
      "then": {
        "properties": {
          "reason": {
            "const": "go_native_syntax_no_diagnostics"
          },
          "version": {
            "const": "go1.23.4"
          },
          "tool_sha256": {
            "type": "string"
          },
          "diagnostics": {
            "maxItems": 0
          },
          "gofmt_sha256": {
            "type": "string"
          },
          "companion_binding_sha256": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "diagnostics_observed"
          }
        }
      },
      "then": {
        "properties": {
          "reason": {
            "const": "go_native_syntax_diagnostics"
          },
          "version": {
            "const": "go1.23.4"
          },
          "tool_sha256": {
            "type": "string"
          },
          "diagnostics": {
            "minItems": 1
          },
          "gofmt_sha256": {
            "type": "string"
          },
          "companion_binding_sha256": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "incomplete"
          }
        }
      },
      "then": {
        "properties": {
          "reason": {
            "enum": [
              "go_syntax_input_invalid",
              "go_syntax_tool_unavailable",
              "go_syntax_tool_changed",
              "go_syntax_version_unverified",
              "go_syntax_execution_incomplete",
              "go_syntax_report_invalid",
              "go_syntax_logical_positions_unresolved"
            ]
          },
          "diagnostics": {
            "const": []
          }
        }
      }
    }
  ]
}
