{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codeguard:schema:go-syntax-scan:0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_type",
    "scope",
    "tool_selection",
    "source_file_count",
    "unobserved_count",
    "scope_stable",
    "local_parse_complete",
    "files",
    "task_status",
    "authority",
    "coverage_proven",
    "delivery_decision"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "report_type": {
      "const": "go_syntax_scan"
    },
    "scope": {
      "const": "single_frozen_go_files"
    },
    "tool_selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "executable"
      ],
      "properties": {
        "source": {
          "enum": [
            "explicit",
            "path",
            "not_found"
          ]
        },
        "executable": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "source_file_count": {
      "type": "integer",
      "minimum": 0
    },
    "unobserved_count": {
      "type": "integer",
      "minimum": 0
    },
    "scope_stable": {
      "type": "boolean"
    },
    "local_parse_complete": {
      "type": "boolean"
    },
    "files": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "source_sha256",
          "current",
          "tool_path",
          "native",
          "task_id",
          "task_sync_reason",
          "recheck_argv",
          "next_action"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": ".*\\.go$"
          },
          "source_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          },
          "current": {
            "type": "boolean"
          },
          "tool_path": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^/"
          },
          "native": {
            "$ref": "#/$defs/native"
          },
          "task_id": {
            "type": "null"
          },
          "task_sync_reason": {
            "type": "null"
          },
          "recheck_argv": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          },
          "next_action": {
            "type": "string",
            "minLength": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "current": {
                  "const": true
                }
              }
            },
            "then": {
              "properties": {
                "source_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "current": {
                  "const": false
                }
              }
            },
            "then": {
              "properties": {
                "native": {
                  "properties": {
                    "diagnostics": {
                      "maxItems": 0
                    },
                    "context_diagnostics": {
                      "maxItems": 0
                    }
                  }
                },
                "recheck_argv": {
                  "type": "null"
                }
              }
            }
          }
        ]
      }
    },
    "task_status": {
      "const": "not_connected"
    },
    "authority": {
      "const": "local_unverified"
    },
    "coverage_proven": {
      "const": false
    },
    "delivery_decision": {
      "const": "not_evaluated"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "local_parse_complete": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "scope_stable": {
            "const": true
          },
          "unobserved_count": {
            "const": 0
          },
          "files": {
            "minItems": 1,
            "items": {
              "properties": {
                "current": {
                  "const": true
                },
                "native": {
                  "properties": {
                    "status": {
                      "enum": [
                        "completed",
                        "diagnostics_observed"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "line",
        "column",
        "rule_id",
        "column_unit"
      ],
      "properties": {
        "line": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "column": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048577
        },
        "rule_id": {
          "const": "go.syntax"
        },
        "column_unit": {
          "const": "utf8_byte"
        }
      }
    },
    "native": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason",
        "version",
        "tool_sha256",
        "diagnostics",
        "gofmt_sha256",
        "companion_binding_sha256",
        "input_type"
      ],
      "properties": {
        "status": {
          "enum": [
            "not_run",
            "incomplete",
            "completed",
            "diagnostics_observed"
          ]
        },
        "reason": {
          "type": "string",
          "pattern": "^[a-z_]{1,128}$"
        },
        "version": {
          "enum": [
            null,
            "go1.23.4"
          ]
        },
        "tool_sha256": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/digest"
            }
          ]
        },
        "diagnostics": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/diagnostic"
          }
        },
        "gofmt_sha256": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/digest"
            }
          ]
        },
        "companion_binding_sha256": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/digest"
            }
          ]
        },
        "input_type": {
          "const": "whole_file"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "completed",
                  "diagnostics_observed"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "version": {
                "const": "go1.23.4"
              },
              "tool_sha256": {
                "$ref": "#/$defs/digest"
              },
              "gofmt_sha256": {
                "$ref": "#/$defs/digest"
              },
              "companion_binding_sha256": {
                "$ref": "#/$defs/digest"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "completed"
              }
            }
          },
          "then": {
            "properties": {
              "diagnostics": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "diagnostics_observed"
              }
            }
          },
          "then": {
            "properties": {
              "diagnostics": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "not_run"
              }
            }
          },
          "then": {
            "properties": {
              "version": {
                "type": "null"
              },
              "tool_sha256": {
                "type": "null"
              },
              "diagnostics": {
                "maxItems": 0
              },
              "gofmt_sha256": {
                "type": "null"
              },
              "companion_binding_sha256": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "completed"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "const": "go_native_syntax_no_diagnostics"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "diagnostics_observed"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "const": "go_native_syntax_diagnostics"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "incomplete"
              }
            }
          },
          "then": {
            "properties": {
              "diagnostics": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    }
  }
}
