{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codeguard:schema:ruby-syntax-scan:0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_type",
    "scope",
    "tool_selection",
    "source_file_count",
    "unobserved_count",
    "scope_stable",
    "local_parse_complete",
    "files",
    "task_status",
    "authority",
    "coverage_proven",
    "delivery_decision"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "report_type": {
      "const": "ruby_syntax_scan"
    },
    "scope": {
      "const": "single_frozen_ruby_files"
    },
    "tool_selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "executable"
      ],
      "properties": {
        "source": {
          "enum": [
            "explicit",
            "path",
            "not_found"
          ]
        },
        "executable": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "source_file_count": {
      "type": "integer",
      "minimum": 0
    },
    "unobserved_count": {
      "type": "integer",
      "minimum": 0
    },
    "scope_stable": {
      "type": "boolean"
    },
    "local_parse_complete": {
      "type": "boolean"
    },
    "files": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "source_sha256",
          "current",
          "tool_path",
          "native",
          "task_id",
          "task_sync_reason",
          "recheck_argv",
          "next_action"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": ".*\\.rb$"
          },
          "source_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          },
          "current": {
            "type": "boolean"
          },
          "tool_path": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^/"
          },
          "native": {
            "$ref": "ruby-lint-feedback-v0.1.schema.json#/$defs/native"
          },
          "task_id": {
            "type": "null"
          },
          "task_sync_reason": {
            "type": "null"
          },
          "recheck_argv": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          },
          "next_action": {
            "type": "string",
            "minLength": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "current": {
                  "const": true
                }
              }
            },
            "then": {
              "properties": {
                "source_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "current": {
                  "const": false
                }
              }
            },
            "then": {
              "properties": {
                "native": {
                  "properties": {
                    "diagnostics": {
                      "maxItems": 0
                    },
                    "context_diagnostics": {
                      "maxItems": 0
                    }
                  }
                },
                "recheck_argv": {
                  "type": "null"
                }
              }
            }
          }
        ]
      }
    },
    "task_status": {
      "const": "not_connected"
    },
    "authority": {
      "const": "local_unverified"
    },
    "coverage_proven": {
      "const": false
    },
    "delivery_decision": {
      "const": "not_evaluated"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "local_parse_complete": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "scope_stable": {
            "const": true
          },
          "unobserved_count": {
            "const": 0
          },
          "files": {
            "minItems": 1,
            "items": {
              "properties": {
                "current": {
                  "const": true
                },
                "native": {
                  "properties": {
                    "status": {
                      "enum": [
                        "completed",
                        "diagnostics_observed"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
