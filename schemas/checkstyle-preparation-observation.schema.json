{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codeguard:schema:checkstyle-preparation-observation:0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_type",
    "workspace_binding",
    "checker_id",
    "authority",
    "coverage_proven",
    "delivery_decision",
    "execution",
    "reason_code",
    "build_root",
    "scope",
    "workspace_id",
    "run_id",
    "blocker_id",
    "fingerprint",
    "diagnostic_reason",
    "source_sha256",
    "affected_paths"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "report_type": {
      "const": "checkstyle_preparation_observation"
    },
    "workspace_binding": {
      "const": "bound"
    },
    "checker_id": {
      "const": "java.checkstyle.preparation"
    },
    "authority": {
      "const": "local_unverified"
    },
    "coverage_proven": {
      "const": false
    },
    "delivery_decision": {
      "const": "not_evaluated"
    },
    "execution": {
      "const": "incomplete"
    },
    "reason_code": {
      "const": "checkstyle_prerequisites_require_review"
    },
    "build_root": {
      "const": "."
    },
    "scope": {
      "const": "."
    },
    "workspace_id": {
      "type": "string",
      "pattern": "^ws-[0-9a-f]{32}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^checkstyle-preparation-[0-9]+-[0-9]+$"
    },
    "blocker_id": {
      "type": "string",
      "pattern": "^CG-B-[0-9a-f]{32}$"
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "diagnostic_reason": {
      "type": "string",
      "pattern": "^[a-z_]{1,80}$",
      "not": {
        "const": "request_cancelled"
      }
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "affected_paths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
