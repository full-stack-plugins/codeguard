{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codeguard:schema:check-aborted:0.4.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "report_type", "operation", "selection", "command_status", "exit_code", "delivery_decision", "authority", "reason", "failed_task_ids", "execution_tasks", "discovery", "native_results", "export"],
  "properties": {
    "schema_version": {"const": "0.4.0"},
    "report_type": {"const": "check_aborted"},
    "operation": {"const": "check"},
    "selection": {"enum": ["all", "java"]},
    "command_status": {"enum": ["internal_error", "cancelled"]},
    "exit_code": {"enum": [4, 130]},
    "delivery_decision": {"enum": ["incomplete", "not_evaluated"]},
    "authority": {"const": "local_unverified"},
    "reason": {"enum": ["native_task_internal_failure", "request_cancelled"]},
    "failed_task_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "execution_tasks": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "status"], "properties": {"id": {"type": "string", "minLength": 1}, "status": {"enum": ["native_observed_unverified", "native_incomplete", "cancelled", "deadline_exceeded", "dependency_failed", "cancelled_before_start", "deadline_before_start", "internal_failure"]}}}},
    "discovery": {"type": "object"},
    "native_results": {"type": "object", "additionalProperties": false, "required": ["python_lint", "rust_lint", "go_lint", "java_p3c", "java_javadoc", "java_dependencies", "java_cve"], "properties": {"python_lint": {"type": ["object", "null"]}, "rust_lint": {"type": ["object", "null"]}, "go_lint": {"type": ["object", "null"]}, "java_p3c": {"type": ["object", "null"]}, "java_javadoc": {"type": ["object", "null"]}, "java_dependencies": {"type": ["object", "null"]}, "java_cve": {"type": ["object", "null"]}}}
    ,"export": {"type": "object", "additionalProperties": false, "required": ["status", "reason_code"], "properties": {"status": {"enum": ["not_requested", "saved", "failed"]}, "reason_code": {"type": ["string", "null"]}}, "allOf": [{"if": {"properties": {"status": {"const": "failed"}}, "required": ["status"]}, "then": {"properties": {"reason_code": {"enum": ["output_parent_unavailable", "output_not_regular_file", "output_existing_file_is_not_codeguard_report", "output_identity_unavailable", "output_temp_create_failed", "output_temp_write_failed", "output_replace_failed", "output_existing_read_failed", "output_existing_too_large"]}}}, "else": {"properties": {"reason_code": {"type": "null"}}}}]}
  },
  "allOf": [{
    "if": {"properties": {"selection": {"const": "all"}}, "required": ["selection"]},
    "then": {"properties": {"delivery_decision": {"const": "incomplete"}}},
    "else": {"properties": {"delivery_decision": {"const": "not_evaluated"}}}
  }, {
    "if": {"properties": {"command_status": {"const": "cancelled"}}, "required": ["command_status"]},
    "then": {"properties": {"exit_code": {"const": 130}, "reason": {"const": "request_cancelled"}}},
    "else": {"properties": {"exit_code": {"const": 4}, "reason": {"const": "native_task_internal_failure"}}}
  }]
}
