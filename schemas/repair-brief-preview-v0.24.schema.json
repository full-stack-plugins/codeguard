{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codeguard:schema:repair-brief-preview:0.24.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_type",
    "operation",
    "command_status",
    "exit_code",
    "disposition",
    "reason",
    "repair_brief",
    "next_actions",
    "authority",
    "delivery_decision"
  ],
  "properties": {
    "schema_version": {
      "const": "0.24.0"
    },
    "report_type": {
      "const": "repair_brief_preview"
    },
    "operation": {
      "const": "next"
    },
    "command_status": {
      "enum": [
        "complete",
        "incomplete"
      ]
    },
    "exit_code": {
      "enum": [
        0,
        3
      ]
    },
    "disposition": {
      "enum": [
        "actionable",
        "waiting",
        "needs_decision",
        "verification_required",
        "no_applicable_work"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "repair_brief": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/brief"
        }
      ]
    },
    "next_actions": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "failed_reports": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "run_id",
          "reason",
          "report_ref"
        ],
        "properties": {
          "run_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,120}$"
          },
          "reason": {
            "type": "string",
            "pattern": "^[a-z0-9_]{1,80}$"
          },
          "report_ref": {
            "type": "string",
            "pattern": "^\\.codeguard/reports/[A-Za-z0-9_-]{1,120}\\.json$"
          }
        }
      }
    },
    "authority": {
      "const": "local_unverified"
    },
    "delivery_decision": {
      "const": "not_evaluated"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "first_run_id",
        "first_report_sha256"
      ],
      "properties": {
        "first_run_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,120}$"
        },
        "first_report_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "brief": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "task_id",
        "kind",
        "checker_id",
        "evidence_ref",
        "recheck_argv",
        "history",
        "action_id",
        "authority",
        "closure_condition",
        "scope",
        "constraints",
        "step",
        "disposition",
        "rule_basis",
        "task_verify_status",
        "observation_scope"
      ],
      "properties": {
        "schema_version": {
          "const": "0.24.0"
        },
        "task_id": {
          "type": "string",
          "pattern": "^CG-(B-)?[0-9a-f]{32}$"
        },
        "kind": {
          "enum": [
            "finding",
            "blocker"
          ]
        },
        "checker_id": {
          "const": "java.gradle.javadoc"
        },
        "evidence_ref": {
          "$ref": "#/$defs/evidence"
        },
        "recheck_argv": {
          "type": "array",
          "minItems": 11,
          "maxItems": 11,
          "prefixItems": [
            {
              "const": "codeguard"
            },
            {
              "const": "task"
            },
            {
              "const": "verify"
            },
            {
              "type": "string",
              "pattern": "^CG-(B-)?[0-9a-f]{32}$"
            },
            {
              "const": "."
            },
            {
              "const": "--gradle-bundle"
            },
            {
              "type": "string",
              "minLength": 1
            },
            {
              "const": "--java-home"
            },
            {
              "type": "string",
              "minLength": 1
            },
            {
              "const": "--format"
            },
            {
              "const": "json"
            }
          ],
          "items": false
        },
        "history": {
          "oneOf": [
            {
              "const": "attempt_history_unavailable"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "attempt_count",
                "no_progress_count",
                "open_attempt_id",
                "awaiting_verification",
                "budget",
                "recent"
              ],
              "properties": {
                "attempt_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "no_progress_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "open_attempt_id": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^CG-A-[0-9a-f]{32}$"
                },
                "awaiting_verification": {
                  "type": "boolean"
                },
                "budget": {
                  "const": 2
                },
                "recent": {
                  "type": "array",
                  "maxItems": 5,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "attempt_id",
                      "action_id",
                      "outcome",
                      "note_code",
                      "observed_change"
                    ],
                    "properties": {
                      "attempt_id": {
                        "type": "string",
                        "pattern": "^CG-A-[0-9a-f]{32}$"
                      },
                      "action_id": {
                        "enum": [
                          "repair-source",
                          "review-project-policy",
                          "restore-checker-environment"
                        ]
                      },
                      "outcome": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "enum": [
                          "ready-to-verify",
                          "no-change",
                          "failed",
                          "blocked",
                          "abandoned",
                          null
                        ]
                      },
                      "note_code": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "observed_change": {
                        "type": [
                          "boolean",
                          "null"
                        ]
                      }
                    }
                  }
                }
              }
            }
          ]
        },
        "action_id": {
          "enum": [
            "repair-source",
            "review-project-policy",
            "restore-checker-environment"
          ]
        },
        "authority": {
          "const": "local_unverified"
        },
        "closure_condition": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "constraints": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "step": {
          "type": "string",
          "minLength": 1
        },
        "disposition": {
          "enum": [
            "actionable",
            "needs_decision",
            "verification_required",
            "waiting"
          ]
        },
        "build_root": {
          "type": "string",
          "minLength": 1
        },
        "affected_paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reason_code": {
          "type": "string",
          "pattern": "^[a-z0-9_]{1,80}$"
        },
        "native_rule_id": {
          "enum": [
            "JavadocMissingComment",
            "JavadocDefaultConstructorMissingComment",
            "JavadocMissingParam",
            "JavadocMissingReturn",
            "JavadocMissingThrows",
            "JavadocEmptyParamDescription",
            "JavadocEmptyReturnDescription",
            "JavadocEmptyComment",
            "JavadocMissingMainDescription",
            "JavadocEmptyThrowsDescription"
          ]
        },
        "source_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "correction_proposal_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^\\.codeguard/findings/CG-[0-9a-f]{32}/events/correction-proposed-[0-9a-f]{64}\\.json$"
          }
        },
        "correction_task_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^\\.codeguard/tasks/corrections/CG-[0-9a-f]{32}/[0-9a-f]{64}\\.md$"
          }
        },
        "rule_basis": {
          "type": "string",
          "minLength": 1
        },
        "task_verify_status": {
          "const": "local_observation_only"
        },
        "observation_scope": {
          "const": "selected_gradle_javadoc_inputs"
        },
        "latest_diagnostic_reason": {
          "enum": [
            "gradle_javadoc_task_scope_invalid",
            "gradle_javadoc_task_unavailable",
            "gradle_native_model_incomplete",
            "gradle_native_model_invalid",
            "jdk21_version_unresolved",
            "native_execution_incomplete",
            "native_identity_changed_during_task",
            "native_identity_unavailable",
            "native_javadoc_output_unresolved",
            "native_javadoc_source_unresolved",
            "native_prerequisite_unavailable",
            "native_process_incomplete",
            "native_stdout_diagnostics_unresolved",
            "private_workspace_unavailable",
            "request_cancelled",
            "request_deadline_exceeded",
            "root_build_inputs_missing",
            "selected_inputs_changed_during_task",
            "selected_inputs_unavailable",
            "selected_java_sources_missing",
            "prerequisites_missing",
            "selected_sources_and_complete_documentation_rules_unverified"
          ]
        },
        "latest_preparation_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "run_id",
            "report_sha256"
          ],
          "properties": {
            "run_id": {
              "type": "string",
              "pattern": "^javadoc-gradle-(task-)?[0-9]+-[0-9]+$"
            },
            "report_sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "verification_observation": {
          "enum": [
            "still_present",
            "candidate_absent_unverified_policy",
            "rule_coverage_requires_review",
            "incomplete"
          ]
        },
        "verification_run_id": {
          "type": "string",
          "pattern": "^javadoc-gradle-task-[A-Za-z0-9-]{1,100}$"
        },
        "verification_report_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "verification_reason": {
          "type": "string",
          "pattern": "^[a-z0-9_]{1,80}$"
        },
        "verification_invalidated_reason": {
          "const": "gradle_inputs_changed_or_unavailable"
        }
      },
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "blocker"
            }
          },
          "required": [
            "build_root",
            "affected_paths",
            "reason_code",
            "latest_diagnostic_reason",
            "latest_preparation_ref"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "native_rule_id"
                ]
              },
              {
                "required": [
                  "source_sha256"
                ]
              }
            ]
          }
        },
        {
          "properties": {
            "kind": {
              "const": "finding"
            }
          },
          "required": [
            "native_rule_id",
            "source_sha256"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "build_root"
                ]
              },
              {
                "required": [
                  "affected_paths"
                ]
              },
              {
                "required": [
                  "reason_code"
                ]
              }
            ]
          }
        }
      ]
    }
  }
}
