{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codeguard:schema:rustdoc-local-observation:0.3.0",
  "title": "Unverified selected Cargo rustdoc library observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_type",
    "operation",
    "language",
    "command_status",
    "exit_code",
    "delivery_decision",
    "authority",
    "checker_id",
    "scope",
    "rule_selection",
    "local_scan_complete",
    "coverage_proven",
    "reason",
    "tool_sha256",
    "manifest_sha256",
    "lock_sha256",
    "findings",
    "backlog_status",
    "execution_budget",
    "next_actions",
    "recheck_argv"
  ],
  "properties": {
    "schema_version": {
      "const": "0.3.0"
    },
    "report_type": {
      "const": "rustdoc_local_observation"
    },
    "operation": {
      "const": "comments"
    },
    "language": {
      "const": "rust"
    },
    "command_status": {
      "enum": [
        "incomplete",
        "cancelled"
      ]
    },
    "exit_code": {
      "enum": [
        3,
        130
      ]
    },
    "delivery_decision": {
      "const": "not_evaluated"
    },
    "authority": {
      "const": "local_unverified"
    },
    "checker_id": {
      "const": "rust.cargo_rustdoc"
    },
    "scope": {
      "const": "selected_root_library_default_features"
    },
    "rule_selection": {
      "const": "explicit_probe_not_approved_project_policy"
    },
    "local_scan_complete": {
      "type": "boolean"
    },
    "coverage_proven": {
      "const": false
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "tool_sha256": {
      "$ref": "#/$defs/hash"
    },
    "manifest_sha256": {
      "$ref": "#/$defs/hash"
    },
    "lock_sha256": {
      "$ref": "#/$defs/hash"
    },
    "backlog_status": {
      "const": "not_integrated"
    },
    "execution_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timeout_ms",
        "source",
        "enforcement"
      ],
      "properties": {
        "timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400000
        },
        "source": {
          "enum": [
            "cli",
            "registered_environment",
            "project_default",
            "builtin_default"
          ]
        },
        "enforcement": {
          "const": "native_execution_only"
        }
      }
    },
    "next_actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "recheck_argv": {
      "const": [
        "cargo",
        "rustdoc",
        "--lib",
        "--locked",
        "--offline",
        "--message-format=json",
        "--",
        "--warn",
        "missing_docs",
        "--warn",
        "rustdoc::broken_intra_doc_links"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_id",
          "finding_fingerprint",
          "source_sha256",
          "rule_id",
          "level",
          "path",
          "line",
          "column",
          "classification",
          "byte_start",
          "byte_end",
          "native_range_sha256",
          "identity_status",
          "repair_brief"
        ],
        "properties": {
          "finding_id": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^CG-[0-9a-f]{32}$"
          },
          "finding_fingerprint": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "rule_id": {
            "enum": [
              "missing_docs",
              "rustdoc::broken_intra_doc_links"
            ]
          },
          "level": {
            "enum": [
              "warning",
              "error"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "column": {
            "type": "integer",
            "minimum": 1
          },
          "classification": {
            "const": "observed_unverified"
          },
          "byte_start": {
            "type": "integer",
            "minimum": 0
          },
          "byte_end": {
            "type": "integer",
            "minimum": 0
          },
          "native_range_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "identity_status": {
            "enum": [
              "unique_candidate",
              "ambiguous"
            ]
          },
          "repair_brief": {
            "$ref": "#/$defs/repair_brief"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "identity_status": {
                  "const": "ambiguous"
                }
              }
            },
            "then": {
              "properties": {
                "finding_id": {
                  "type": "null"
                },
                "repair_brief": {
                  "properties": {
                    "status": {
                      "const": "investigation_required"
                    }
                  }
                }
              }
            },
            "else": {
              "properties": {
                "finding_id": {
                  "type": "string"
                }
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "hash": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "repair_brief": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "evidence",
        "rule_basis",
        "allowed_paths",
        "steps",
        "recheck_argv",
        "working_directory",
        "tool_requirement",
        "attempt_history",
        "history_status",
        "closure_conditions"
      ],
      "properties": {
        "status": {
          "enum": [
            "repair_guidance",
            "investigation_required"
          ]
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "finding_id",
            "finding_fingerprint",
            "path",
            "source_sha256",
            "byte_start",
            "byte_end",
            "rule_id",
            "observation_reason"
          ],
          "properties": {
            "finding_id": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^CG-[0-9a-f]{32}$"
            },
            "finding_fingerprint": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "source_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "byte_start": {
              "type": "integer",
              "minimum": 0
            },
            "byte_end": {
              "type": "integer",
              "minimum": 0
            },
            "rule_id": {
              "enum": [
                "missing_docs",
                "rustdoc::broken_intra_doc_links"
              ]
            },
            "observation_reason": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "rule_basis": {
          "type": "string",
          "minLength": 1
        },
        "allowed_paths": {
          "type": "array",
          "maxItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "recheck_argv": {
          "const": [
            "cargo",
            "rustdoc",
            "--lib",
            "--locked",
            "--offline",
            "--message-format=json",
            "--",
            "--warn",
            "missing_docs",
            "--warn",
            "rustdoc::broken_intra_doc_links"
          ]
        },
        "working_directory": {
          "const": "selected_project_root"
        },
        "tool_requirement": {
          "type": "string",
          "minLength": 1
        },
        "attempt_history": {
          "const": []
        },
        "history_status": {
          "const": "not_integrated"
        },
        "closure_conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "investigation_required"
              }
            }
          },
          "then": {
            "properties": {
              "allowed_paths": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "allowed_paths": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "command_status": {
            "const": "cancelled"
          }
        }
      },
      "then": {
        "properties": {
          "exit_code": {
            "const": 130
          },
          "reason": {
            "const": "request_cancelled"
          },
          "local_scan_complete": {
            "const": false
          }
        }
      },
      "else": {
        "properties": {
          "exit_code": {
            "const": 3
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "local_scan_complete": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "reason": {
            "const": "native_observed_unverified"
          },
          "tool_sha256": {
            "type": "string"
          },
          "manifest_sha256": {
            "type": "string"
          },
          "lock_sha256": {
            "type": "string"
          },
          "findings": {
            "items": {
              "properties": {
                "identity_status": {
                  "const": "unique_candidate"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "local_scan_complete": {
            "const": false
          }
        }
      },
      "then": {
        "properties": {
          "findings": {
            "items": {
              "properties": {
                "repair_brief": {
                  "properties": {
                    "status": {
                      "const": "investigation_required"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
