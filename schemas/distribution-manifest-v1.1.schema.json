{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CodeGuard untrusted distribution manifest 1.0/1.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "lock_sha256",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "1.0",
        "1.1"
      ]
    },
    "manifest_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "lock_sha256": {
      "type": "string",
      "pattern": "^(?!0{64}$)[0-9a-f]{64}$"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tool_id",
          "version",
          "platform",
          "binary_sha256",
          "origin_ref_sha256",
          "download_url",
          "package_sha256",
          "package_size_bytes",
          "format",
          "unpacked_size_limit_bytes"
        ],
        "properties": {
          "tool_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:-]{1,128}$"
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f]+$"
          },
          "platform": {
            "enum": [
              "linux_x86_64",
              "linux_aarch64",
              "macos_arm64",
              "macos_x86_64",
              "windows_x86_64"
            ]
          },
          "binary_sha256": {
            "type": "string",
            "pattern": "^(?!0{64}$)[0-9a-f]{64}$"
          },
          "origin_ref_sha256": {
            "type": "string",
            "pattern": "^(?!0{64}$)[0-9a-f]{64}$"
          },
          "download_url": {
            "type": "string",
            "maxLength": 2048,
            "pattern": "^https://[^/?#@\\s]+(?:/[^?#\\s]*)?$"
          },
          "package_sha256": {
            "type": "string",
            "pattern": "^(?!0{64}$)[0-9a-f]{64}$"
          },
          "package_size_bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 134217728
          },
          "format": {
            "enum": [
              "raw",
              "tar_gz",
              "zip"
            ]
          },
          "entrypoint": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 1024
          },
          "unpacked_size_limit_bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 536870912
          },
          "bundle_tree_sha256": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "pattern": "^(?!0{64}$)[0-9a-f]{64}$"
              }
            ]
          },
          "bundle_archive_root": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1024,
            "pattern": "^(?:$|(?!/)(?!.*(?:^|/)\\.\\.?(/|$))(?!.*//)(?!.*/$)[^\\\\:\\x00-\\x1f\\x7f-\\x9f]+)$"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "format": {
                  "const": "raw"
                }
              }
            },
            "then": {
              "properties": {
                "entrypoint": {
                  "const": null
                },
                "bundle_tree_sha256": {
                  "const": null
                },
                "bundle_archive_root": {
                  "const": null
                }
              }
            },
            "else": {
              "required": [
                "entrypoint"
              ],
              "properties": {
                "entrypoint": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024,
                  "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(/|$))(?!.*//)(?!.*/$)[^\\\\:\\x00-\\x1f\\x7f-\\x9f]+$"
                }
              }
            }
          }
        ]
      }
    }
  },
  "$comment": "Rust parser additionally rejects duplicate fields/identities, checks URI syntax and cross-field raw sizes/hashes; binding validates original lock bytes. No approval or download authority. Version 1.1 requires explicit bundle root when a tree identity exists; empty root selects whole tree. Version 1.0 remains readable but lacks mapping authority.",
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "1.0"
          }
        }
      },
      "then": {
        "properties": {
          "artifacts": {
            "items": {
              "properties": {
                "bundle_archive_root": {
                  "const": null
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "artifacts": {
            "items": {
              "if": {
                "required": [
                  "bundle_tree_sha256"
                ],
                "properties": {
                  "bundle_tree_sha256": {
                    "type": "string"
                  }
                }
              },
              "then": {
                "required": [
                  "bundle_archive_root"
                ],
                "properties": {
                  "bundle_archive_root": {
                    "type": "string"
                  }
                }
              },
              "else": {
                "properties": {
                  "bundle_archive_root": {
                    "const": null
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
