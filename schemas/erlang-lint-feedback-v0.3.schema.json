{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codeguard:schema:erlang-lint-feedback:0.3.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_type",
    "operation",
    "language",
    "path",
    "status",
    "coverage_proven",
    "delivery_decision",
    "authority",
    "source_sha256",
    "native",
    "syntax_precheck",
    "next_action",
    "scope",
    "execution_budget",
    "known_limitations",
    "tool_selection",
    "workspace_binding",
    "task_id",
    "task_status",
    "task_sync_reason"
  ],
  "properties": {
    "schema_version": {
      "const": "0.3.0"
    },
    "report_type": {
      "const": "erlang_lint_feedback"
    },
    "operation": {
      "const": "lint"
    },
    "language": {
      "const": "erlang"
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "incomplete"
    },
    "coverage_proven": {
      "const": false
    },
    "delivery_decision": {
      "const": "not_evaluated"
    },
    "authority": {
      "const": "local_unverified"
    },
    "source_sha256": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/digest"
        }
      ]
    },
    "native": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason",
        "version",
        "tool_sha256",
        "diagnostics",
        "diagnostics_truncated",
        "preprocessing_unresolved"
      ],
      "properties": {
        "status": {
          "enum": [
            "not_run",
            "incomplete",
            "completed",
            "diagnostics_observed"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "enum": [
            null,
            "OTP 28"
          ]
        },
        "tool_sha256": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/digest"
            }
          ]
        },
        "diagnostics": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/diagnostic"
          }
        },
        "diagnostics_truncated": {
          "type": "boolean"
        },
        "preprocessing_unresolved": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "completed",
                  "diagnostics_observed"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "version": {
                "const": "OTP 28"
              },
              "tool_sha256": {
                "$ref": "#/$defs/digest"
              },
              "diagnostics_truncated": {
                "const": false
              },
              "preprocessing_unresolved": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "completed"
              }
            }
          },
          "then": {
            "properties": {
              "diagnostics": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "diagnostics_observed"
              }
            }
          },
          "then": {
            "properties": {
              "diagnostics": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "completed"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "const": "erlang_native_forms_no_diagnostics"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "diagnostics_observed"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "const": "erlang_native_syntax_diagnostics"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "not_run"
              }
            }
          },
          "then": {
            "properties": {
              "version": {
                "type": "null"
              },
              "tool_sha256": {
                "type": "null"
              },
              "diagnostics": {
                "maxItems": 0
              },
              "diagnostics_truncated": {
                "const": false
              },
              "preprocessing_unresolved": {
                "const": false
              }
            }
          }
        }
      ]
    },
    "syntax_precheck": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/candidate"
        }
      ]
    },
    "next_action": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "const": "single_file_forms_without_preprocessing"
    },
    "known_limitations": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
      }
    },
    "execution_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timeout_ms",
        "source",
        "enforcement"
      ],
      "properties": {
        "timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400000
        },
        "source": {
          "enum": [
            "cli",
            "registered_environment",
            "builtin_default"
          ]
        },
        "enforcement": {
          "const": "native_execution_only"
        }
      }
    },
    "tool_selection": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/tool_selection"
        }
      ]
    },
    "workspace_binding": {
      "enum": [
        "bound",
        "invalid"
      ]
    },
    "task_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^CG-B-[0-9a-f]{32}$"
    },
    "task_status": {
      "enum": [
        "synced_partial",
        "incomplete"
      ]
    },
    "task_sync_reason": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-z_]{1,128}$"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "line",
        "column",
        "rule_id"
      ],
      "properties": {
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "rule_id": {
          "const": "erlang.syntax.error"
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "oneOf": [
        {
          "required": [
            "grammar_qualified",
            "grammar_sha256",
            "precheck",
            "recoveries"
          ],
          "not": {
            "required": [
              "reason"
            ]
          }
        },
        {
          "required": [
            "reason"
          ],
          "not": {
            "required": [
              "precheck"
            ]
          }
        }
      ],
      "properties": {
        "status": {
          "const": "incomplete"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "grammar_qualified": {
          "const": false
        },
        "grammar_sha256": {
          "$ref": "#/$defs/digest"
        },
        "precheck": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "scope_complete",
            "cancelled",
            "selected_files",
            "checked_files",
            "incomplete_files",
            "unsupported_files",
            "unqualified_files",
            "truncated_files",
            "suspected_recoveries"
          ],
          "properties": {
            "status": {
              "const": "incomplete"
            },
            "scope_complete": {
              "type": "boolean"
            },
            "cancelled": {
              "const": false
            },
            "selected_files": {
              "const": 1
            },
            "checked_files": {
              "const": 1
            },
            "incomplete_files": {
              "const": 0
            },
            "unsupported_files": {
              "const": 0
            },
            "unqualified_files": {
              "const": 1
            },
            "truncated_files": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1
            },
            "suspected_recoveries": {
              "type": "integer",
              "minimum": 0,
              "maximum": 128
            }
          }
        },
        "recoveries": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/recovery"
          }
        }
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "group_id",
        "syntax_kind",
        "start_byte",
        "end_byte",
        "start_row",
        "start_column_byte",
        "end_row",
        "end_column_byte"
      ],
      "properties": {
        "kind": {
          "enum": [
            "ERROR",
            "MISSING"
          ]
        },
        "group_id": {
          "type": "integer",
          "minimum": 1
        },
        "syntax_kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "start_byte": {
          "type": "integer",
          "minimum": 0
        },
        "end_byte": {
          "type": "integer",
          "minimum": 0
        },
        "start_row": {
          "type": "integer",
          "minimum": 0
        },
        "start_column_byte": {
          "type": "integer",
          "minimum": 0
        },
        "end_row": {
          "type": "integer",
          "minimum": 0
        },
        "end_column_byte": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "tool_selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "executable"
      ],
      "properties": {
        "source": {
          "enum": [
            "explicit",
            "path",
            "not_found"
          ]
        },
        "executable": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^/"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "source": {
                "const": "path"
              }
            }
          },
          "then": {
            "properties": {
              "executable": {
                "type": "string",
                "pattern": "^/"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "source": {
                "const": "not_found"
              }
            }
          },
          "then": {
            "properties": {
              "executable": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "native": {
            "properties": {
              "status": {
                "enum": [
                  "completed",
                  "diagnostics_observed"
                ]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "source_sha256": {
            "$ref": "#/$defs/digest"
          },
          "syntax_precheck": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "native": {
            "properties": {
              "status": {
                "enum": [
                  "completed",
                  "diagnostics_observed"
                ]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "tool_selection": {
            "allOf": [
              {
                "$ref": "#/$defs/tool_selection"
              },
              {
                "properties": {
                  "source": {
                    "enum": [
                      "explicit",
                      "path"
                    ]
                  },
                  "executable": {
                    "type": "string",
                    "pattern": "^/"
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "tool_selection": {
            "type": "object",
            "properties": {
              "source": {
                "enum": [
                  "path",
                  "explicit"
                ]
              }
            },
            "required": [
              "source"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "native": {
            "properties": {
              "status": {
                "enum": [
                  "incomplete",
                  "completed",
                  "diagnostics_observed"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "tool_selection": {
            "type": "object",
            "properties": {
              "source": {
                "const": "not_found"
              }
            },
            "required": [
              "source"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "native": {
            "properties": {
              "status": {
                "enum": [
                  "not_run",
                  "incomplete"
                ]
              },
              "version": {
                "type": "null"
              },
              "tool_sha256": {
                "type": "null"
              },
              "diagnostics": {
                "maxItems": 0
              },
              "diagnostics_truncated": {
                "const": false
              },
              "preprocessing_unresolved": {
                "const": false
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "workspace_binding": {
            "const": "invalid"
          }
        }
      },
      "then": {
        "properties": {
          "task_id": {
            "type": "null"
          },
          "task_status": {
            "const": "incomplete"
          },
          "task_sync_reason": {
            "const": "workspace_invalid"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "task_sync_reason": {
            "type": "string"
          }
        }
      },
      "then": {
        "properties": {
          "task_id": {
            "type": "null"
          },
          "task_status": {
            "const": "incomplete"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "task_id": {
            "type": "string"
          }
        }
      },
      "then": {
        "properties": {
          "workspace_binding": {
            "const": "bound"
          },
          "task_status": {
            "const": "synced_partial"
          },
          "task_sync_reason": {
            "type": "null"
          }
        }
      }
    }
  ]
}
