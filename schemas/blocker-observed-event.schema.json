{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codeguard:schema:blocker-observed-event:0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event",
    "blocker_id",
    "workspace_id",
    "run_id",
    "report_sha256",
    "reason_code",
    "affected_paths",
    "state_after"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "event": {
      "const": "observed"
    },
    "blocker_id": {
      "type": "string",
      "pattern": "^CG-B-[0-9a-f]{32}$"
    },
    "workspace_id": {
      "type": "string",
      "pattern": "^ws-[0-9a-f]{32}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,120}$"
    },
    "report_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "reason_code": {
      "type": "string",
      "pattern": "^[a-z0-9_]{1,80}$"
    },
    "affected_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "state_after": {
      "const": "open"
    },
    "diagnostic_reason": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "maxLength": 128
    }
  }
}
