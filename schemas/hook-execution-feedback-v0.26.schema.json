{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codeguard:schema:hook-execution-feedback:0.26.0",
  "title": "Candidate host-event execution; never a delivery gate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_type",
    "plan",
    "execution",
    "reason",
    "local_feedback",
    "delivery_decision",
    "host_blocking_verified",
    "soft_result_reused"
  ],
  "properties": {
    "schema_version": {
      "const": "0.26.0"
    },
    "report_type": {
      "const": "hook_execution_feedback"
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "target_paths",
        "scope_resolution_reason",
        "task_id",
        "requires_git_snapshot",
        "soft_result_reuse_candidate",
        "host_blocking_claimed",
        "may_claim_delivery"
      ],
      "properties": {
        "action": {
          "const": "verify_task"
        },
        "target_paths": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "scope_resolution_reason": {
          "enum": [
            null,
            "changed_paths_missing",
            "write_outcome_unknown",
            "fast_scope_budget_exceeded"
          ]
        },
        "task_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "requires_git_snapshot": {
          "type": "boolean"
        },
        "soft_result_reuse_candidate": {
          "type": "boolean"
        },
        "host_blocking_claimed": {
          "type": "boolean"
        },
        "may_claim_delivery": {
          "const": false
        }
      }
    },
    "execution": {
      "const": "task_verification"
    },
    "reason": {
      "type": "null"
    },
    "local_feedback": {
      "$ref": "#/$defs/ruby_task_summary"
    },
    "delivery_decision": {
      "const": "not_evaluated"
    },
    "host_blocking_verified": {
      "const": false
    },
    "soft_result_reused": {
      "const": false
    }
  },
  "$defs": {
    "ruby_task_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "report_type",
        "task_id",
        "checker_id",
        "observation",
        "event_persisted",
        "reason",
        "scan_report_available",
        "authority",
        "delivery_decision",
        "native_confirmation_status",
        "native_confirmation_reason",
        "native_column_unit",
        "native_diagnostic_positions"
      ],
      "properties": {
        "schema_version": {
          "const": "0.8.0"
        },
        "report_type": {
          "const": "hook_task_verification_summary"
        },
        "task_id": {
          "type": "string",
          "pattern": "^CG-(B-)?[0-9a-f]{32}$"
        },
        "checker_id": {
          "const": "rust.cargo_clippy"
        },
        "observation": {
          "enum": [
            "still_present",
            "still_blocked",
            "candidate_absent_unverified_policy",
            "environment_restored_unverified_policy",
            "suppression_requires_review",
            "incomplete"
          ]
        },
        "event_persisted": {
          "type": "boolean"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "scan_report_available": {
          "type": "boolean"
        },
        "authority": {
          "const": "local_unverified"
        },
        "delivery_decision": {
          "const": "not_evaluated"
        },
        "native_confirmation_status": {
          "enum": [
            "stale",
            "not_run",
            "incomplete",
            "completed",
            "diagnostics_observed"
          ]
        },
        "native_confirmation_reason": {
          "type": "string",
          "pattern": "^[a-z_]{1,128}$"
        },
        "native_column_unit": {
          "const": "unavailable"
        },
        "native_diagnostic_positions": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "line",
              "rule_id"
            ],
            "properties": {
              "line": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4294967295
              },
              "rule_id": {
                "type": "string",
                "pattern": "^clippy::[a-z0-9_]{1,72}$"
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "native_confirmation_status": {
                "enum": [
                  "stale",
                  "not_run",
                  "incomplete",
                  "completed"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "native_diagnostic_positions": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "native_confirmation_status": {
                "const": "diagnostics_observed"
              }
            }
          },
          "then": {
            "properties": {
              "native_confirmation_reason": {
                "const": "clippy_confirmation_task_diagnostics"
              },
              "native_diagnostic_positions": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "native_confirmation_status": {
                "const": "completed"
              }
            }
          },
          "then": {
            "properties": {
              "native_confirmation_reason": {
                "const": "clippy_confirmation_no_task_diagnostics"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "native_confirmation_status": {
                "const": "stale"
              }
            }
          },
          "then": {
            "properties": {
              "native_confirmation_reason": {
                "const": "clippy_confirmation_inputs_changed"
              }
            }
          }
        }
      ]
    }
  }
}
