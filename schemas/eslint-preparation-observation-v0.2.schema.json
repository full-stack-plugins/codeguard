{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codeguard:eslint-preparation-observation:0.2.0",
  "title": "Local unverified ESLint syntax confirmation evidence",
  "description": "Structural schema only. The Rust importer also binds source bytes, workspace, grammar identity and positions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "report_type", "workspace_binding", "workspace_id", "run_id",
    "checker_id", "authority", "coverage_proven", "delivery_decision", "execution",
    "blocker_id", "fingerprint", "reason_code", "diagnostic_reason", "build_root",
    "scope", "affected_paths", "source_sha256", "syntax_evidence"
  ],
  "properties": {
    "schema_version": {"const": "0.2.0"},
    "report_type": {"const": "eslint_preparation_observation"},
    "workspace_binding": {"const": "bound"},
    "workspace_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "pattern": "^eslint-preparation-[1-9][0-9]*-[1-9][0-9]*$"},
    "checker_id": {"const": "node.eslint.preparation"},
    "authority": {"const": "local_unverified"},
    "coverage_proven": {"const": false},
    "delivery_decision": {"const": "not_evaluated"},
    "execution": {"const": "incomplete"},
    "blocker_id": {"type": "string", "pattern": "^CG-B-[0-9a-f]{32}$"},
    "fingerprint": {"$ref": "#/$defs/digest"},
    "reason_code": {"const": "eslint_prerequisites_require_review"},
    "diagnostic_reason": {"const": "eslint_syntax_confirmation_needed"},
    "build_root": {"const": "."},
    "scope": {"type": "string", "minLength": 1},
    "affected_paths": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "string", "minLength": 1}},
    "source_sha256": {"$ref": "#/$defs/digest"},
    "syntax_evidence": {"$ref": "#/$defs/syntax_evidence"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "syntax_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "backend", "language", "scope", "source_sha256",
        "grammar_sha256", "grammar_qualified", "precheck_reason", "truncated", "observations"
      ],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "backend": {"const": "bundled_tree_sitter_wasm_candidate"},
        "language": {"enum": ["typescript", "tsx"]},
        "scope": {"type": "string", "minLength": 1},
        "source_sha256": {"$ref": "#/$defs/digest"},
        "grammar_sha256": {"$ref": "#/$defs/digest"},
        "grammar_qualified": {"const": false},
        "precheck_reason": {"enum": ["grammar_version_unqualified", "recovery_budget_truncated"]},
        "truncated": {"type": "boolean"},
        "observations": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/observation"}}
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "kind", "start_line", "start_column", "end_line", "end_column", "group_id"],
      "properties": {
        "classification": {"const": "suspected"},
        "kind": {"enum": ["ERROR", "MISSING"]},
        "start_line": {"type": "integer", "minimum": 1},
        "start_column": {"type": "integer", "minimum": 1},
        "end_line": {"type": "integer", "minimum": 1},
        "end_column": {"type": "integer", "minimum": 1},
        "group_id": {"type": "integer", "minimum": 1}
      }
    }
  }
}
