{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codeguard:schema:p3c-configuration-repair-brief-preview:0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_type",
    "operation",
    "command_status",
    "exit_code",
    "disposition",
    "reason",
    "repair_brief",
    "next_actions",
    "authority",
    "delivery_decision"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "report_type": {
      "const": "repair_brief_preview"
    },
    "operation": {
      "const": "next"
    },
    "command_status": {
      "enum": [
        "complete",
        "incomplete"
      ]
    },
    "exit_code": {
      "enum": [
        0,
        3
      ]
    },
    "disposition": {
      "enum": [
        "actionable",
        "waiting",
        "needs_decision",
        "verification_required",
        "no_applicable_work"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "repair_brief": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/brief"
        }
      ]
    },
    "next_actions": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "failed_reports": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "run_id",
          "reason",
          "report_ref"
        ],
        "properties": {
          "run_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,120}$"
          },
          "reason": {
            "type": "string",
            "pattern": "^[a-z0-9_]{1,80}$"
          },
          "report_ref": {
            "type": "string",
            "pattern": "^\\.codeguard/reports/[A-Za-z0-9_-]{1,120}\\.json$"
          }
        }
      }
    },
    "authority": {
      "const": "local_unverified"
    },
    "delivery_decision": {
      "const": "not_evaluated"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "first_run_id",
        "first_report_sha256"
      ],
      "properties": {
        "first_run_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,120}$"
        },
        "first_report_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "brief": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "task_id",
        "kind",
        "checker_id",
        "evidence_ref",
        "recheck_argv",
        "history",
        "action_id",
        "authority",
        "closure_condition",
        "scope",
        "constraints",
        "step",
        "disposition",
        "build_root",
        "affected_paths",
        "reason_code"
      ],
      "properties": {
        "schema_version": {
          "const": "0.1.0"
        },
        "task_id": {
          "type": "string",
          "pattern": "^CG-(B-)?[0-9a-f]{32}$"
        },
        "kind": {
          "const": "blocker"
        },
        "checker_id": {
          "const": "java.maven.p3c"
        },
        "evidence_ref": {
          "$ref": "#/$defs/evidence"
        },
        "recheck_argv": {
          "const": [
            "codeguard",
            "check",
            "all",
            ".",
            "--maven-tool",
            "<绝对路径>",
            "--java-home",
            "<绝对路径>",
            "--maven-repo",
            "<绝对路径>",
            "--repo-sha256",
            "<固定摘要>"
          ]
        },
        "history": {
          "oneOf": [
            {
              "const": "attempt_history_unavailable"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "attempt_count",
                "no_progress_count",
                "open_attempt_id",
                "awaiting_verification",
                "budget",
                "recent"
              ],
              "properties": {
                "attempt_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "no_progress_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "open_attempt_id": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^CG-A-[0-9a-f]{32}$"
                },
                "awaiting_verification": {
                  "type": "boolean"
                },
                "budget": {
                  "const": 2
                },
                "recent": {
                  "type": "array",
                  "maxItems": 5,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "attempt_id",
                      "action_id",
                      "outcome",
                      "note_code",
                      "observed_change"
                    ],
                    "properties": {
                      "attempt_id": {
                        "type": "string",
                        "pattern": "^CG-A-[0-9a-f]{32}$"
                      },
                      "action_id": {
                        "enum": [
                          "repair-source",
                          "review-project-policy",
                          "restore-checker-environment"
                        ]
                      },
                      "outcome": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "enum": [
                          "ready-to-verify",
                          "no-change",
                          "failed",
                          "blocked",
                          "abandoned",
                          null
                        ]
                      },
                      "note_code": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "observed_change": {
                        "type": [
                          "boolean",
                          "null"
                        ]
                      }
                    }
                  }
                }
              }
            }
          ]
        },
        "action_id": {
          "const": "review-project-policy"
        },
        "authority": {
          "const": "local_unverified"
        },
        "closure_condition": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "constraints": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "step": {
          "type": "string",
          "minLength": 1
        },
        "disposition": {
          "enum": [
            "actionable",
            "needs_decision",
            "verification_required",
            "waiting"
          ]
        },
        "build_root": {
          "type": "string",
          "minLength": 1
        },
        "affected_paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reason_code": {
          "const": "p3c_configuration_not_confirmed"
        }
      }
    }
  }
}
