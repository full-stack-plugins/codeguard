{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CodeGuard untrusted tool install preview 0.3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_type",
    "inspection_status",
    "authority",
    "readiness",
    "gate_effect",
    "lock_status",
    "lock_sha256",
    "tools",
    "next_action",
    "inventory_scope",
    "required_inventory",
    "mode",
    "writes_performed",
    "installation_status",
    "reason",
    "missing_inputs",
    "planned_effects",
    "distribution_manifest"
  ],
  "properties": {
    "schema_version": {
      "const": "0.3.0"
    },
    "report_type": {
      "const": "tool_install_preview"
    },
    "inspection_status": {
      "const": "incomplete"
    },
    "authority": {
      "const": "unverified"
    },
    "readiness": {
      "const": "unknown"
    },
    "gate_effect": {
      "const": "none"
    },
    "lock_status": {
      "enum": [
        "missing",
        "invalid",
        "unreadable",
        "structurally_valid_untrusted"
      ]
    },
    "lock_sha256": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      ]
    },
    "next_action": {
      "type": "string",
      "minLength": 1
    },
    "tools": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/tool"
      }
    },
    "inventory_scope": {
      "const": "declared_lock_only"
    },
    "required_inventory": {
      "const": "unverified"
    },
    "mode": {
      "enum": [
        "dry_run",
        "apply_requested"
      ]
    },
    "writes_performed": {
      "const": false
    },
    "installation_status": {
      "enum": [
        "plan_incomplete",
        "blocked_before_mutation"
      ]
    },
    "reason": {
      "enum": [
        "approved_install_source_unbound",
        "tool_lock_missing",
        "tool_lock_invalid",
        "tool_lock_unreadable"
      ]
    },
    "missing_inputs": {
      "const": [
        "approved_lock_source",
        "authorized_distribution_manifest",
        "required_inventory_runtime_coverage"
      ]
    },
    "planned_effects": {
      "const": [
        "authorized_managed_cache_only",
        "no_global_path_changes",
        "no_elevation",
        "no_project_script_execution"
      ]
    },
    "distribution_manifest": {
      "$ref": "#/$defs/distribution_manifest"
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digest_matched",
        "executable_bit",
        "issue"
      ],
      "properties": {
        "digest_matched": {
          "type": "boolean"
        },
        "executable_bit": {
          "type": "boolean"
        },
        "issue": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digest_matched",
        "issue"
      ],
      "properties": {
        "digest_matched": {
          "type": "boolean"
        },
        "issue": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool_id",
        "platform",
        "origin_kind",
        "artifact_status",
        "tool",
        "runtime",
        "bundle",
        "execution",
        "version_status",
        "next_action",
        "applicability",
        "declared_version",
        "required_by_policy",
        "declared_runtime",
        "adapter",
        "rule_source",
        "expected_binary_sha256",
        "origin_ref_sha256",
        "install_action",
        "distribution"
      ],
      "properties": {
        "tool_id": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "enum": [
            "macos_arm64",
            "macos_x86_64",
            "linux_x86_64",
            "linux_aarch64",
            "windows_x86_64"
          ]
        },
        "origin_kind": {
          "enum": [
            "system",
            "project_wrapper",
            "managed_cache"
          ]
        },
        "artifact_status": {
          "enum": [
            "matched_untrusted",
            "incomplete",
            "not_inspected"
          ]
        },
        "tool": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/artifact"
            }
          ]
        },
        "runtime": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/artifact"
            }
          ]
        },
        "bundle": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/bundle"
            }
          ]
        },
        "execution": {
          "const": "not_run"
        },
        "version_status": {
          "const": "lock_declared_only"
        },
        "next_action": {
          "type": "string",
          "minLength": 1
        },
        "applicability": {
          "enum": [
            "current_platform",
            "other_platform"
          ]
        },
        "declared_version": {
          "type": "string",
          "minLength": 1
        },
        "required_by_policy": {
          "const": null
        },
        "declared_runtime": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "version"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "version": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        },
        "adapter": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "rule_source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "kind",
            "sha256"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "enum": [
                "native_builtin",
                "external_rulepack"
              ]
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "expected_binary_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "origin_ref_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "install_action": {
          "enum": [
            "not_applicable_on_current_platform",
            "verify_approved_toolchain_before_doctor",
            "restore_approved_project_wrapper",
            "prepare_authorized_system_tool_plan",
            "bind_approved_distribution_manifest"
          ]
        },
        "distribution": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/distribution"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "applicability": {
                "const": "other_platform"
              }
            }
          },
          "then": {
            "properties": {
              "artifact_status": {
                "const": "not_inspected"
              },
              "tool": {
                "const": null
              },
              "runtime": {
                "const": null
              },
              "bundle": {
                "const": null
              }
            }
          },
          "else": {
            "properties": {
              "artifact_status": {
                "enum": [
                  "matched_untrusted",
                  "incomplete"
                ]
              },
              "tool": {
                "$ref": "#/$defs/artifact"
              }
            }
          }
        }
      ]
    },
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool_id",
        "platform",
        "format",
        "package_sha256",
        "package_size_bytes",
        "unpacked_size_limit_bytes",
        "source_uri_sha256",
        "layout"
      ],
      "properties": {
        "tool_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,128}$"
        },
        "platform": {
          "enum": [
            "macos_arm64",
            "macos_x86_64",
            "linux_x86_64",
            "linux_aarch64",
            "windows_x86_64"
          ]
        },
        "format": {
          "enum": [
            "raw",
            "zip",
            "tar_gz"
          ]
        },
        "package_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "package_size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 134217728
        },
        "unpacked_size_limit_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 536870912
        },
        "source_uri_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "layout": {
          "$ref": "#/$defs/layout"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "format": {
                "const": "raw"
              }
            }
          },
          "then": {
            "properties": {
              "layout": {
                "properties": {
                  "status": {
                    "const": "not_applicable_raw"
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "layout": {
                "properties": {
                  "status": {
                    "enum": [
                      "declared_paths_bound_untrusted",
                      "missing_full_tree_declaration"
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    },
    "distribution_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason",
        "sha256",
        "bound_artifacts",
        "artifacts"
      ],
      "properties": {
        "status": {
          "enum": [
            "not_provided",
            "unreadable",
            "invalid",
            "lock_unavailable",
            "unbound",
            "bound_untrusted"
          ]
        },
        "reason": {
          "enum": [
            "distribution_manifest_not_provided",
            "distribution_manifest_unreadable",
            "distribution_manifest_too_large",
            "distribution_manifest_invalid",
            "distribution_artifact_invalid",
            "distribution_url_invalid",
            "distribution_package_format_invalid",
            "distribution_lock_unavailable",
            "distribution_lock_digest_mismatch",
            "distribution_lock_invalid",
            "distribution_tool_unbound",
            "distribution_tool_identity_mismatch",
            "distribution_authority_unverified",
            "distribution_bundle_mapping_invalid",
            "distribution_install_layout_invalid",
            "distribution_install_layout_mismatch",
            "distribution_raw_locator_mismatch"
          ]
        },
        "sha256": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          ]
        },
        "bound_artifacts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 256
        },
        "artifacts": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/distribution"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "bound_untrusted"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "const": "distribution_authority_unverified"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "bound_artifacts": {
                "minimum": 1
              },
              "artifacts": {
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "bound_artifacts": {
                "const": 0
              },
              "artifacts": {
                "const": []
              }
            }
          }
        }
      ]
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "install_tree_sha256",
        "cache_directory",
        "entrypoint_ref_sha256",
        "bundle_root_ref_sha256",
        "content_verification",
        "next_action"
      ],
      "properties": {
        "status": {
          "enum": [
            "declared_paths_bound_untrusted",
            "missing_full_tree_declaration",
            "not_applicable_raw"
          ]
        },
        "install_tree_sha256": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^(?!0{64}$)[0-9a-f]{64}$"
            }
          ]
        },
        "cache_directory": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^(?!0{64}\\.bundle$)[0-9a-f]{64}\\.bundle$"
            }
          ]
        },
        "entrypoint_ref_sha256": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^(?!0{64}$)[0-9a-f]{64}$"
            }
          ]
        },
        "bundle_root_ref_sha256": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^(?!0{64}$)[0-9a-f]{64}$"
            }
          ]
        },
        "content_verification": {
          "const": "not_run"
        },
        "next_action": {
          "enum": [
            "verify_source_then_package_and_layout",
            "bind_versioned_full_tree_layout",
            "bind_raw_cache_locator",
            "verify_source_then_raw_package"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "declared_paths_bound_untrusted"
              }
            }
          },
          "then": {
            "properties": {
              "install_tree_sha256": {
                "type": "string",
                "pattern": "^(?!0{64}$)[0-9a-f]{64}$"
              },
              "cache_directory": {
                "type": "string",
                "pattern": "^(?!0{64}\\.bundle$)[0-9a-f]{64}\\.bundle$"
              },
              "entrypoint_ref_sha256": {
                "type": "string",
                "pattern": "^(?!0{64}$)[0-9a-f]{64}$"
              },
              "next_action": {
                "const": "verify_source_then_package_and_layout"
              }
            }
          },
          "else": {
            "properties": {
              "install_tree_sha256": {
                "const": null
              },
              "cache_directory": {
                "const": null
              },
              "entrypoint_ref_sha256": {
                "const": null
              },
              "bundle_root_ref_sha256": {
                "const": null
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "not_applicable_raw"
              }
            }
          },
          "then": {
            "properties": {
              "next_action": {
                "enum": [
                  "bind_raw_cache_locator",
                  "verify_source_then_raw_package"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "missing_full_tree_declaration"
              }
            }
          },
          "then": {
            "properties": {
              "next_action": {
                "const": "bind_versioned_full_tree_layout"
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "dry_run"
          }
        }
      },
      "then": {
        "properties": {
          "installation_status": {
            "const": "plan_incomplete"
          }
        }
      },
      "else": {
        "properties": {
          "installation_status": {
            "const": "blocked_before_mutation"
          }
        }
      }
    }
  ]
}
