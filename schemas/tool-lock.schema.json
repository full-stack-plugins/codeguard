{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codeguard:schema:tool-lock:1.0",
  "title": "Codeguard native tool identity lock",
  "type": "object",
  "required": ["schema_version", "lock_id", "tools"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string", "pattern": "^1\\.[0-9]+$"},
    "lock_id": {"type": "string", "minLength": 1},
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/tool"}
    },
    "extensions": {"$ref": "#/$defs/extensions"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "extensions": {
      "type": "object",
      "propertyNames": {"pattern": "^x-.+"}
    },
    "identity": {
      "type": "object",
      "required": ["id", "version"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "rule_source": {
      "type": "object",
      "required": ["kind", "id", "sha256"],
      "additionalProperties": false,
      "properties": {
        "kind": {"enum": ["native_builtin", "external_rulepack"]},
        "id": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "origin": {
      "type": "object",
      "required": ["kind", "ref"],
      "additionalProperties": false,
      "properties": {
        "kind": {"enum": ["project_wrapper", "managed_cache", "system"]},
        "ref": {"type": "string", "minLength": 1}
      }
    },
    "runtime": {
      "type": "object",
      "required": ["id", "version", "binary_sha256"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "binary_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "bundle": {
      "type": "object",
      "required": ["root", "tree_sha256"],
      "additionalProperties": false,
      "properties": {
        "root": {"type": "string", "minLength": 1},
        "tree_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "tool": {
      "type": "object",
      "required": ["id", "version", "binary_sha256", "platform", "adapter", "rule_source", "origin"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "binary_sha256": {"$ref": "#/$defs/sha256"},
        "platform": {"enum": ["macos_arm64", "macos_x86_64", "linux_x86_64", "linux_aarch64", "windows_x86_64"]},
        "adapter": {"$ref": "#/$defs/identity"},
        "rule_source": {"$ref": "#/$defs/rule_source"},
        "origin": {"$ref": "#/$defs/origin"},
        "runtime": {"$ref": "#/$defs/runtime"},
        "bundle": {"$ref": "#/$defs/bundle"},
        "extensions": {"$ref": "#/$defs/extensions"}
      }
    }
  }
}
