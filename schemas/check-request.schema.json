{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codeguard:schema:check-request:1.0",
  "title": "Codeguard quality check request",
  "type": "object",
  "required": ["schema_version", "report_type", "request_id", "command", "selection", "root", "content_source", "options"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string", "pattern": "^1\\.[0-9]+$"},
    "report_type": {"const": "check_request"},
    "request_id": {"type": "string", "minLength": 1},
    "command": {"enum": ["lint", "comments", "dependencies", "cve", "security", "build", "check"]},
    "selection": {
      "type": "object",
      "required": ["language"],
      "additionalProperties": false,
      "properties": {"language": {"type": "string", "minLength": 1}}
    },
    "root": {"type": "string", "minLength": 1},
    "content_source": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": {"enum": ["working_tree", "git_index", "git_ref", "ci"]},
        "identity": {"type": "string", "minLength": 1}
      },
      "if": {"properties": {"kind": {"enum": ["git_ref", "ci"]}}},
      "then": {"required": ["identity"]}
    },
    "options": {
      "type": "object",
      "required": ["format", "offline", "timeout_ms", "jobs"],
      "additionalProperties": false,
      "properties": {
        "format": {"enum": ["human", "json", "sarif"]},
        "offline": {"type": "boolean"},
        "timeout_ms": {"type": "integer", "minimum": 1, "maximum": 86400000},
        "jobs": {"type": "integer", "minimum": 1, "maximum": 64}
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": {"pattern": "^x-.+"}
    }
  }
}
