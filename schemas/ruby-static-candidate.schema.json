{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codeguard:schema:ruby-static-candidate:1.0.0",
  "title": "Ruby six-category research candidates, not executable or qualified capabilities",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "language",
    "runtime_dialects",
    "runtime_validation",
    "platforms",
    "platform_validation",
    "target_version_inputs",
    "version_gaps",
    "categories"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "language": {
      "const": "ruby"
    },
    "runtime_validation": {
      "const": "unverified"
    },
    "platform_validation": {
      "const": "unverified"
    },
    "platforms": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "enum": [
          "macos_arm64",
          "macos_x86_64",
          "linux_x86_64",
          "linux_aarch64",
          "windows_x86_64"
        ]
      }
    },
    "runtime_dialects": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": [
          "mri",
          "jruby",
          "truffleruby"
        ]
      }
    },
    "target_version_inputs": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "uniqueItems": true,
      "items": {
        "enum": [
          ".ruby-version",
          ".tool-versions",
          "mise.toml",
          "Gemfile",
          "Gemfile.lock",
          "*.gemspec",
          ".rubocop.yml"
        ]
      }
    },
    "version_gaps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[a-z0-9_]+$"
      }
    },
    "categories": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/slot"
      },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "properties": {
              "category": {
                "const": "lint"
              }
            },
            "required": [
              "category"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "category": {
                "const": "comments"
              }
            },
            "required": [
              "category"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "category": {
                "const": "dependencies"
              }
            },
            "required": [
              "category"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "category": {
                "const": "cve"
              }
            },
            "required": [
              "category"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "category": {
                "const": "security"
              }
            },
            "required": [
              "category"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "category": {
                "const": "build"
              }
            },
            "required": [
              "category"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    }
  },
  "$defs": {
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool_id",
        "candidate_version",
        "version_status",
        "candidate_argv",
        "scope",
        "sources"
      ],
      "properties": {
        "tool_id": {
          "enum": [
            "rubocop",
            "rubocop_documentation",
            "rubocop_documentation_method",
            "bundle_list",
            "bundler_audit",
            "rubocop_security",
            "brakeman",
            "gem_build"
          ]
        },
        "candidate_version": {
          "const": "project_locked"
        },
        "version_status": {
          "const": "unvalidated_project_lock_required"
        },
        "candidate_argv": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "scope": {
          "enum": [
            "bundler_project",
            "gem_project",
            "rails_project",
            "ruby_project"
          ]
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 512,
            "pattern": "^https://[^\\s]+$"
          }
        }
      },
      "oneOf": [
        {
          "properties": {
            "tool_id": {
              "const": "rubocop"
            },
            "scope": {
              "const": "ruby_project"
            },
            "candidate_argv": {
              "const": [
                "bundle",
                "exec",
                "rubocop",
                "--format",
                "json"
              ]
            }
          }
        },
        {
          "properties": {
            "tool_id": {
              "const": "rubocop_documentation"
            },
            "scope": {
              "const": "ruby_project"
            },
            "candidate_argv": {
              "const": [
                "bundle",
                "exec",
                "rubocop",
                "--only",
                "Style/Documentation",
                "--format",
                "json"
              ]
            }
          }
        },
        {
          "properties": {
            "tool_id": {
              "const": "rubocop_documentation_method"
            },
            "scope": {
              "const": "ruby_project"
            },
            "candidate_argv": {
              "const": [
                "bundle",
                "exec",
                "rubocop",
                "--only",
                "Style/DocumentationMethod",
                "--format",
                "json"
              ]
            }
          }
        },
        {
          "properties": {
            "tool_id": {
              "const": "bundle_list"
            },
            "scope": {
              "const": "bundler_project"
            },
            "candidate_argv": {
              "const": [
                "bundle",
                "list"
              ]
            }
          }
        },
        {
          "properties": {
            "tool_id": {
              "const": "bundler_audit"
            },
            "scope": {
              "const": "bundler_project"
            },
            "candidate_argv": {
              "const": [
                "bundle-audit",
                "check",
                "--no-update",
                "--format",
                "json"
              ]
            }
          }
        },
        {
          "properties": {
            "tool_id": {
              "const": "rubocop_security"
            },
            "scope": {
              "const": "ruby_project"
            },
            "candidate_argv": {
              "const": [
                "bundle",
                "exec",
                "rubocop",
                "--only",
                "Security",
                "--format",
                "json"
              ]
            }
          }
        },
        {
          "properties": {
            "tool_id": {
              "const": "brakeman"
            },
            "scope": {
              "const": "rails_project"
            },
            "candidate_argv": {
              "const": [
                "bundle",
                "exec",
                "brakeman",
                "--format",
                "json",
                "--no-pager"
              ]
            }
          }
        },
        {
          "properties": {
            "tool_id": {
              "const": "gem_build"
            },
            "scope": {
              "const": "gem_project"
            },
            "candidate_argv": {
              "const": [
                "gem",
                "build",
                "SELECTED_GEMSPEC"
              ]
            }
          }
        }
      ]
    },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "applicability",
        "status",
        "tools",
        "requires_database_freshness",
        "coverage_gaps"
      ],
      "properties": {
        "category": {
          "enum": [
            "lint",
            "comments",
            "dependencies",
            "cve",
            "security",
            "build"
          ]
        },
        "applicability": {
          "enum": [
            "applicable",
            "project_dependent"
          ]
        },
        "status": {
          "const": "gap"
        },
        "requires_database_freshness": {
          "type": "boolean"
        },
        "tools": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/tool"
          }
        },
        "coverage_gaps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[a-z0-9_]+$"
          }
        }
      },
      "oneOf": [
        {
          "properties": {
            "category": {
              "const": "lint"
            },
            "applicability": {
              "const": "applicable"
            },
            "requires_database_freshness": {
              "const": false
            },
            "tools": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "$ref": "#/$defs/tool"
              },
              "allOf": [
                {
                  "contains": {
                    "type": "object",
                    "properties": {
                      "tool_id": {
                        "const": "rubocop"
                      }
                    },
                    "required": [
                      "tool_id"
                    ]
                  },
                  "minContains": 1,
                  "maxContains": 1
                }
              ]
            }
          }
        },
        {
          "properties": {
            "category": {
              "const": "comments"
            },
            "applicability": {
              "const": "applicable"
            },
            "requires_database_freshness": {
              "const": false
            },
            "tools": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "$ref": "#/$defs/tool"
              },
              "allOf": [
                {
                  "contains": {
                    "type": "object",
                    "properties": {
                      "tool_id": {
                        "const": "rubocop_documentation"
                      }
                    },
                    "required": [
                      "tool_id"
                    ]
                  },
                  "minContains": 1,
                  "maxContains": 1
                },
                {
                  "contains": {
                    "type": "object",
                    "properties": {
                      "tool_id": {
                        "const": "rubocop_documentation_method"
                      }
                    },
                    "required": [
                      "tool_id"
                    ]
                  },
                  "minContains": 1,
                  "maxContains": 1
                }
              ]
            }
          }
        },
        {
          "properties": {
            "category": {
              "const": "dependencies"
            },
            "applicability": {
              "const": "applicable"
            },
            "requires_database_freshness": {
              "const": false
            },
            "tools": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "$ref": "#/$defs/tool"
              },
              "allOf": [
                {
                  "contains": {
                    "type": "object",
                    "properties": {
                      "tool_id": {
                        "const": "bundle_list"
                      }
                    },
                    "required": [
                      "tool_id"
                    ]
                  },
                  "minContains": 1,
                  "maxContains": 1
                }
              ]
            }
          }
        },
        {
          "properties": {
            "category": {
              "const": "cve"
            },
            "applicability": {
              "const": "applicable"
            },
            "requires_database_freshness": {
              "const": true
            },
            "tools": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "$ref": "#/$defs/tool"
              },
              "allOf": [
                {
                  "contains": {
                    "type": "object",
                    "properties": {
                      "tool_id": {
                        "const": "bundler_audit"
                      }
                    },
                    "required": [
                      "tool_id"
                    ]
                  },
                  "minContains": 1,
                  "maxContains": 1
                }
              ]
            }
          }
        },
        {
          "properties": {
            "category": {
              "const": "security"
            },
            "applicability": {
              "const": "applicable"
            },
            "requires_database_freshness": {
              "const": false
            },
            "tools": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "$ref": "#/$defs/tool"
              },
              "allOf": [
                {
                  "contains": {
                    "type": "object",
                    "properties": {
                      "tool_id": {
                        "const": "rubocop_security"
                      }
                    },
                    "required": [
                      "tool_id"
                    ]
                  },
                  "minContains": 1,
                  "maxContains": 1
                },
                {
                  "contains": {
                    "type": "object",
                    "properties": {
                      "tool_id": {
                        "const": "brakeman"
                      }
                    },
                    "required": [
                      "tool_id"
                    ]
                  },
                  "minContains": 1,
                  "maxContains": 1
                }
              ]
            }
          }
        },
        {
          "properties": {
            "category": {
              "const": "build"
            },
            "applicability": {
              "const": "project_dependent"
            },
            "requires_database_freshness": {
              "const": false
            },
            "tools": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "$ref": "#/$defs/tool"
              },
              "allOf": [
                {
                  "contains": {
                    "type": "object",
                    "properties": {
                      "tool_id": {
                        "const": "gem_build"
                      }
                    },
                    "required": [
                      "tool_id"
                    ]
                  },
                  "minContains": 1,
                  "maxContains": 1
                }
              ]
            }
          }
        }
      ]
    }
  }
}
